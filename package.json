{
  "name": "lp-hackarun",
  "version": "0.4.0",
  "private": true,
  "description": "Landing page do HackaRun 2026, o evento de tecnologia, inovação e empreendedorismo da UniCatólica com o Capim Dourado Shopping (Palmas-TO), feita com Astro, Three.js e GSAP.",
  "keywords": [
    "hackathon",
    "hackarun",
    "landing-page",
    "astro",
    "typescript",
    "threejs",
    "webgl",
    "gsap",
    "lenis",
    "clean-architecture",
    "accessibility",
    "unicatolica"
  ],
  "homepage": "https://hackarun.pages.dev",
  "bugs": {
    "url": "https://github.com/hackarun-unicatolica/lp-hackarun/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackarun-unicatolica/lp-hackarun.git"
  },
  "author": "Marcos Vinicius Muniz Arruda (https://github.com/Marcos-Codfy)",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sorteio": "node tools/sorteio/run.mjs",
    "sorteio:preparar": "node tools/sorteio/prepare-local.mjs",
    "pokemon:baixar": "node scripts/fetch-pokemon.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "exceljs": "^4.4.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
