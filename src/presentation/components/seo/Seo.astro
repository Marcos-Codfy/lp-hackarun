---
import { DEFAULT_SITE_URL, isIndexable } from '@shared/config/deploy';
import { SIMULATION_FLAG } from '@shared/config/registrationMode';
import { safeJsonForScript } from '@shared/utils/json';

export interface SeoProps {
  title: string;
  description: string;
  path?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
  // página fora dos buscadores mesmo em produção (ex.: /equipes antes do sorteio, /autorizacao)
  noindex?: boolean;
}

const {
  title,
  description,
  path = '/',
  image = '/og-image.jpg',
  jsonLd,
  noindex = false,
} = Astro.props as SeoProps;
const site = Astro.site ?? new URL(DEFAULT_SITE_URL);
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
// texto do conteúdo nunca fecha o <script> antes da hora
const jsonLdText = jsonLd ? safeJsonForScript(jsonLd) : null;
// prévia (PR na Cloudflare ou build com a inscrição simulada) fica fora dos buscadores; produção segue indexável
const indexable = isIndexable({
  cfPages: import.meta.env.CF_PAGES,
  branch: import.meta.env.CF_PAGES_BRANCH,
  simulationFlag: SIMULATION_FLAG,
});
---

<title>{title}</title>
<meta name="description" content={description} />
{(!indexable || noindex) && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="HackaRun" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
