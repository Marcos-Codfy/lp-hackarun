---
export interface SeoProps {
  title: string;
  description: string;
  path?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, path = '/', image = '/og-image.jpg', jsonLd } = Astro.props as SeoProps;
const site = Astro.site ?? new URL('https://lp-hackarun.pages.dev');
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
// "<" vira \u003c: texto do conteúdo nunca fecha o <script> antes da hora
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="HackaRun" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
