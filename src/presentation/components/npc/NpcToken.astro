---
// token NPC escondido (easter egg): achar os 3 revela a mensagem secreta no HUD
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<button class="npc-token" type="button" data-npc-token={id} data-npc-label={label} aria-label={label}>
  <svg class="npc-token__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 2.5 20.5 7.25v9.5L12 21.5 3.5 16.75v-9.5Z"></path>
    <path
      class="npc-token__mark"
      d="M9.6 9.6a2.4 2.4 0 1 1 3.5 2.15c-.7.36-1.1.9-1.1 1.6v.45M12 16.4v.6"
    ></path>
    <path class="npc-token__check" d="m8.2 12.2 2.6 2.6 5-5.2"></path>
  </svg>
  <span class="npc-token__burst" aria-hidden="true"></span>
</button>

<style>
  .npc-token {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    /* segue o tom da seção onde está escondido */
    color: var(--sx-ink, var(--accent));
    /* discreto, mas ainda ~3:1 sobre o fundo (WCAG 1.4.11) */
    opacity: 0.5;
    transition:
      opacity var(--dur) var(--ease-out),
      filter var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .npc-token:hover,
  .npc-token:focus-visible {
    opacity: 1;
    filter: drop-shadow(0 0 8px var(--sx-accent, var(--c-cyan)));
    transform: scale(1.08);
  }

  .npc-token__glyph {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
  }

  .npc-token__check {
    display: none;
  }

  .npc-token.is-found {
    cursor: default;
    opacity: 0.9;
    color: var(--c-success);
    transform: none;
  }

  .npc-token.is-found .npc-token__mark {
    display: none;
  }

  .npc-token.is-found .npc-token__check {
    display: inline;
  }

  /* explosão curta: losango que cresce e some + faíscas em box-shadow */
  .npc-token__burst {
    position: absolute;
    inset: 10px;
    border: 1.5px solid var(--c-success);
    opacity: 0;
    pointer-events: none;
    transform: rotate(45deg) scale(0.6);
  }

  .npc-token__burst::after {
    content: '';
    position: absolute;
    inset: 50%;
    width: 3px;
    height: 3px;
    background: var(--c-success);
    box-shadow:
      0 -18px 0 var(--c-success),
      18px 0 0 var(--accent),
      0 18px 0 var(--c-success),
      -18px 0 0 var(--accent);
  }

  .npc-token.is-bursting .npc-token__burst {
    animation: npc-burst 720ms var(--ease-out) forwards;
  }

  @keyframes npc-burst {
    0% {
      opacity: 1;
      transform: rotate(45deg) scale(0.6);
    }
    100% {
      opacity: 0;
      transform: rotate(45deg) scale(2.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .npc-token.is-bursting .npc-token__burst {
      animation: none;
    }

    .npc-token:hover,
    .npc-token:focus-visible {
      transform: none;
    }
  }
</style>
