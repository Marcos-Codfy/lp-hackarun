---
import './hud.css';
import './hud-rail.css';

// HUD da corrida. Desktop: trilho vertical fino na borda direita com um tique por checkpoint.
// Mobile: pílula pequena no rodapé (some no hero). Texto/barra/NPC: HudView; tiques: HudRailController
---

<div class="hud" data-hud>
  <div class="hud__rail" aria-hidden="true">
    <p class="hud__checkpoint" data-hud-checkpoint>
      01 · Largada
    </p>
    <div class="hud__track">
      <div class="hud__bar">
        <span class="hud__fill" data-hud-fill></span>
      </div>
      <span class="hud__ticks" data-hud-ticks></span>
    </div>
    <p class="hud__npc" data-hud-npc hidden>
      <span class="hud__npc-label">NPC</span>
      <span>
        <span data-hud-npc-count>0</span>/3
      </span>
    </p>
  </div>
  <p class="hud__secret" aria-hidden="true" data-hud-secret hidden></p>
  <p class="sr-only" aria-live="polite" data-hud-live></p>
</div>
