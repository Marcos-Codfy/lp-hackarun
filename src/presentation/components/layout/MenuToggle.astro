---
// botão hambúrguer do mobile; o MobileMenuController cuida de aria-expanded e do rótulo
interface Props {
  controls: string;
}

const { controls } = Astro.props;
---

<button class="menu-toggle" type="button" aria-expanded="false" aria-controls={controls} data-menu-toggle>
  <span class="sr-only" data-menu-label>
    Abrir menu
  </span>
  <span class="menu-toggle__burger" aria-hidden="true">
    <span></span>
    <span></span>
  </span>
</button>

<style>
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    clip-path: var(--clip-btn);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  /* clip-path cortaria o outline */
  .menu-toggle:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--focus);
  }

  .menu-toggle__burger {
    display: grid;
    gap: 6px;
    width: 20px;
  }

  .menu-toggle__burger span {
    height: 1.5px;
    background: var(--text);
    transition: transform var(--dur) var(--ease-out);
  }

  /* vira um X quando aberto */
  .menu-toggle[aria-expanded='true'] .menu-toggle__burger span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__burger span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }
</style>
