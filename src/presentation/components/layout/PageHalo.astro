---
// páginas leves (sem 3D): um halo de HUD em CSS puro (estático) ocupa o lugar do objeto, só no desktop
// (no celular os tiques passariam por cima do título). A metade de baixo some num degradê: lá ficam a busca de
// /equipes e o fim do card de status de /inscricao. O pai precisa de position e overflow: clip
---

<span class="page-halo" aria-hidden="true">
  <span class="page-halo__ring page-halo__ring--ticks"></span>
  <span class="page-halo__ring page-halo__ring--inner"></span>
</span>

<style>
  .page-halo {
    position: absolute;
    top: -1rem;
    right: -4rem;
    z-index: -1;
    display: none;
    place-items: center;
    width: 38rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, rgb(18 100 255 / 0.32), rgb(148 27 255 / 0.12) 55%, transparent 72%),
      radial-gradient(closest-side, transparent 64%, rgb(0 229 255 / 0.22) 64.4%, transparent 65.4%);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 80%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 80%);
  }

  .page-halo__ring {
    position: absolute;
    border-radius: 50%;
  }

  /* régua de HUD: tiques finos num anel (conic + máscara radial) */
  .page-halo__ring--ticks {
    inset: 14%;
    background: repeating-conic-gradient(rgb(143 243 255 / 0.55) 0 0.4deg, transparent 0.4deg 6deg);
    -webkit-mask: radial-gradient(closest-side, transparent 92%, #000 93%);
    mask: radial-gradient(closest-side, transparent 92%, #000 93%);
  }

  .page-halo__ring--inner {
    inset: 27%;
    border: 1px solid rgb(0 229 255 / 0.35);
    box-shadow:
      0 0 40px rgb(0 229 255 / 0.18),
      inset 0 0 60px rgb(18 100 255 / 0.25);
  }

  @media (min-width: 64rem) {
    .page-halo {
      display: grid;
    }
  }
</style>
