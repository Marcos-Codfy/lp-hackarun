---
// botão do menu mobile; vira o "fechar" com o overlay aberto (MobileMenuController cuida de aria-expanded e do rótulo)
interface Props {
  controls: string;
}

const { controls } = Astro.props;
---

<button class="menu-toggle" type="button" aria-expanded="false" aria-controls={controls} data-menu-toggle>
  <span class="sr-only" data-menu-label>
    Abrir menu
  </span>
  <span class="menu-toggle__burger" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>

<style>
  .menu-toggle {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--text);
    -webkit-tap-highlight-color: transparent;
  }

  .menu-toggle::before {
    content: '';
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: 3px;
    background: linear-gradient(180deg, rgb(28 44 140 / 0.4), rgb(6 9 30 / 0.55));
    box-shadow:
      inset 0 0 0 1px rgb(0 229 255 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
    transform: skewX(var(--skew));
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .menu-toggle:hover::before,
  .menu-toggle[aria-expanded='true']::before {
    box-shadow:
      inset 0 0 0 1px rgb(0 229 255 / 0.75),
      0 0 18px rgb(0 229 255 / 0.35);
  }

  .menu-toggle:focus-visible {
    outline: none;
  }

  .menu-toggle:focus-visible::before {
    box-shadow:
      0 0 0 2px var(--c-void),
      0 0 0 4px var(--focus);
  }

  /* três traços de tamanhos diferentes (assinatura HUD) que viram um X */
  .menu-toggle__burger {
    display: grid;
    justify-items: end;
    gap: 4px;
    width: 18px;
  }

  .menu-toggle__burger span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out),
      width var(--dur) var(--ease-out);
  }

  .menu-toggle__burger span:nth-child(2) {
    width: 70%;
    background: var(--c-cyan);
  }

  .menu-toggle__burger span:nth-child(3) {
    width: 45%;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__burger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__burger span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__burger span:nth-child(3) {
    width: 100%;
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }
</style>
