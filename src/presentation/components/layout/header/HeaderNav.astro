---
import { NAV_LINKS } from '../navLinks';

// navegação do desktop: sublinhado degradê que cresce do centro; o ativo vem do NavSpyController
---

<nav class="header-nav" aria-label="Principal">
  <ul class="header-nav__list" role="list">
    {NAV_LINKS.map((link) => (
      <li>
        <a class="header-nav__link" href={link.href} data-nav-link>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .header-nav {
    display: none;
  }

  .header-nav__list {
    display: flex;
    gap: var(--space-1);
  }

  .header-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.65rem;
    border-radius: 6px;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-shadow var(--dur) var(--ease-out);
  }

  .header-nav__link::after {
    content: '';
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 9px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-energy);
    box-shadow: 0 0 10px rgb(0 229 255 / 0.6);
    transform: scaleX(0);
    transition: transform var(--dur) var(--ease-out);
  }

  .header-nav__link:hover {
    color: var(--text);
  }

  .header-nav__link:hover::after {
    transform: scaleX(0.6);
  }

  .header-nav__link[aria-current='true'] {
    color: var(--text);
    text-shadow: 0 0 14px rgb(0 229 255 / 0.55);
  }

  .header-nav__link[aria-current='true']::after {
    transform: scaleX(1);
  }

  .header-nav__link:focus-visible {
    outline-offset: -2px;
  }

  @media (min-width: 1024px) {
    .header-nav {
      display: block;
      margin-inline: auto;
    }
  }

  @media (min-width: 1280px) {
    .header-nav__link {
      padding-inline: 1rem;
    }

    .header-nav__link::after {
      left: 1rem;
      right: 1rem;
    }
  }
</style>
