---
import type { LandingPageDTO } from '@application/index';
import Wordmark from '@presentation/components/ui/Wordmark.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import { NAV_LINKS } from './navLinks';

interface Props {
  data: LandingPageDTO;
}

const { event, partners } = Astro.props.data;
const dates = new DayLabelFormatter().range(event.firstDate, event.lastDate);
const organizer = partners.find((p) => p.role === 'organizer')?.name ?? 'Unicatólica';
const partner = partners.find((p) => p.role === 'partner')?.name ?? 'Capim Dourado Shopping';
const REPO_URL = 'https://github.com/Marcos-Codfy/lp-hackarun';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a
        class="site-footer__wordmark"
        href="#inicio"
        data-nav-link
        aria-label="HackaRun 2026, voltar ao início"
      >
        <Wordmark size="xl" />
      </a>
      <p class="hud-label site-footer__tagline">
        {event.tagline} · {dates} · {event.city}
      </p>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__credits">
        <p>
          <span class="hud-label">
            Realização<span class="sr-only">:</span>
          </span>{' '}
          {organizer} · cursos de Engenharia de Software e Inteligência Artificial
        </p>
        <p>
          <span class="hud-label">
            Parceria<span class="sr-only">:</span>
          </span>{' '}
          {partner}
        </p>
      </div>

      <nav aria-label="Rodapé">
        <ul class="site-footer__nav" role="list">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a class="site-footer__repo" href={REPO_URL} target="_blank" rel="noopener noreferrer">
        <Icon name="code" />
        Código aberto no GitHub
        <span class="sr-only"> (abre em nova aba)</span>
      </a>
    </div>

    <div class="site-footer__bottom">
      <p>© 2026 HackaRun</p>
      <a class="site-footer__top" href="#inicio" data-nav-link>
        Voltar ao topo
        <Icon name="arrow-up" size={18} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    padding-block: var(--space-9) var(--space-6);
    border-top: 1px solid var(--surface-line);
    background: linear-gradient(180deg, rgb(4 11 24 / 0.55), var(--bg-deep) 40%);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-8);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-4);
  }

  .site-footer__wordmark {
    justify-self: start;
    text-decoration: none;
  }

  .site-footer__tagline {
    color: var(--text-dim);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-7);
  }

  .site-footer__credits {
    display: grid;
    gap: var(--space-4);
    max-width: 30rem;
    color: var(--text-muted);
  }

  .site-footer__credits .hud-label {
    display: block;
    margin-bottom: var(--space-1);
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-5);
  }

  .site-footer__nav a,
  .site-footer__repo,
  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }

  .site-footer__nav a:hover,
  .site-footer__repo:hover,
  .site-footer__top:hover {
    color: var(--c-cyan);
  }

  .site-footer__repo {
    align-self: start;
    font-weight: 600;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--surface-line);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .site-footer__top {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr auto;
      align-items: start;
    }
  }
</style>
