---
import type { LandingPageDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import PartnersBand from '@presentation/components/partners/PartnersBand.astro';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import FooterBrand from './footer/FooterBrand.astro';
import FooterNav from './footer/FooterNav.astro';

interface Props {
  data: LandingPageDTO;
}

const { event, partners } = Astro.props.data;
const dates = new DayLabelFormatter().range(event.firstDate, event.lastDate);
const REPO_URL = 'https://github.com/Marcos-Codfy/lp-hackarun';
---

<footer class="site-footer">
  <PartnersBand partners={partners} />

  <div class="container site-footer__main">
    <FooterBrand meta={`${dates} · ${event.city} · Hackathon de Engenharia de Software e IA`} />
    <FooterNav repoUrl={REPO_URL} />
  </div>

  <div class="container site-footer__bottom">
    <p>© 2026 HackaRun · Unicatólica</p>
    <a class="site-footer__top" href="#inicio" data-nav-link>
      Voltar ao topo
      <span class="site-footer__top-icon" aria-hidden="true">
        <Icon name="arrow-up" size={16} />
      </span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    overflow: clip;
    background: linear-gradient(180deg, transparent, rgb(2 3 11 / 0.92) 22%, var(--c-void) 60%);
  }

  /* filete de energia no topo do rodapé */
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    right: 10%;
    left: 10%;
    height: 1px;
    background: var(--grad-line);
  }

  .site-footer__main {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* celular: sobra espaço pro HUD fixo de progresso que fica no rodapé da tela */
    padding-block: var(--space-5) calc(var(--space-6) + 3.5rem);
    border-top: 1px solid rgb(140 160 255 / 0.12);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-footer__top-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgb(0 229 255 / 0.45);
    border-radius: 3px;
    color: var(--c-cyan);
    transition:
      translate var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .site-footer__top:hover .site-footer__top-icon {
    translate: 0 -3px;
    box-shadow: 0 0 20px rgb(0 229 255 / 0.45);
  }

  @media (min-width: 1024px) {
    .site-footer__bottom {
      padding-bottom: var(--space-6);
    }

    .site-footer__main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: start;
      gap: var(--space-9);
    }
  }
</style>
