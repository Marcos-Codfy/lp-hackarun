---
import Icon from '@presentation/components/ui/Icon.astro';
import { NAV_LINKS } from '../navLinks';

// navegação numerada do rodapé + cartão do repositório + aviso de privacidade
interface Props {
  repoUrl: string;
}

const { repoUrl } = Astro.props;
---

<div class="fnav">
  <nav aria-label="Rodapé">
    <p class="fnav__title" aria-hidden="true">
      // Navegação
    </p>
    <ul class="fnav__list" role="list">
      {NAV_LINKS.map((link, i) => (
        <li>
          <a class="fnav__link" href={link.href} data-nav-link>
            <span class="fnav__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="fnav__extra">
    <a class="fnav__repo" href={repoUrl} target="_blank" rel="noopener noreferrer">
      <span class="fnav__repo-icon" aria-hidden="true">
        <Icon name="code" size={22} />
      </span>
      <span class="fnav__repo-text">
        <span class="fnav__repo-title">Código aberto no GitHub</span>
        <span class="fnav__repo-sub">Marcos-Codfy/lp-hackarun</span>
      </span>
      <Icon name="external" size={18} class="fnav__repo-arrow" />
      <span class="sr-only"> (abre em nova aba)</span>
    </a>

    <a class="fnav__legal" href="/privacidade">
      <Icon name="shield" size={16} />
      Aviso de privacidade · LGPD
    </a>
  </div>
</div>

<style>
  .fnav {
    display: grid;
    gap: var(--space-7);
    align-content: start;
  }

  .fnav__title {
    margin-bottom: var(--space-3);
    color: #8ff3ff;
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .fnav__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-6);
  }

  .fnav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .fnav__num {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .fnav__link:hover {
    color: #8ff3ff;
  }

  .fnav__link:hover .fnav__num {
    color: var(--c-cyan);
  }

  .fnav__extra {
    display: grid;
    gap: var(--space-3);
  }

  .fnav__repo {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid rgb(140 160 255 / 0.2);
    border-radius: 4px;
    background: linear-gradient(120deg, rgb(18 100 255 / 0.14), rgb(6 9 30 / 0.7) 60%);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .fnav__repo:hover {
    border-color: rgb(0 229 255 / 0.6);
    box-shadow: 0 0 36px -8px rgb(0 229 255 / 0.45);
  }

  .fnav__repo-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(0 229 255 / 0.4);
    border-radius: 3px;
    color: var(--c-cyan);
  }

  .fnav__repo-text {
    display: grid;
    gap: 2px;
  }

  .fnav__repo-title {
    font-weight: 700;
  }

  .fnav__repo-sub {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .fnav__repo :global(.fnav__repo-arrow) {
    color: var(--text-dim);
    transition: translate var(--dur) var(--ease-out);
  }

  .fnav__repo:hover :global(.fnav__repo-arrow) {
    color: var(--c-cyan);
    translate: 2px -2px;
  }

  .fnav__legal {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    min-height: 44px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .fnav__legal:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .fnav__legal:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  @media (min-width: 640px) and (max-width: 1023px), (min-width: 1280px) {
    .fnav__list {
      grid-template-columns: repeat(3, minmax(0, auto));
      justify-content: start;
      column-gap: var(--space-7);
    }
  }
</style>
