---
import Icon from '@presentation/components/ui/Icon.astro';
import { REGULATION_PDF } from '../documents';
import { footerLinksFor, type SitePage } from '../navLinks';

// navegação numerada do rodapé (as seções da LP e a Inscrição) + regulamento (só download) e aviso de privacidade
interface Props {
  page?: SitePage;
}

const { page = 'home' } = Astro.props;
---

<div class="fnav">
  <nav aria-label="Rodapé">
    <p class="fnav__title" aria-hidden="true">
      // Navegação
    </p>
    <ul class="fnav__list" role="list">
      {footerLinksFor(page).map((link, i) => (
        <li>
          <a class="fnav__link" href={link.href} aria-current={link.ariaCurrent} data-nav-link>
            <span class="fnav__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="fnav__docs">
    <a
      class="fnav__legal"
      href={REGULATION_PDF.href}
      download={REGULATION_PDF.fileName}
      type="application/pdf"
      data-regulation-download
    >
      <Icon name="book" size={16} />
      {REGULATION_PDF.label}
      <span class="fnav__size">· {REGULATION_PDF.size}</span>
    </a>
    <a class="fnav__legal" href="/privacidade">
      <Icon name="shield" size={16} />
      Aviso de privacidade · LGPD
    </a>
  </div>
</div>

<style>
  .fnav {
    display: grid;
    gap: var(--space-7);
    align-content: start;
  }

  .fnav__title {
    margin-bottom: var(--space-3);
    color: #8ff3ff;
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  /* colunas do tamanho do texto: em 360px "03 Programação" não encosta no "04 Final" ao lado */
  .fnav__list {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    justify-content: space-between;
    gap: 0 var(--space-6);
  }

  .fnav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .fnav__num {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .fnav__link:hover {
    color: #8ff3ff;
  }

  .fnav__link:hover .fnav__num {
    color: var(--c-cyan);
  }

  .fnav__legal {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    min-height: 44px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  /* regulamento e privacidade, um embaixo do outro */
  .fnav__docs {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .fnav__size {
    color: var(--text-dim);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .fnav__legal:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .fnav__legal:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  /* 320 px: "04 Patrocinadores" não cabe ao lado de outra coluna; os links ficam numa coluna só */
  @media (max-width: 359px) {
    .fnav__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 640px) and (max-width: 1023px), (min-width: 1280px) {
    .fnav__list {
      grid-template-columns: repeat(3, minmax(0, auto));
      justify-content: start;
      column-gap: var(--space-7);
    }
  }

  /* desktop: o aviso desce até a base da coluna da marca e as duas colunas fecham juntas */
  @media (min-width: 1024px) {
    .fnav {
      align-self: stretch;
      grid-template-rows: auto 1fr;
    }

    .fnav__docs {
      align-self: end;
    }
  }
</style>
