---
import BrandLogo from './BrandLogo.astro';

// logo oficial em tamanhos fixos (header, rodapé, 404). Decorativo: quem usa dá o nome acessível
interface Props {
  size?: 'sm' | 'md' | 'xl';
  // no header das páginas sem hero o logo é o LCP: sem lazy e com fetchpriority alta
  priority?: boolean;
  class?: string;
}

const { size = 'sm', priority = false, class: className } = Astro.props;

const SOURCES = {
  sm: { widths: [160, 320], sizes: '160px' },
  md: { widths: [280, 560], sizes: '280px' },
  xl: { widths: [480, 760, 1120], sizes: '(min-width: 1024px) 560px, 80vw' },
} as const;
const source = SOURCES[size];
---

<span class:list={['wordmark', `wordmark--${size}`, className]} aria-hidden="true">
  <BrandLogo widths={[...source.widths]} sizes={source.sizes} priority={priority} />
</span>

<style>
  .wordmark {
    display: inline-block;
    line-height: 0;
    /* o PNG tem respiro transparente: puxa as margens pra alinhar com o texto em volta */
    margin-block: calc(var(--wm-w) * -0.07) calc(var(--wm-w) * -0.06);
    width: var(--wm-w);
    filter: drop-shadow(0 0 14px rgb(18 100 255 / 0.35));
  }

  .wordmark--sm {
    --wm-w: 8.5rem;
  }

  .wordmark--md {
    --wm-w: 14rem;
  }

  .wordmark--xl {
    --wm-w: clamp(16rem, 8rem + 30vw, 35rem);
  }
</style>
