---
// card bloqueado "???": curiosidade até a organização revelar quem é
interface Props {
  label: string;
  hint?: string | null;
  as?: 'li' | 'div';
}

const { label, hint = null, as: Tag = 'li' } = Astro.props;
---

<Tag class="locked-card">
  <div class="locked-card__portrait" aria-hidden="true">
    <svg class="locked-card__silhouette" viewBox="0 0 120 120" fill="none">
      <circle cx="60" cy="44" r="22" fill="currentColor"></circle>
      <path d="M18 120c4-26 21-40 42-40s38 14 42 40z" fill="currentColor"></path>
    </svg>
    <span class="locked-card__q">???</span>
  </div>
  <p class="locked-card__role hud-label">{label}</p>
  <p class="locked-card__name">
    <span aria-hidden="true">A revelar</span>
    <span class="sr-only">{label}: a revelar</span>
  </p>
  {hint && <p class="locked-card__hint">{hint}</p>}
</Tag>

<style>
  .locked-card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    clip-path: var(--clip-card);
    background: linear-gradient(170deg, rgb(11 36 80 / 0.6), rgb(4 11 24 / 0.85));
    box-shadow: inset 0 0 0 1px var(--surface-line);
  }

  .locked-card__portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin-bottom: var(--space-2);
    overflow: hidden;
    clip-path: var(--clip-btn);
    background:
      repeating-linear-gradient(0deg, rgb(127 231 255 / 0.05) 0 1px, transparent 1px 4px),
      radial-gradient(circle at 50% 35%, rgb(30 123 255 / 0.28), rgb(4 11 24 / 0.9) 70%);
    color: rgb(127 231 255 / 0.14);
  }

  .locked-card__silhouette {
    position: absolute;
    inset: 12% 12% 0;
    width: 76%;
    height: 88%;
  }

  /* brilho que atravessa devagar: "tem alguém aqui" */
  .locked-card__portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(127 231 255 / 0.16) 50%, transparent 65%);
    transform: translateX(-100%);
    animation: locked-shimmer 3.6s var(--ease-in-out) infinite;
  }

  .locked-card__q {
    position: relative;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--c-cyan-soft);
    text-shadow: 0 0 18px rgb(0 207 255 / 0.6);
  }

  .locked-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
  }

  .locked-card__hint {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  @keyframes locked-shimmer {
    to {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .locked-card__portrait::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
