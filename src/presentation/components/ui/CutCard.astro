---
import type { HTMLAttributes } from 'astro/types';

// card com corte angular e borda de 1px (a borda é o fundo do card, o miolo é o ::before)
type Props = HTMLAttributes<'div'> & {
  as?: 'div' | 'li' | 'article';
  tone?: 'default' | 'energy' | 'time';
  interactive?: boolean;
};

const { as: Tag = 'div', tone = 'default', interactive = false, class: className, ...rest } = Astro.props;
---

<Tag
  class:list={['cut-card', `cut-card--${tone}`, interactive && 'cut-card--interactive', className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .cut-card {
    --cut-line: rgb(127 231 255 / 0.18);
    --cut-bg: linear-gradient(165deg, rgb(11 36 80 / 0.86) 0%, rgb(6 17 36 / 0.92) 60%);
    position: relative;
    isolation: isolate;
    padding: var(--space-5);
    clip-path: var(--clip-card);
    background: var(--cut-line);
  }

  .cut-card::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    clip-path: var(--clip-card);
    background: var(--cut-bg);
  }

  .cut-card--energy {
    --cut-line: var(--grad-energy);
    --cut-bg: linear-gradient(165deg, rgb(13 52 110 / 0.92) 0%, rgb(6 17 36 / 0.94) 70%);
  }

  .cut-card--time {
    --cut-line: linear-gradient(135deg, rgb(255 181 71 / 0.7), rgb(255 181 71 / 0.15));
  }

  .cut-card--interactive:hover,
  .cut-card--interactive:focus-within {
    --cut-line: linear-gradient(135deg, var(--c-cyan), rgb(30 123 255 / 0.4));
  }

  @media (min-width: 640px) {
    .cut-card {
      padding: var(--space-6);
    }
  }
</style>
