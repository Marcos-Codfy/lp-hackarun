---
import type { HTMLAttributes } from 'astro/types';
import ButtonChevrons from './ButtonChevrons.astro';
// css global (prefixo .btn): quem usa consegue ajustar sem brigar com o escopo do Astro
import './button/button.css';
import './button/button-variants.css';

type Variant = 'primary' | 'ghost' | 'time' | 'mystic';
type Size = 'sm' | 'md' | 'lg';

type Props = Omit<HTMLAttributes<'a'>, 'type'> & {
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  variant?: Variant;
  size?: Size;
  // CTA de inscrição: o front intercepta e leva até o formulário
  registrationCta?: string;
  // ">>" do manual; o slot "icon" tem prioridade. Padrão: só nos botões cheios
  chevrons?: boolean;
};

const {
  href,
  type = 'button',
  disabled = false,
  variant = 'primary',
  size = 'md',
  registrationCta,
  chevrons = variant !== 'ghost',
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
const hasIcon = Astro.slots.has('icon');
// <a> não tem disabled de verdade: vira aria-disabled
const disabledAttrs: Record<string, string | boolean> = !disabled
  ? {}
  : href
    ? { 'aria-disabled': 'true' }
    : { disabled: true };
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  type={href ? undefined : type}
  data-registration-cta={registrationCta}
  {...disabledAttrs}
  {...rest}
>
  <span class="btn__shell" aria-hidden="true">
    <span class="btn__sheen"></span>
  </span>
  <span class="btn__label">
    <slot />
  </span>
  {hasIcon ? (
    <span class="btn__icon" aria-hidden="true">
      <slot name="icon" />
    </span>
  ) : (
    chevrons && <ButtonChevrons />
  )}
</Tag>
