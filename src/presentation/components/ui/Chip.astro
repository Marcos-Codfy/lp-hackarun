---
import type { HTMLAttributes } from 'astro/types';

// etiqueta curta de HUD (skills, tópicos, datas): paralelogramo de vidro com fio de 1px
type Props = HTMLAttributes<'span'> & {
  as?: 'span' | 'li' | 'p';
  tone?: 'default' | 'accent' | 'time' | 'mystic';
};

const { as: Tag = 'span', tone = 'default', class: className, ...rest } = Astro.props;
---

<Tag class:list={['chip', `chip--${tone}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .chip {
    --chip-line: rgb(150 175 255 / 0.22);
    --chip-bg: rgb(8 12 40 / 0.55);
    --chip-fg: var(--text-muted);
    --chip-dot: rgb(150 175 255 / 0.6);
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 1.875rem;
    padding: var(--space-1) 0.9rem;
    color: var(--chip-fg);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* casca inclinada atrás do texto reto (mesma linguagem dos botões) */
  .chip::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 2px;
    background: var(--chip-bg);
    box-shadow:
      inset 0 0 0 1px var(--chip-line),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    transform: skewX(var(--skew));
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .chip :global(.icon) {
    color: var(--chip-dot);
  }

  .chip--accent {
    --chip-line: rgb(0 229 255 / 0.5);
    --chip-bg: linear-gradient(100deg, rgb(0 229 255 / 0.12), rgb(18 100 255 / 0.1));
    --chip-fg: #bff7ff;
    --chip-dot: var(--c-cyan);
  }

  .chip--time {
    --chip-line: rgb(255 133 47 / 0.55);
    --chip-bg: linear-gradient(100deg, rgb(255 194 74 / 0.12), rgb(255 133 47 / 0.08));
    --chip-fg: #ffd9a8;
    --chip-dot: var(--c-orange);
  }

  .chip--mystic {
    --chip-line: rgb(148 27 255 / 0.6);
    --chip-bg: linear-gradient(100deg, rgb(148 27 255 / 0.16), rgb(237 40 232 / 0.1));
    --chip-fg: #e9c8ff;
    --chip-dot: var(--c-magenta);
  }
</style>
