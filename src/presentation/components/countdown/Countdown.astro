---
// contador laranja/ouro pro próximo marco (largada -> fim do desenvolvimento -> grande final); CountdownView dá vida.
// Contrato com a View: [data-countdown] > [data-countdown-label|sr|tag] e [data-countdown-unit=days..seconds]
import type { MilestoneDTO } from '@application/index';
import { milestoneSentence, milestoneTag } from '@presentation/view-models/countdown/milestoneText';
import CountdownTile from './CountdownTile.astro';

interface Props {
  milestones: MilestoneDTO[];
  variant?: 'hero' | 'compact';
}

const { milestones, variant = 'hero' } = Astro.props;

// SSR usa o próximo marco na hora do build; o browser corrige assim que monta
const now = Date.now();
const next = [...milestones]
  .sort((a, b) => Date.parse(a.at) - Date.parse(b.at))
  .find((m) => Date.parse(m.at) > now);
const label = next?.label ?? 'Corrida encerrada';
const units = [
  { key: 'days', name: 'dias' },
  { key: 'hours', name: 'horas' },
  { key: 'minutes', name: 'min' },
  { key: 'seconds', name: 'seg' },
] as const;
---

<div class:list={['countdown', `countdown--${variant}`]} data-countdown data-milestone={next?.key ?? 'over'}>
  <div class="countdown__head" aria-hidden="true">
    <p class="countdown__label">
      <span class="countdown__pulse"></span>
      <span data-countdown-label>{label}</span>
    </p>
    <p class="countdown__tag">
      <span class="countdown__tag-code">// alvo</span>
      <span data-countdown-tag>{milestoneTag(next?.at ?? null)}</span>
    </p>
  </div>
  <p class="sr-only" data-countdown-sr>
    {milestoneSentence(label, next?.at ?? null)}
  </p>
  <div class="countdown__digits" aria-hidden="true">
    {units.map((u) => (
      <CountdownTile unit={u.key} name={u.name} />
    ))}
  </div>
</div>

<style>
  .countdown {
    --cd-size: clamp(1.75rem, 0.9rem + 4.2vw, 2.75rem);
    --cd-gap: clamp(0.625rem, 0.4rem + 1vw, 1rem);
    display: inline-grid;
    justify-items: center;
    gap: var(--space-3);
  }

  .countdown--hero {
    --cd-size: clamp(1.75rem, 0.9rem + 4.2vw, 2.75rem);
  }

  .countdown--compact {
    --cd-size: clamp(1.375rem, 1rem + 1.2vw, 1.875rem);
    --cd-gap: 0.625rem;
  }

  .countdown__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-1) var(--space-4);
    width: 100%;
  }

  .countdown__label,
  .countdown__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
    color: #ffb877;
    text-shadow: 0 0 12px rgb(255 133 47 / 0.45);
  }

  .countdown__tag {
    color: var(--text-dim);
    font-weight: 500;
    text-shadow: none;
  }

  .countdown__tag-code {
    color: var(--time);
  }

  /* ponto "ao vivo" */
  .countdown__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-orange);
    box-shadow:
      0 0 0 3px rgb(255 133 47 / 0.18),
      0 0 12px var(--c-orange);
    animation: cd-pulse 1.6s var(--ease-in-out) infinite;
  }

  .countdown__digits {
    display: flex;
    gap: var(--cd-gap);
  }

  /* troca de marco: um flash curto pra chamar atenção */
  .countdown:global(.is-switching) .countdown__digits {
    animation: cd-flash 700ms var(--ease-out);
  }

  /* reduced motion: sem segundos correndo na tela */
  .countdown:global(.is-calm) :global(.countdown__unit--seconds) {
    display: none;
  }

  @keyframes cd-pulse {
    50% {
      opacity: 0.3;
      box-shadow:
        0 0 0 6px rgb(255 133 47 / 0),
        0 0 6px var(--c-orange);
    }
  }

  @keyframes cd-flash {
    0% {
      opacity: 0.2;
      filter: brightness(1.8);
    }
    100% {
      opacity: 1;
      filter: none;
    }
  }

  @media (min-width: 1024px) {
    .countdown--hero {
      --cd-size: clamp(2rem, 1rem + 1.6vw, 2.75rem);
    }

    .countdown--hero .countdown__head {
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .countdown__pulse {
      animation: none;
    }
  }
</style>
