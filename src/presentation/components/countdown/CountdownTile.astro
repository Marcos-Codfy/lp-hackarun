---
// um "ladrilho" do contador: vidro inclinado com fio laranja, dígitos Orbitron em degradê ouro
interface Props {
  unit: 'days' | 'hours' | 'minutes' | 'seconds';
  name: string;
}

const { unit, name } = Astro.props;
---

<span class:list={['countdown__unit', `countdown__unit--${unit}`]}>
  <span class="cd-tile">
    <span class="cd-tile__value" data-countdown-unit={unit}>
      --
    </span>
  </span>
  <span class="cd-tile__name">{name}</span>
</span>

<style>
  .countdown__unit {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  /* ":" entre os ladrilhos, piscando no ritmo do segundo */
  .countdown__unit + .countdown__unit::before {
    content: '';
    position: absolute;
    top: calc(var(--cd-size) * 0.78);
    left: calc(var(--cd-gap) / -2 - 2px);
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--c-gold);
    box-shadow:
      0 calc(var(--cd-size) * -0.22) 0 var(--c-gold),
      0 0 10px 1px var(--c-orange);
    transform: translateY(calc(var(--cd-size) * 0.1));
    animation: cd-blink 1s steps(1) infinite;
  }

  .cd-tile {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-width: 2.25em;
    padding: 0.3em 0.42em;
    font-size: var(--cd-size);
  }

  .cd-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 4px;
    background:
      linear-gradient(180deg, rgb(255 170 90 / 0.14) 0%, rgb(14 10 32 / 0.62) 49%, rgb(8 7 24 / 0.78) 51%),
      rgb(6 6 22 / 0.4);
    box-shadow:
      inset 0 0 0 1px rgb(255 160 80 / 0.32),
      inset 0 1px 0 rgb(255 230 190 / 0.28),
      inset 0 0 24px rgb(255 133 47 / 0.1),
      0 14px 30px -18px rgb(255 133 47 / 0.8);
    transform: skewX(var(--skew));
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* vinco no meio, à la placar flip */
  .cd-tile::after {
    content: '';
    position: absolute;
    inset: 50% 6% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(2 3 11 / 0.9), transparent);
    transform: skewX(var(--skew));
  }

  .cd-tile__value {
    min-width: 2ch;
    font-family: var(--font-display);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: 0.02em;
    text-align: center;
    background: var(--grad-time);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 12px rgb(255 133 47 / 0.55));
  }

  .cd-tile__name {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  @keyframes cd-blink {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .countdown__unit + .countdown__unit::before {
      animation: none;
    }
  }
</style>
