---
import { Image } from 'astro:assets';
import type { PartnerDTO } from '@application/index';
import type { PartnerBrand } from './partnerBrands';
import { PARTNER_ROLES, markVars, markWidthRem, partnerCopy } from './partnerMarks';

// um parceiro na faixa: papel + logo oficial branca + legenda; vira link quando tem site
interface Props {
  partner: PartnerDTO;
  brand: PartnerBrand;
}

const { partner, brand } = Astro.props;
const { label, tone } = PARTNER_ROLES[partner.role];
const { logo, ink, height } = brand;
const { caption, alt } = partnerCopy(partner, brand);
// largura no desktop (1x, 2x e 3x): a faixa só encolhe a logo daí pra baixo
const widthRem = markWidthRem(logo, ink, height);
const widths = [...new Set([1, 2, 3].map((d) => Math.min(logo.width, Math.round(widthRem * 16 * d))))];
const { url } = partner;
const Tag = url ? 'a' : 'div';
const linkAttrs = url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class:list={['partner', `partner--${tone}`]} {...linkAttrs}>
  <span class="partner__role">{label}</span>
  <span class="partner__mark" style={markVars(logo, ink, height)}>
    <Image
      class="partner__img"
      src={logo}
      alt={alt}
      widths={widths}
      sizes={`${widthRem}rem`}
      loading="lazy"
    />
  </span>
  <span class="partner__caption">
    {caption}
    {url && <span class="sr-only"> (abre em nova aba)</span>}
  </span>
</Tag>

<style>
  .partner {
    --glow: rgb(0 229 255 / 0.55);
    --role-ink: var(--ink-cyan);
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-4);
    width: 100%;
    /* sem respiro lateral no celular: em 320px cada legenda tem só ~130px de coluna */
    padding: var(--space-4) 0;
    border-radius: 4px;
    color: inherit;
    text-align: center;
    text-decoration: none;
    transition: background var(--dur) var(--ease-out);
  }

  .partner--violet {
    --glow: rgb(148 27 255 / 0.5);
    --role-ink: var(--ink-violet);
  }

  .partner--gold {
    --glow: rgb(255 194 74 / 0.5);
    --role-ink: var(--ink-gold);
  }

  .partner:hover {
    background: radial-gradient(
      60% 70% at 50% 45%,
      color-mix(in srgb, var(--glow) 18%, transparent),
      transparent 75%
    );
  }

  .partner__role {
    color: var(--role-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  /* toda logo numa caixa da mesma altura (a do desenho mais alto): as legendas começam na mesma linha.
     --mark-box e --mark-scale vêm da faixa */
  .partner__mark {
    --ink: calc(var(--h) * var(--mark-scale, 1));
    display: grid;
    place-items: center;
    width: 100%;
    height: calc(var(--mark-box, 8.25rem) * var(--mark-scale, 1));
  }

  /* a altura manda (proporção pelo width/height do PNG); as margens negativas tiram a borda transparente.
     Se a coluna ficar mais estreita que a logo, o contain encolhe o desenho em vez de esticar */
  .partner__img {
    width: auto;
    max-width: 100%;
    height: calc(var(--ink) * var(--k));
    margin: calc(var(--ink) * var(--mt)) calc(var(--ink) * var(--mr)) calc(var(--ink) * var(--mb))
      calc(var(--ink) * var(--ml));
    object-fit: contain;
    opacity: 0.88;
    transition:
      opacity var(--dur) var(--ease-out),
      filter var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }

  .partner:hover .partner__img,
  .partner:focus-visible .partner__img {
    opacity: 1;
    filter: drop-shadow(0 0 22px var(--glow));
    translate: 0 -3px;
  }

  .partner__caption {
    max-width: 18rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.5;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .partner {
      gap: var(--space-5);
      padding: var(--space-5) var(--space-4);
    }

    .partner__caption {
      font-size: var(--fs-sm);
    }
  }

  /* respiro lateral menor: em 1024px a legenda da LAES quebrava em 3 linhas e as outras em 2 */
  @media (min-width: 64rem) {
    .partner {
      padding: var(--space-6) var(--space-4);
    }
  }

  .partner:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .partner:hover .partner__img {
      translate: none;
    }
  }
</style>
