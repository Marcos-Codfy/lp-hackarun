---
import type { PartnerDTO } from '@application/index';
import PartnerLogo from './PartnerLogo.astro';
import { PARTNER_BRANDS } from './partnerBrands';

// faixa de autoridade antes do rodapé: realização, organização e parceria, com as logos oficiais.
// A ordem vem do ListPartners; só entra quem tem logo cadastrada em partnerBrands
interface Props {
  partners: PartnerDTO[];
}

const items = Astro.props.partners.flatMap((partner) => {
  const brand = PARTNER_BRANDS[partner.id];
  return brand ? [{ partner, brand }] : [];
});
---

<section class="partners" aria-labelledby="partners-title">
  <div class="container partners__inner">
    <h2 class="partners__title" id="partners-title">
      <span class="partners__rule" aria-hidden="true"></span>
      Quem faz acontecer
      <span class="partners__rule" aria-hidden="true"></span>
    </h2>
    <ul class="partners__row" role="list">
      {items.map(({ partner, brand }) => (
        <li class="partners__item">
          <PartnerLogo partner={partner} brand={brand} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* o fundo da faixa nasce transparente: o globo do clímax passa por trás do rodapé, e uma borda reta aqui
     cortaria a esfera ao meio (a metade de baixo ficava mais escura de repente) */
  .partners {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    border-bottom: 1px solid rgb(140 160 255 / 0.1);
  }

  /* um halo por papel, atrás de cada logo: ciano, violeta e dourado (2 + 1 no celular, 3 lado a lado depois) */
  .partners::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(45% 40% at 25% 40%, rgb(18 100 255 / 0.1), transparent 70%),
      radial-gradient(45% 40% at 75% 40%, rgb(148 27 255 / 0.08), transparent 70%),
      radial-gradient(55% 35% at 50% 85%, rgb(255 194 74 / 0.06), transparent 70%),
      linear-gradient(180deg, rgb(2 3 11 / 0.4), rgb(6 11 36 / 0.6) 50%, rgb(2 3 11 / 0.4));
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 10rem);
    mask-image: linear-gradient(180deg, transparent, #000 10rem);
    pointer-events: none;
  }

  .partners__inner {
    display: grid;
    gap: var(--space-6);
  }

  .partners__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 500;
    letter-spacing: var(--tracking-hud);
  }

  .partners__rule {
    width: clamp(2rem, 8vw, 6rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(0 229 255 / 0.6));
  }

  .partners__rule:last-child {
    transform: scaleX(-1);
  }

  /* celular e tablet: 2 + 1. Realização e organização lado a lado; a parceria embaixo, na largura toda
     (as três empilhadas passavam de uma tela no rodapé). --mark-box = altura do desenho mais alto.
     stretch: itens da mesma linha com a mesma altura, então os fios (no meio de cada item) ficam alinhados
     mesmo quando uma legenda quebra numa linha a mais */
  .partners__row {
    --mark-box: 8.25rem;
    --mark-scale: 0.78;
    --gap: var(--space-3);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    justify-items: center;
    gap: var(--space-4) var(--gap);
  }

  .partners__item {
    position: relative;
    display: grid;
    width: 100%;
  }

  /* fio vertical entre as duas colunas, na altura das logos */
  .partners__item:nth-child(even)::before,
  .partners__item:last-child:nth-child(odd):not(:first-child)::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--gap) / -2);
    width: 1px;
    height: 8rem;
    translate: 0 -50%;
    background: linear-gradient(180deg, transparent, rgb(140 160 255 / 0.45), transparent);
  }

  /* a sobra ímpar ocupa a linha toda, com o fio deitado em cima. No celular ela fica menor: sozinha na linha
     e com a logo mais larga, a parceria lia como a marca principal da faixa (a realização é quem abre) */
  .partners__item:last-child:nth-child(odd):not(:first-child) {
    --mark-scale: 0.66;
    grid-column: 1 / -1;
    padding-top: var(--space-4);
  }

  .partners__item:last-child:nth-child(odd):not(:first-child)::before {
    top: 0;
    left: 50%;
    width: min(18rem, 70%);
    height: 1px;
    translate: -50% 0;
    background: linear-gradient(90deg, transparent, rgb(140 160 255 / 0.45), transparent);
  }

  @media (min-width: 48rem) {
    .partners__row {
      --mark-scale: 0.88;
      --gap: var(--space-6);
    }

    .partners__item:last-child:nth-child(odd):not(:first-child) {
      --mark-scale: inherit;
    }

    .partners__item:nth-child(even)::before {
      height: 10rem;
    }
  }

  /* desktop: as três lado a lado, com o mesmo peso, e um fio entre cada uma */
  @media (min-width: 64rem) {
    .partners::before {
      background:
        radial-gradient(30% 70% at 18% 50%, rgb(18 100 255 / 0.1), transparent 70%),
        radial-gradient(30% 70% at 50% 50%, rgb(148 27 255 / 0.08), transparent 70%),
        radial-gradient(30% 70% at 82% 50%, rgb(255 194 74 / 0.06), transparent 70%),
        linear-gradient(180deg, rgb(2 3 11 / 0.4), rgb(6 11 36 / 0.6) 50%, rgb(2 3 11 / 0.4));
    }

    .partners__row {
      --mark-scale: 1;
      --gap: var(--space-6);
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }

    .partners__item:last-child:nth-child(odd):not(:first-child) {
      grid-column: auto;
      padding-top: 0;
    }

    .partners__item + .partners__item::before,
    .partners__item:last-child:nth-child(odd):not(:first-child)::before {
      content: '';
      position: absolute;
      top: 50%;
      left: calc(var(--gap) / -2);
      width: 1px;
      height: 10rem;
      translate: 0 -50%;
      background: linear-gradient(180deg, transparent, rgb(140 160 255 / 0.45), transparent);
    }
  }
</style>
