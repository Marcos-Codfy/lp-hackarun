---
// linha de integrante; vive dentro do <template> e a View troca __KEY__ pela chave da linha
import TextField from './TextField.astro';
---

<li class="member" data-member-row>
  <div class="member__head">
    <p class="member__title">
      <span class="member__slot" aria-hidden="true"></span>
      <span data-member-title>Integrante</span>
    </p>
    <button type="button" class="member__remove" data-member-remove aria-label="Remover integrante">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="m4 4 8 8M12 4l-8 8"></path>
      </svg>
      <span>Remover</span>
    </button>
  </div>
  <div class="member__grid">
    <TextField
      id="member-__KEY__-name"
      memberField="name"
      label="Nome completo"
      autocomplete="off"
      maxlength={80}
      wide
    />
    <TextField
      id="member-__KEY__-email"
      memberField="email"
      label="E-mail"
      type="email"
      inputmode="email"
      autocomplete="off"
      maxlength={120}
    />
    <TextField
      id="member-__KEY__-course"
      memberField="course"
      label="Curso"
      list="reg-courses"
      autocomplete="off"
      maxlength={80}
      optional
    />
  </div>
</li>

<style>
  .member {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--surface-line);
    border-left: 2px solid var(--c-cyan);
    border-radius: 3px;
    background:
      radial-gradient(90% 60% at 0% 0%, color-mix(in srgb, var(--c-cyan) 7%, transparent), transparent 60%),
      var(--surface-well);
    animation: member-in 420ms var(--ease-out);
  }

  .member__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .member__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .member__slot {
    width: 8px;
    height: 8px;
    background: var(--c-cyan);
    box-shadow: 0 0 10px var(--c-cyan);
    transform: rotate(45deg);
  }

  .member__remove {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: 3px;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .member__remove svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .member__remove:hover {
    background: color-mix(in srgb, var(--c-danger) 10%, transparent);
    color: var(--ink-danger);
  }

  .member__remove:disabled {
    visibility: hidden;
  }

  .member__grid {
    display: grid;
    gap: var(--space-4);
  }

  @keyframes member-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (min-width: 48rem) {
    .member__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .member {
      animation: none;
    }
  }
</style>
