---
// linha de integrante; vive dentro do <template> e a View troca __KEY__ pela chave da linha
import TextField from './TextField.astro';
---

<li class="member" data-member-row>
  <div class="member__head">
    <p class="member__title" data-member-title>
      Integrante
    </p>
    <button type="button" class="member__remove" data-member-remove aria-label="Remover integrante">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="m4 4 8 8M12 4l-8 8"></path>
      </svg>
      <span>Remover</span>
    </button>
  </div>
  <div class="member__grid">
    <TextField
      id="member-__KEY__-name"
      memberField="name"
      label="Nome completo"
      autocomplete="off"
      maxlength={80}
      wide
    />
    <TextField
      id="member-__KEY__-email"
      memberField="email"
      label="E-mail"
      type="email"
      inputmode="email"
      autocomplete="off"
      maxlength={120}
    />
    <TextField
      id="member-__KEY__-course"
      memberField="course"
      label="Curso"
      list="reg-courses"
      autocomplete="off"
      maxlength={80}
      optional
    />
  </div>
</li>

<style>
  .member {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border-left: 2px solid var(--line-strong);
    background: rgb(0 207 255 / 0.03);
  }

  .member__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .member__title {
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
    color: var(--accent);
  }

  .member__remove {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .member__remove svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .member__remove:hover {
    color: var(--c-danger);
  }

  .member__remove:disabled {
    visibility: hidden;
  }

  .member__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .member__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
