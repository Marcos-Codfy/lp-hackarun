---
// card de integrante. Os do mínimo da equipe já saem no HTML (chave 0, 1...); o do <template> leva __KEY__,
// que a View troca pela chave da linha. O fieldset dá o contexto pro leitor de tela ("Integrante 2, grupo")
// e o integrante 1 ganha o selo de contato
import MemberRemove from './MemberRemove.astro';
import TextField from './TextField.astro';

interface Props {
  memberKey?: number | '__KEY__';
}

const { memberKey = '__KEY__' } = Astro.props;
const numbered = typeof memberKey === 'number';
const contact = memberKey === 0;
const number = numbered ? ` ${memberKey + 1}` : '';
// o contato é quem preenche: nome e e-mail dele podem vir do preenchimento automático (WCAG 1.3.5)
const purpose = (value: 'name' | 'email') => (contact ? value : 'off');
---

<li
  class:list={['member', { 'is-contact': contact }]}
  data-member-row
  data-member-key={numbered ? memberKey : undefined}
>
  <fieldset class="member__set">
    <legend class="member__legend">
      <span class="member__slot" aria-hidden="true"></span>
      <span class="member__title" data-member-title>
        Integrante{number}
      </span>
      <span class="member__contact" data-contact-only hidden={!contact}>
        <span class="sr-only">,</span>
        contato da equipe
      </span>
    </legend>
    <MemberRemove number={number} contact={contact} locked={numbered} />
    <p class="member__note" data-contact-only hidden={!contact}>
      É para o e-mail do contato que a organização manda a confirmação da equipe.
    </p>
    <div class="member__grid">
      <TextField
        id={`member-${memberKey}-name`}
        memberField="name"
        label="Nome completo"
        autocomplete={purpose('name')}
        maxlength={80}
        wide
      />
      <TextField
        id={`member-${memberKey}-student`}
        memberField="studentId"
        label="Matrícula"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck={false}
        maxlength={20}
      />
      <TextField
        id={`member-${memberKey}-email`}
        memberField="email"
        label="E-mail"
        type="email"
        inputmode="email"
        autocomplete={purpose('email')}
        maxlength={120}
      />
    </div>
  </fieldset>
</li>

<style>
  .member {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--surface-line);
    border-left: 2px solid var(--c-cyan);
    border-radius: 3px;
    background:
      radial-gradient(90% 60% at 0% 0%, color-mix(in srgb, var(--c-cyan) 7%, transparent), transparent 60%),
      var(--surface-well);
    /* entrada do card novo: keyframes no registration-form.css */
    animation: regform-member-in 420ms var(--ease-out);
  }

  /* o contato ganha um fio de energia a mais */
  .member.is-contact {
    border-color: color-mix(in srgb, var(--c-cyan) 30%, transparent);
    border-left-color: var(--c-cyan);
    background:
      radial-gradient(90% 70% at 0% 0%, color-mix(in srgb, var(--c-cyan) 12%, transparent), transparent 62%),
      radial-gradient(
        60% 80% at 100% 0%,
        color-mix(in srgb, var(--c-violet) 9%, transparent),
        transparent 70%
      ),
      var(--surface-well);
  }

  .member__set {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .member__legend {
    float: left;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    width: 100%;
    min-height: 44px;
    padding: 0 6.5rem 0 0;
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .member.is-contact .member__legend {
    padding-right: 0;
  }

  .member__slot {
    width: 8px;
    height: 8px;
    background: var(--c-cyan);
    box-shadow: 0 0 10px var(--c-cyan);
    transform: rotate(45deg);
  }

  .member__title {
    color: var(--text);
    font-weight: 700;
  }

  .member__contact {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--c-cyan) 45%, transparent);
    border-radius: 2px;
    background: color-mix(in srgb, var(--c-cyan) 10%, transparent);
    color: var(--ink-cyan);
    letter-spacing: 0.14em;
  }

  .member__note {
    clear: both;
    margin-top: calc(var(--space-2) * -1);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .member__grid {
    clear: both;
    display: grid;
    gap: var(--space-4);
  }

  /* a matrícula vai em maiúsculas pro servidor: já aparece assim enquanto digita */
  .member__grid :global([data-member-field='studentId']) {
    text-transform: uppercase;
  }

  @media (min-width: 40rem) {
    .member {
      padding: var(--space-4) var(--space-5) var(--space-5);
    }
  }

  @media (min-width: 48rem) {
    .member__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
</style>
