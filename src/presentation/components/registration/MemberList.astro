---
// integrantes da equipe: linhas dinâmicas vindas do <template>, com limite pelo tamanho da equipe
import MemberRow from './MemberRow.astro';

interface Props {
  min: number;
  max: number;
}

const { min, max } = Astro.props;
---

<fieldset class="members" data-mode-only="team" aria-describedby="reg-members-hint reg-members-error">
  <legend class="members__legend">Integrantes</legend>
  <p class="members__hint" id="reg-members-hint">
    Você já conta como 1. A equipe tem de {min} a {max} pessoas.
    <span class="members__count" data-member-count>
      1/{max}
    </span>
  </p>
  <ol role="list" class="members__list" data-members-list></ol>
  <p class="members__error" id="reg-members-error" data-error-for="members" hidden></p>
  <button type="button" class="members__add" data-member-add>
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M8 2v12M2 8h12"></path>
    </svg>
    <span data-member-add-label>Adicionar integrante</span>
  </button>
  <template data-member-template>
    <MemberRow />
  </template>
</fieldset>

<style>
  .members {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .members__legend {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 800;
    text-transform: uppercase;
  }

  .members__hint {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .members__count {
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    color: var(--accent);
  }

  .members__list {
    display: grid;
    gap: var(--space-4);
  }

  .members__error {
    color: var(--c-danger);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .members__add {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 var(--space-5);
    clip-path: var(--clip-btn);
    background: rgb(0 207 255 / 0.08);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--text);
    font-weight: 600;
  }

  .members__add svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .members__add:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--focus);
  }

  .members__add:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
</style>
