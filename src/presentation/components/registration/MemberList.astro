---
// etapa 02: integrantes em cards, entre o mínimo e o máximo da equipe. Os do mínimo já vêm no HTML (a etapa
// tem conteúdo antes do JS e na prévia "em breve"); os extras saem do <template>.
// O integrante 1 é o contato; o aviso do e-mail (canal oficial) entra na descrição do grupo
import FormStep from './FormStep.astro';
import MailNotice from './MailNotice.astro';
import MemberRow from './MemberRow.astro';

interface Props {
  min: number;
  max: number;
}

const { min, max } = Astro.props;
---

<FormStep
  index="02"
  title="Integrantes"
  class="members"
  describedby="reg-members-hint reg-mail-notice reg-members-error"
>
  <p class="members__hint" id="reg-members-hint">
    <span>
      De {min} a {max} pessoas, todas alunas da UniCatólica. Cada uma informa nome completo, matrícula e
      e-mail.
    </span>
    <span class="members__count" aria-hidden="true">
      <span data-member-count>
        {min}/{max}
      </span>
    </span>
  </p>
  <MailNotice id="reg-mail-notice" />
  <ol role="list" class="members__list" data-members-list>
    {Array.from({ length: min }, (_, i) => (
      <MemberRow memberKey={i} />
    ))}
  </ol>
  <p class="members__error" id="reg-members-error" data-error-for="members" hidden></p>
  <button type="button" class="members__add" data-member-add>
    <span class="members__add-icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" focusable="false">
        <path d="M8 2v12M2 8h12"></path>
      </svg>
    </span>
    <span data-member-add-label>Adicionar integrante</span>
  </button>
  <template data-member-template>
    <MemberRow />
  </template>
</FormStep>

<style>
  .members__hint {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  .members__count {
    flex: none;
    padding: 0.2rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--c-cyan) 40%, transparent);
    background: color-mix(in srgb, var(--c-cyan) 8%, transparent);
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
  }

  .members__list {
    display: grid;
    gap: var(--space-4);
  }

  .members__error {
    color: var(--ink-danger);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  /* slot vazio tracejado: "cabe mais um" */
  .members__add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 56px;
    padding: 0 var(--space-3);
    border: 1px dashed color-mix(in srgb, var(--c-cyan) 45%, transparent);
    border-radius: 3px;
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--c-cyan) 4%, transparent) 0 10px,
      transparent 10px 20px
    );
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .members__add:hover:not(:disabled) {
    border-color: var(--c-cyan);
    box-shadow: 0 0 26px color-mix(in srgb, var(--c-cyan) 20%, transparent);
  }

  .members__add-icon {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--c-cyan);
    color: var(--c-cyan);
    transform: rotate(45deg);
  }

  .members__add svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    transform: rotate(-45deg);
  }

  .members__add:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .members__add:disabled {
    cursor: not-allowed;
    border-style: solid;
    border-color: var(--surface-line);
    background: var(--surface-well);
    color: var(--text-muted);
  }

  .members__add:disabled .members__add-icon {
    border-color: var(--surface-line);
    color: var(--text-dim);
  }

  @media (min-width: 480px) {
    .members__add {
      padding-inline: var(--space-5);
      font-size: var(--fs-sm);
      letter-spacing: 0.06em;
    }
  }
</style>
