---
// campo do formulário: label + controle + dica + erro (aria-describedby é ligado pela View)
import type { HTMLAttributes } from 'astro/types';

interface Props {
  id: string;
  label: string;
  // caminho no VM ("leader.email"); linhas de integrante usam memberField
  field?: string;
  memberField?: 'name' | 'email' | 'course';
  as?: 'input' | 'select' | 'textarea';
  type?: 'text' | 'email' | 'tel';
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  inputmode?: HTMLAttributes<'input'>['inputmode'];
  hint?: string;
  optional?: boolean;
  maxlength?: number;
  placeholder?: string;
  options?: string[];
  list?: string;
  wide?: boolean;
}

const {
  id,
  label,
  field,
  memberField,
  as = 'input',
  type = 'text',
  autocomplete,
  inputmode,
  hint,
  optional = false,
  maxlength,
  placeholder,
  options = [],
  list,
  wide = false,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const common = {
  id,
  name: field ?? memberField,
  'data-field': field,
  'data-member-field': memberField,
  'data-describedby-base': hintId,
  'aria-describedby': hintId,
  'aria-required': optional ? undefined : ('true' as const),
  class: 'field__control',
};
---

<div class:list={['field', { 'field--wide': wide }]}>
  <label class="field__label" for={id}>
    {label}
    {optional && <span class="field__optional">(opcional)</span>}
  </label>
  {hint && (
    <p class="field__hint" id={hintId}>
      {hint}
    </p>
  )}
  {as === 'select' ? (
    <select {...common}>
      <option value="">Selecione</option>
      {options.map((o) => (
        <option value={o}>{o}</option>
      ))}
    </select>
  ) : as === 'textarea' ? (
    <textarea {...common} rows={3} maxlength={maxlength} placeholder={placeholder} />
  ) : (
    <input
      {...common}
      type={type}
      autocomplete={autocomplete}
      inputmode={inputmode}
      maxlength={maxlength}
      placeholder={placeholder}
      list={list}
      spellcheck={type === 'text' ? undefined : 'false'}
    />
  )}
  <p
    class="field__error"
    id={`${id}-error`}
    data-error-for={field}
    data-member-error={memberField}
    hidden
  ></p>
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .field__label {
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .field__optional {
    margin-left: var(--space-1);
    font-weight: 400;
    color: var(--text-dim);
  }

  .field__hint {
    color: var(--text-dim);
    font-size: var(--fs-xs);
  }

  .field__control {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-strong);
    border: 0;
    box-shadow: inset 0 0 0 1px var(--surface-line);
    clip-path: var(--clip-btn);
    /* 16px+ evita o zoom automático do iOS */
    font-size: max(16px, var(--fs-base));
    transition: box-shadow var(--dur-fast) var(--ease-out);
  }

  textarea.field__control {
    min-height: 6rem;
    resize: vertical;
  }

  .field__control::placeholder {
    color: var(--text-dim);
    opacity: 1;
  }

  .field__control:hover {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  /* clip-path corta outline: o foco vira borda interna âmbar */
  .field__control:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--focus);
  }

  .field__control[aria-invalid='true'] {
    box-shadow: inset 0 0 0 2px var(--c-danger);
  }

  .field__control:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .field__error {
    color: var(--c-danger);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .field__error::before {
    content: '! ';
  }

  @media (min-width: 48rem) {
    .field--wide {
      grid-column: 1 / -1;
    }
  }
</style>
