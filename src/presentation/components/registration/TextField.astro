---
// campo do formulário: label + controle + dica + erro (aria-describedby é ligado pela View).
// suggestions vira um datalist: sugere sem prender a pessoa à lista
import type { HTMLAttributes } from 'astro/types';
import FieldError from './FieldError.astro';

interface Props {
  id: string;
  label: string;
  // caminho no VM ("name", "whatsapp")
  field: string;
  type?: 'text' | 'email' | 'tel';
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  inputmode?: HTMLAttributes<'input'>['inputmode'];
  autocapitalize?: HTMLAttributes<'input'>['autocapitalize'];
  spellcheck?: boolean;
  hint?: string;
  optional?: boolean;
  maxlength?: number;
  placeholder?: string;
  wide?: boolean;
  suggestions?: readonly string[];
}

const {
  id,
  label,
  field,
  type = 'text',
  autocomplete,
  inputmode,
  autocapitalize,
  spellcheck = type === 'text' ? undefined : false,
  hint,
  optional = false,
  maxlength,
  placeholder,
  wide = false,
  suggestions = [],
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const listId = suggestions.length ? `${id}-options` : undefined;
---

<div class:list={['field', { 'field--wide': wide }]}>
  <label class="field__label" for={id}>
    {label}
    {optional && <span class="field__optional">(opcional)</span>}
  </label>
  {hint && (
    <p class="field__hint" id={hintId}>
      {hint}
    </p>
  )}
  <div class="field__box">
    <input
      id={id}
      class="field__control"
      name={field}
      data-field={field}
      list={listId}
      data-describedby-base={hintId}
      aria-describedby={hintId}
      aria-required={optional ? undefined : 'true'}
      type={type}
      autocomplete={autocomplete}
      inputmode={inputmode}
      autocapitalize={autocapitalize}
      maxlength={maxlength}
      placeholder={placeholder}
      spellcheck={spellcheck === undefined ? undefined : spellcheck ? 'true' : 'false'}
    />
    {listId && (
      <datalist id={listId}>
        {suggestions.map((option) => (
          <option value={option} />
        ))}
      </datalist>
    )}
  </div>
  <FieldError id={`${id}-error`} field={field} />
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .field__label {
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .field__optional {
    margin-left: var(--space-1);
    color: var(--text-dim);
    font-weight: 400;
  }

  .field__hint {
    color: var(--text-dim);
    font-size: var(--fs-xs);
  }

  .field__box {
    position: relative;
  }

  .field__control {
    width: 100%;
    min-height: 52px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--control-line);
    border-radius: 3px;
    background: var(--control-bg);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--c-ice) 3%, transparent);
    /* 16px+ evita o zoom automático do iOS */
    font-size: max(16px, var(--fs-base));
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .field__control::placeholder {
    color: var(--text-dim);
    opacity: 1;
  }

  .field__control:hover {
    border-color: color-mix(in srgb, var(--c-cyan) 45%, transparent);
  }

  /* foco com brilho: anel ciano de 2px + halo. Contorno transparente (e não none) volta no alto contraste,
     que zera o box-shadow */
  .field__control:focus-visible {
    outline: 2px solid transparent;
    border-color: var(--c-cyan);
    background: var(--control-bg-focus);
    box-shadow:
      0 0 0 1px var(--c-cyan),
      0 0 0 5px color-mix(in srgb, var(--c-cyan) 14%, transparent),
      0 0 30px color-mix(in srgb, var(--c-cyan) 22%, transparent);
  }

  .field__control[aria-invalid='true'] {
    border-color: var(--c-danger);
    box-shadow:
      0 0 0 1px var(--c-danger),
      0 0 24px color-mix(in srgb, var(--c-danger) 18%, transparent);
  }

  /* com erro e em foco: halo mais largo, pra o foco nunca sumir */
  .field__control[aria-invalid='true']:focus-visible {
    box-shadow:
      0 0 0 1px var(--c-danger),
      0 0 0 5px color-mix(in srgb, var(--c-danger) 20%, transparent),
      0 0 30px color-mix(in srgb, var(--c-danger) 25%, transparent);
  }

  .field__control:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  @media (min-width: 48rem) {
    .field--wide {
      grid-column: 1 / -1;
    }
  }
</style>
