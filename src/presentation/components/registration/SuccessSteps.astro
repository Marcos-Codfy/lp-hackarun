---
// próximos passos da tela de sucesso (RegistrationSuccess), numerados em HUD
interface Props {
  // "12/11, às 19h15"; null = horário ainda não publicado
  drawAt: string | null;
  variant?: 'participant' | 'mentor';
}

const { drawAt, variant = 'participant' } = Astro.props;
const mentorSteps = [
  'Guarde o protocolo: é ele que identifica o seu cadastro.',
  'A organização confere o cadastro e fala com você por e-mail.',
  'Nos dias que você marcou, a participação é presencial.',
  `A apresentação das equipes e dos mentores acontece${drawAt ? `, em ${drawAt}` : ''}, na UniCatólica.`,
];
const participantSteps = [
  'Guarde o protocolo: é ele que identifica a sua inscrição.',
  `Vá ao sorteio das equipes${drawAt ? `, em ${drawAt}` : ''}, na UniCatólica, Bloco II. Só participa quem estiver presente e credenciado.`,
  'No sorteio, as equipes são formadas com 4 pessoas (até 5) e cada uma escolhe um representante.',
  'Confira a programação no site para não perder nenhuma etapa.',
];
const steps = variant === 'mentor' ? mentorSteps : participantSteps;
---

<ol class="success__steps" role="list">
  {steps.map((step, i) => (
    <li>
      <span class="success__step-num" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      <span>{step}</span>
    </li>
  ))}
</ol>

<style>
  .success__steps {
    display: grid;
    gap: var(--space-3);
  }

  .success__steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: baseline;
    color: var(--text-muted);
  }

  .success__step-num {
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
</style>
