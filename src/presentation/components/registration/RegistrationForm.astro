---
// formulário da página /inscricao (RegistrationFormView + RegistrationFormViewModel); grava na planilha via
// Apps Script. Inscrição individual, num envio só: 01 Seus dados, 02 Perfil (os campos de estudo ou de área
// aparecem conforme a resposta), 03 Confirmação. As equipes saem do sorteio presencial
import type { RegistrationDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import FormStep from './FormStep.astro';
import ContactStep from './ContactStep.astro';
import ProfileStep from './ProfileStep.astro';
import ConsentField from './ConsentField.astro';
import { formStatus } from './formStatus';
import RegistrationNotice from './RegistrationNotice.astro';
import RegistrationSuccess from './RegistrationSuccess.astro';
import PreviewBanner from './PreviewBanner.astro';
// css global com prefixo .regform
import './registration-form.css';
import './registration-states.css';

interface Props {
  registration: RegistrationDTO;
  // "12/11, às 19h15" (lido da programação); null = horário ainda não publicado
  drawAt: string | null;
}

const { registration, drawAt } = Astro.props;
// dev ou prévia sem planilha: libera o formulário com o gateway em memória (nada é gravado) e mostra o aviso
const { status, simulated, isOpen } = formStatus(registration);
---

<div
  class="regform"
  data-registration-form
  data-status={status}
  data-simulated={simulated ? 'true' : undefined}
>
  {simulated && <PreviewBanner />}
  <RegistrationNotice status={status} />
  {isOpen && (
    <div data-reg-closed hidden>
      <RegistrationNotice status="closed" />
    </div>
  )}
  {status !== 'closed' && (
    <div class="regform__panel" data-reg-panel>
      <noscript>
        <p class="regform__noscript">
          A inscrição precisa de JavaScript. Ative no navegador e recarregue a página.
        </p>
        <style is:inline>
          .regform [data-reg-form] {
            display: none;
          }
        </style>
      </noscript>
      {/* post: se o JS falhar, nada pessoal vai parar na URL (o host estático só responde 405) */}
      <form
        class="regform__form"
        data-reg-form
        method="post"
        action="/inscricao"
        novalidate
        inert={!isOpen}
        aria-label="Inscrição no HackaRun"
      >
        <fieldset class="regform__fields" disabled={!isOpen}>
          {/* recebe o foco quando o envio volta com mais de um erro (os links levam a cada campo) */}
          <div
            class="regform__summary"
            data-error-summary
            role="group"
            aria-labelledby="reg-error-summary-title"
            tabindex="-1"
            hidden
          >
            <p class="regform__summary-title" id="reg-error-summary-title" data-error-summary-title></p>
            <ul class="regform__summary-list" data-error-summary-list></ul>
          </div>

          <ContactStep drawAt={drawAt} />
          <ProfileStep />

          <FormStep index="03" title="Confirmação">
            <div class="regform__notice" role="note">
              <Icon name="users" size={18} />
              <p>
                A inscrição não garante vaga. As equipes são formadas no sorteio
                {drawAt ? `, em ${drawAt}` : ''}, na UniCatólica, só com quem estiver presente.
              </p>
            </div>
            <ConsentField />
            <div class="regform__hp" aria-hidden="true">
              <label for="reg-website">Website</label>
              <input
                id="reg-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
                data-field="honeypot"
              />
            </div>
            <div class="regform__failure" data-reg-failure role="alert" hidden>
              <p data-reg-failure-text></p>
              <button type="button" class="regform__retry" data-reg-retry>
                Tentar de novo
              </button>
            </div>
            <div class="regform__actions">
              <Button type="submit" size="lg" data-reg-submit>
                Confirmar inscrição
              </Button>
              <p class="regform__privacy">Os dados ficam só com a organização do HackaRun.</p>
            </div>
          </FormStep>
        </fieldset>
      </form>
      <RegistrationSuccess drawAt={drawAt}>{simulated && <PreviewBanner compact />}</RegistrationSuccess>
      <p class="sr-only" aria-live="polite" data-reg-live></p>
    </div>
  )}
</div>
