---
// lobby de inscrição (RegistrationFormView + RegistrationFormViewModel); grava na planilha via Apps Script.
// Só equipe: 01 Equipe (nome + foto), 02 Integrantes (nome, matrícula e e-mail), 03 Confirmação
import type { RegistrationDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import TextField from './TextField.astro';
import FormStep from './FormStep.astro';
import MemberList from './MemberList.astro';
import ConsentField from './ConsentField.astro';
import TeamImageField from './TeamImageField.astro';
import RegistrationNotice from './RegistrationNotice.astro';
import RegistrationSuccess from './RegistrationSuccess.astro';
// css global com prefixo .regform (os cards de integrante são clonados em runtime)
import './registration-form.css';
import './registration-states.css';

interface Props {
  registration: RegistrationDTO;
}

const { registration } = Astro.props;
const { min, max } = registration.teamSize;
// dev sem planilha: libera o formulário com o gateway em memória pra testar a UX
const simulated = import.meta.env.DEV && registration.status === 'soon' && !registration.endpoint;
const status = simulated ? 'open' : registration.status;
const isOpen = status === 'open' || status === 'closing';
---

<div class="regform" data-registration-form data-status={status} data-team-min={min} data-team-max={max}>
  <RegistrationNotice status={status} simulated={simulated} />
  {isOpen && (
    <div data-reg-closed hidden>
      <RegistrationNotice status="closed" simulated={false} />
    </div>
  )}
  {status !== 'closed' && (
    <div class="regform__panel" data-reg-panel>
      <div class="regform__squad" aria-hidden="true">
        <span class="regform__squad-live">
          Lobby online<span class="regform__squad-extra"> · formação</span>
        </span>
        <span data-reg-squad>
          Esquadrão {min}/{max}
        </span>
      </div>
      <noscript>
        <p class="regform__noscript">
          A inscrição precisa de JavaScript. Ative no navegador e recarregue a página.
        </p>
        <style is:inline>
          .regform [data-reg-form] {
            display: none;
          }
        </style>
      </noscript>
      {/* post: se o JS falhar, nada pessoal vai parar na URL (o host estático só responde 405) */}
      <form
        class="regform__form"
        data-reg-form
        method="post"
        action="#inscricao"
        novalidate
        inert={!isOpen}
        aria-label="Inscrição da equipe no HackaRun"
      >
        <fieldset class="regform__fields" disabled={!isOpen}>
          {/* recebe o foco quando o envio volta com mais de um erro (os links levam a cada campo) */}
          <div
            class="regform__summary"
            data-error-summary
            role="group"
            aria-labelledby="reg-error-summary-title"
            tabindex="-1"
            hidden
          >
            <p class="regform__summary-title" id="reg-error-summary-title" data-error-summary-title></p>
            <ul class="regform__summary-list" data-error-summary-list></ul>
          </div>
          <FormStep
            index="01"
            title="Equipe"
            lead="O nome e a imagem aparecem na página de equipes depois que a organização confirma."
          >
            <TextField
              id="reg-team-name"
              field="teamName"
              label="Nome da equipe"
              hint="De 2 a 40 caracteres. Cada equipe tem um nome só dela."
              maxlength={40}
              autocomplete="off"
            />
            <TeamImageField />
          </FormStep>
          <MemberList min={min} max={max} />
          <FormStep index="03" title="Confirmação">
            <ConsentField />
            <div class="regform__hp" aria-hidden="true">
              <label for="reg-website">Website</label>
              <input
                id="reg-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
                data-field="honeypot"
              />
            </div>
            <div class="regform__failure" data-reg-failure role="alert" hidden>
              <p data-reg-failure-text></p>
              <button type="button" class="regform__retry" data-reg-retry>
                Tentar de novo
              </button>
            </div>
            <div class="regform__actions">
              <Button type="submit" size="lg" data-reg-submit>
                Confirmar inscrição
              </Button>
              <p class="regform__privacy">
                Os dados ficam só com a organização. No site aparecem só o nome, a foto e o número de
                integrantes da equipe.
              </p>
            </div>
          </FormStep>
        </fieldset>
      </form>
      <RegistrationSuccess />
      <p class="sr-only" aria-live="polite" data-reg-live></p>
    </div>
  )}
</div>
