---
// modalidade em controle segmentado: radio group nativo (setas funcionam sozinhas), indicador desliza por CSS
interface Props {
  min: number;
  max: number;
}

const { min, max } = Astro.props;
const options = [
  { value: 'team', title: 'Tenho equipe', text: `Equipe completa, de ${min} a ${max} pessoas` },
  { value: 'solo', title: 'Quero uma equipe', text: 'Inscrição individual, sem equipe ainda' },
];
---

<fieldset class="mode">
  <legend class="mode__legend">Modalidade</legend>
  <div class="mode__track">
    <span class="mode__thumb" aria-hidden="true"></span>
    {options.map((o, i) => (
      <label class="mode__option">
        <input class="mode__input" type="radio" name="mode" value={o.value} checked={i === 0} data-reg-mode />
        <span class="mode__title">{o.title}</span>
        <span class="mode__text">{o.text}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .mode {
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .mode__legend {
    margin-bottom: var(--space-3);
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .mode__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 4px;
    border: 1px solid var(--control-line);
    border-radius: 4px;
    background: var(--surface-strong);
  }

  /* destaque que desliza até a opção marcada */
  .mode__thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 4px);
    /* borda transparente: no alto contraste o fundo e o brilho somem, ela não */
    border: 1px solid transparent;
    border-radius: 3px;
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--c-cyan) 22%, transparent),
        color-mix(in srgb, var(--c-electric) 18%, transparent) 60%,
        color-mix(in srgb, var(--c-violet) 18%, transparent)
      ),
      var(--surface-solid);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--c-cyan) 65%, transparent),
      0 0 26px color-mix(in srgb, var(--c-cyan) 25%, transparent);
    transition: translate var(--dur) var(--ease-out);
  }

  .mode__track:has(.mode__option:nth-of-type(2) :checked) .mode__thumb {
    translate: 100% 0;
  }

  .mode__option {
    position: relative;
    display: grid;
    align-content: center;
    gap: var(--space-1);
    min-height: 4.5rem;
    padding: var(--space-3) var(--space-4);
    border-radius: 3px;
    cursor: pointer;
    text-align: center;
  }

  /* o radio de verdade fica por cima, invisível: mantém teclado e leitor de tela */
  .mode__input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .mode__title {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .mode__text {
    color: var(--text-dim);
    font-size: var(--fs-xs);
    line-height: 1.35;
  }

  .mode__option:has(:checked) .mode__title {
    color: var(--text);
  }

  .mode__option:has(:checked) .mode__text {
    color: var(--text-muted);
  }

  .mode__option:hover .mode__title {
    color: var(--text);
  }

  .mode__option:has(:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  @media (min-width: 40rem) {
    .mode__option {
      min-height: 5rem;
      padding-inline: var(--space-5);
    }

    .mode__title {
      font-size: var(--fs-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mode__thumb {
      transition: none;
    }
  }
</style>
