---
// foto ou logo da equipe (TeamImagePicker + RegistrationFormViewModel). O input nativo é o controle:
// cobre a área vazia (clique e teclado abrem o seletor), o erro e o resumo apontam pra ele.
// Com a imagem pronta ele sai do Tab e o "Trocar imagem" assume
import FieldError from './FieldError.astro';
import TeamImagePreview from './TeamImagePreview.astro';

const id = 'reg-team-image';
const hintId = `${id}-hint`;
---

<div class="timg" data-team-image data-status="empty">
  <label class="timg__label" for={id}>
    Foto ou logo da equipe
  </label>
  <p class="timg__hint" id={hintId}>
    JPG, PNG ou WebP até 10 MB, com pelo menos 200 px no lado menor. A gente ajusta o tamanho aqui mesmo, e
    ela aparece na página de equipes depois da confirmação.
  </p>
  <div class="timg__zone" data-team-image-zone aria-busy="false">
    <input
      id={id}
      class="timg__input"
      type="file"
      name="teamImage"
      accept="image/jpeg,image/png,image/webp"
      data-field="teamImage"
      data-describedby-base={hintId}
      aria-describedby={hintId}
      aria-required="true"
    />
    <div class="timg__empty" data-team-image-empty aria-hidden="true">
      <span class="timg__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 5h16v14H4zM4 15.5l4.5-4.5 4 4 2.5-2.5 5 5M15.5 9.5h.01"></path>
        </svg>
      </span>
      <span class="timg__cta">Escolher foto ou logo</span>
      <span class="timg__drag">ou arraste o arquivo pra cá</span>
      <span class="timg__formats">JPG · PNG · WebP</span>
    </div>
    <TeamImagePreview />
    <span class="timg__busy" aria-hidden="true">
      Preparando a imagem
    </span>
  </div>
  <p class="sr-only" aria-live="polite" data-team-image-status></p>
  <FieldError id={`${id}-error`} field="teamImage" />
</div>

<style>
  .timg {
    display: grid;
    gap: var(--space-2);
  }

  .timg__label {
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .timg__hint {
    color: var(--text-dim);
    font-size: var(--fs-xs);
  }

  .timg__zone {
    position: relative;
    display: grid;
    min-height: 10rem;
    margin-top: var(--space-1);
    border: 1px dashed color-mix(in srgb, var(--c-cyan) 45%, transparent);
    border-radius: 3px;
    background:
      radial-gradient(70% 90% at 50% 0%, color-mix(in srgb, var(--c-cyan) 9%, transparent), transparent 70%),
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--c-cyan) 4%, transparent) 0 10px,
        transparent 10px 20px
      ),
      var(--surface-well);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  /* o input invisível cobre a área vazia: clique, toque e teclado abrem o seletor nativo */
  .timg__input {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .timg[data-status='ready'] .timg__input {
    inset: auto;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .timg__zone:hover,
  .timg__zone.is-dragover {
    border-color: var(--c-cyan);
    box-shadow: 0 0 30px color-mix(in srgb, var(--c-cyan) 22%, transparent);
  }

  .timg__zone.is-dragover {
    border-style: solid;
  }

  .timg__zone:has(.timg__input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .timg__zone:has(.timg__input[aria-invalid='true']) {
    border-color: var(--c-danger);
    box-shadow: 0 0 24px color-mix(in srgb, var(--c-danger) 18%, transparent);
  }

  .timg__empty {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    text-align: center;
  }

  .timg__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-1);
    border: 1px solid var(--c-cyan);
    color: var(--c-cyan);
    box-shadow: inset 0 0 16px color-mix(in srgb, var(--c-cyan) 22%, transparent);
    transform: rotate(45deg);
  }

  .timg__icon svg {
    width: 1.25rem;
    height: 1.25rem;
    transform: rotate(-45deg);
  }

  .timg__cta {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .timg__drag {
    display: none;
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .timg__formats {
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
  }

  /* preparando: véu com spinner por cima do que estiver na área (vazia ou a prévia antiga) */
  .timg__busy {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: none;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    background: rgb(2 3 11 / 0.72);
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .timg__busy::before {
    content: '';
    width: 1.6rem;
    height: 1.6rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: regform-spin 0.8s linear infinite;
  }

  .timg[data-status='processing'] .timg__busy {
    display: grid;
    cursor: progress;
  }

  /* arrastar só faz sentido com mouse */
  @media (hover: hover) and (pointer: fine) {
    .timg__drag {
      display: block;
    }
  }
</style>
