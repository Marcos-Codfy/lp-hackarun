---
// avisos de estado da inscrição: em breve, últimas horas e encerrada (o da prévia simulada é o PreviewBanner)
import type { RegistrationStatus } from '@domain/index';
import Button from '@presentation/components/ui/Button.astro';

interface Props {
  status: RegistrationStatus;
  // nível do título no contexto: em /inscricao o aviso vem logo abaixo do h1 da página (h2)
  level?: 'h2' | 'h3';
  // mentor: o cadastro de /seja-mentor usa o mesmo aviso, com os textos dele
  audience?: 'participant' | 'mentor';
}

const { status, level = 'h2', audience = 'participant' } = Astro.props;
const Heading = level;
const mentor = audience === 'mentor';
---

{status === 'closing' && (
  <p class="notice-badge" data-reg-closing-badge>
    <span class="notice-badge__dot" aria-hidden="true" />
    Últimas horas · as inscrições estão quase fechando
  </p>
)}

{(status === 'soon' || status === 'closed') && (
  <div class="notice" data-reg-notice>
    <p class="notice__code" aria-hidden="true">
      // {status === 'soon' ? 'lobby em preparação' : 'lobby fechado'}
    </p>
    <Heading class="notice__title" tabindex="-1" data-reg-notice-title>
      {status === 'soon'
        ? mentor
          ? 'O cadastro de mentores abre em breve'
          : 'As inscrições abrem em breve'
        : mentor
          ? 'Cadastro de mentores encerrado'
          : 'Inscrições encerradas'}
    </Heading>
    {status === 'soon' ? (
      <p class="notice__text">
        Enquanto isso, confira a <a href="/#programacao">programação</a>
        {mentor ? (
          '.'
        ) : (
          <>
            {' '}
            e o{' '}
            <a href="/regulamento-hackarun-2026.pdf" download>
              regulamento (PDF)
            </a>
            .
          </>
        )}
      </p>
    ) : (
      <>
        <p class="notice__text">
          {mentor
            ? 'O cadastro de mentores foi encerrado. Obrigado pelo interesse em ajudar as equipes!'
            : 'O prazo terminou ou as vagas acabaram. Obrigado pelo interesse!'}
        </p>
        <Button href="/#programacao" variant="ghost">
          Ver a programação
        </Button>
      </>
    )}
  </div>
)}

<style>
  .notice-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    padding: var(--space-2) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--c-orange) 55%, transparent);
    border-radius: 2px;
    background: color-mix(in srgb, var(--c-orange) 12%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--c-orange) 25%, transparent);
    color: var(--ink-orange);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .notice-badge__dot {
    width: 7px;
    height: 7px;
    background: var(--c-orange);
    box-shadow: var(--glow-orange);
    animation: notice-pulse 1.4s var(--ease-in-out) infinite;
  }

  .notice {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--c-orange) 30%, transparent);
    border-left: 2px solid var(--c-orange);
    border-radius: 3px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c-orange) 10%, transparent), transparent 80%);
  }

  .notice__code {
    color: var(--ink-orange);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  /* o visual é o mesmo em qualquer nível (o de h3 do base.css): só a semântica muda */
  .notice__title {
    font-size: var(--fs-2xl);
    font-weight: 700;
    line-height: var(--lh-snug);
    letter-spacing: 0.04em;
  }

  /* foco programático: transparente (e não none) pra reaparecer no alto contraste */
  .notice__title:focus {
    outline: 2px solid transparent;
  }

  .notice__text {
    color: var(--text-muted);
  }

  /* mesmo tom de link da tela de sucesso */
  .notice__text a {
    color: var(--ink-cyan);
  }

  /* celular: o botão (só no "encerradas") ocupa a largura do aviso, com a fonte um pouco menor abaixo de 24rem */
  .notice :global(.btn) {
    --btn-px: 1rem;
    --btn-fs: 0.8125rem;
    justify-self: stretch;
  }

  @media (min-width: 24rem) {
    .notice :global(.btn) {
      --btn-fs: 0.875rem;
    }
  }

  @media (min-width: 40rem) {
    .notice {
      padding: var(--space-5);
    }

    .notice :global(.btn) {
      --btn-px: 1.6rem;
      justify-self: start;
    }
  }

  @keyframes notice-pulse {
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-badge__dot {
      animation: none;
    }
  }
</style>
