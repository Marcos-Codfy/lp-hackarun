---
// avisos de estado da inscrição: em breve, últimas horas, encerrada e modo dev
import type { RegistrationStatus } from '@domain/index';
import Button from '@presentation/components/ui/Button.astro';

interface Props {
  status: RegistrationStatus;
  simulated: boolean;
  // nível do título no contexto: em /inscricao o aviso vem logo abaixo do h1 da página (h2)
  level?: 'h2' | 'h3';
}

const { status, simulated, level = 'h2' } = Astro.props;
const Heading = level;
---

{status === 'closing' && (
  <p class="notice-badge" data-reg-closing-badge>
    <span class="notice-badge__dot" aria-hidden="true" />
    Últimas horas · as inscrições estão quase fechando
  </p>
)}

{(status === 'soon' || status === 'closed') && (
  <div class="notice" data-reg-notice>
    <p class="notice__code" aria-hidden="true">
      // {status === 'soon' ? 'lobby em preparação' : 'lobby fechado'}
    </p>
    <Heading class="notice__title" tabindex="-1" data-reg-notice-title>
      {status === 'soon' ? 'As inscrições abrem em breve' : 'Inscrições encerradas'}
    </Heading>
    {status === 'soon' ? (
      <>
        <p class="notice__text">Enquanto isso, salve as datas e já chama a sua equipe.</p>
        <Button href="/hackarun-2026.ics" variant="time" download="hackarun-2026.ics">
          Adicionar à agenda
        </Button>
      </>
    ) : (
      <>
        <p class="notice__text">Valeu pelo interesse! Acompanhe quem vai correr.</p>
        <Button href="/equipes" variant="ghost">
          Ver equipes confirmadas
        </Button>
      </>
    )}
  </div>
)}

{simulated && (
  <p class="notice-dev">
    <span aria-hidden="true">DEV</span>
    Sem planilha configurada: os envios são simulados.
  </p>
)}

<style>
  .notice-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    padding: var(--space-2) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--c-orange) 55%, transparent);
    border-radius: 2px;
    background: color-mix(in srgb, var(--c-orange) 12%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--c-orange) 25%, transparent);
    color: var(--ink-orange);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .notice-badge__dot {
    width: 7px;
    height: 7px;
    background: var(--c-orange);
    box-shadow: var(--glow-orange);
    animation: notice-pulse 1.4s var(--ease-in-out) infinite;
  }

  .notice {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--c-orange) 30%, transparent);
    border-left: 2px solid var(--c-orange);
    border-radius: 3px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c-orange) 10%, transparent), transparent 80%);
  }

  .notice__code {
    color: var(--ink-orange);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  /* o visual é o mesmo em qualquer nível (o de h3 do base.css): só a semântica muda */
  .notice__title {
    font-size: var(--fs-2xl);
    font-weight: 700;
    line-height: var(--lh-snug);
    letter-spacing: 0.04em;
  }

  /* foco programático: transparente (e não none) pra reaparecer no alto contraste */
  .notice__title:focus {
    outline: 2px solid transparent;
  }

  .notice__text {
    color: var(--text-muted);
  }

  /* celular: o botão ocupa a largura do aviso e o rótulo fica numa linha só (abaixo de 24rem sem as setas
     ">>" e com a fonte um pouco menor: "Adicionar à agenda" não cabe junto com elas em 360px) */
  .notice :global(.btn) {
    --btn-px: 1rem;
    --btn-fs: 0.8125rem;
    justify-self: stretch;
  }

  .notice :global(.btn .chevrons) {
    display: none;
  }

  @media (min-width: 24rem) {
    .notice :global(.btn) {
      --btn-fs: 0.875rem;
    }

    .notice :global(.btn .chevrons) {
      display: inline-flex;
    }
  }

  @media (min-width: 40rem) {
    .notice {
      padding: var(--space-5);
    }

    .notice :global(.btn) {
      --btn-px: 1.6rem;
      justify-self: start;
    }
  }

  .notice-dev {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .notice-dev span {
    padding: 0.1rem 0.45rem;
    background: var(--c-orange);
    color: var(--c-void);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @keyframes notice-pulse {
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-badge__dot {
      animation: none;
    }
  }
</style>
