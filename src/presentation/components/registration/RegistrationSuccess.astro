---
// tela de sucesso: emblema + protocolo "decodificando" + canal oficial (e-mail) + lembrete da autorização (só
// pra menor de idade) + próximos passos. A View preenche o protocolo e o e-mail e foca o título. O slot fica logo
// abaixo do título: é onde entra o aviso da prévia simulada (PreviewBanner)
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { EVENT_RETURN_HREF } from '@presentation/components/layout/navLinks';
import MailNotice from './MailNotice.astro';
import SuccessSteps from './SuccessSteps.astro';

interface Props {
  drawAt: string | null;
}

const { drawAt } = Astro.props;
---

<div class="success" data-reg-success hidden>
  <div class="success__emblem" aria-hidden="true">
    <svg viewBox="0 0 48 48" width="100%" height="100%" fill="none">
      <path d="M24 3 42 13.5v21L24 45 6 34.5v-21Z" stroke="currentColor" stroke-width="1.5"></path>
      <path d="m15.5 24.5 6 6 11-12.5" stroke="currentColor" stroke-width="3" stroke-linecap="square"></path>
    </svg>
  </div>
  <p class="success__code" aria-hidden="true">
    // inscrição recebida · checkpoint liberado
  </p>
  <h2 class="success__title" tabindex="-1" data-reg-success-title>
    Inscrição recebida! Nos vemos no sorteio.
  </h2>
  <slot />
  <div class="success__ticket">
    <p class="success__label">Protocolo da inscrição</p>
    <p class="success__protocol">
      <span class="sr-only" data-reg-protocol></span>
      <span aria-hidden="true" data-reg-protocol-typed></span>
    </p>
  </div>
  <MailNotice compact>
    Os avisos do HackaRun chegam por e-mail em{' '}
    <strong class="success__mail" data-reg-contact-email>
      o seu e-mail
    </strong>{' '}
    e, se for preciso, pelo WhatsApp informado. Confira também a caixa de spam.
  </MailNotice>
  <p class="success__guardian" data-reg-guardian hidden>
    <Icon name="shield" size={18} />
    <span>
      Como você tem menos de 18 anos, leve a autorização assinada pelo responsável no credenciamento
      {drawAt ? `, em ${drawAt}` : ''}. <a href="/autorizacao">Abrir o modelo de autorização</a>.
    </span>
  </p>
  <SuccessSteps drawAt={drawAt} />
  <div class="success__actions">
    <Button href="/#programacao" variant="ghost">
      Ver a programação
    </Button>
  </div>
  <a class="success__back" href={EVENT_RETURN_HREF} data-back-to-event>
    <Icon name="arrow-left" size={16} />
    Voltar ao evento
  </a>
</div>

<style>
  .success {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    animation: success-in 700ms var(--ease-out);
  }

  .success__emblem {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    color: var(--c-success);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--c-success) 60%, transparent));
  }

  /* rótulos de HUD do selo e do ticket */
  .success__code,
  .success__label {
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .success__code {
    color: var(--c-success);
  }

  /* h2 logo abaixo do h1 da página (a lateral com o outro h2 some no sucesso), com o visual de h3 do base.css */
  .success__title {
    font-size: var(--fs-2xl);
    font-weight: 700;
    line-height: var(--lh-snug);
    letter-spacing: 0.04em;
  }

  /* foco programático: transparente (e não none) pra reaparecer no alto contraste */
  .success__title:focus {
    outline: 2px solid transparent;
  }

  /* protocolo num "ticket" com recortes laterais */
  .success__ticket {
    position: relative;
    display: grid;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-5) var(--space-6);
    border: 1px solid color-mix(in srgb, var(--c-success) 45%, transparent);
    border-radius: 4px;
    background:
      radial-gradient(
        80% 120% at 0% 0%,
        color-mix(in srgb, var(--c-success) 12%, transparent),
        transparent 60%
      ),
      var(--surface-strong);
    box-shadow: 0 0 40px -10px color-mix(in srgb, var(--c-success) 35%, transparent);
    -webkit-mask:
      radial-gradient(circle 12px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 12px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle 12px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 12px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
  }

  .success__label {
    color: var(--text-muted);
  }

  .success__protocol {
    min-height: 1.3em;
    color: var(--c-success);
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 1rem + 1.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-shadow: 0 0 18px color-mix(in srgb, var(--c-success) 55%, transparent);
    user-select: all;
  }

  /* lembrete da autorização do responsável: só pra menor de idade */
  .success__guardian {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--c-gold) 45%, transparent);
    border-left: 2px solid var(--c-gold);
    border-radius: 3px;
    background: color-mix(in srgb, var(--c-gold) 8%, transparent);
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  .success__guardian[hidden] {
    display: none;
  }

  .success__guardian a,
  .success__back {
    color: var(--ink-cyan);
  }

  .success__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .success__back:hover {
    color: var(--text);
  }

  .success__mail {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .success__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @keyframes success-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .success {
      animation: none;
    }
  }
</style>
