---
// tela de sucesso: emblema + protocolo "decodificando" + onde a equipe aparece + canal oficial (e-mail) +
// próximos passos. A View preenche o protocolo e o e-mail do contato e foca o título
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { EVENT_RETURN_HREF } from '@presentation/components/layout/navLinks';
import MailNotice from './MailNotice.astro';

const steps = [
  'Guarde o protocolo: é ele que identifica a inscrição da equipe.',
  'A organização confere os dados e a foto e confirma a equipe por e-mail.',
  'Confirmada, a equipe aparece com a foto ou a logo na página de equipes do site.',
  'Salve as datas na agenda pra não perder a largada.',
];
---

<div class="success" data-reg-success hidden>
  <div class="success__emblem" aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none">
      <path d="M24 3 42 13.5v21L24 45 6 34.5v-21Z" stroke="currentColor" stroke-width="1.5"></path>
      <path d="m15.5 24.5 6 6 11-12.5" stroke="currentColor" stroke-width="3" stroke-linecap="square"></path>
    </svg>
  </div>
  <p class="success__code" aria-hidden="true">
    // inscrição recebida · checkpoint liberado
  </p>
  <h3 class="success__title" tabindex="-1" data-reg-success-title>
    Tá dentro! Agora é com a organização.
  </h3>
  <div class="success__ticket">
    <p class="success__label">Protocolo da equipe</p>
    <p class="success__protocol">
      <span class="sr-only" data-reg-protocol></span>
      <span aria-hidden="true" data-reg-protocol-typed></span>
    </p>
  </div>
  <p class="success__teams">
    Sua equipe aparece em <a href="/equipes">Equipes</a> depois da confirmação.
  </p>
  <MailNotice compact>
    A confirmação e todos os avisos do HackaRun chegam por e-mail em{' '}
    <strong class="success__mail" data-reg-contact-email>
      o e-mail do contato
    </strong>
    {'. '}Não usamos WhatsApp: fique de olho na caixa de entrada (e no spam).
  </MailNotice>
  <ol class="success__steps" role="list">
    {steps.map((step, i) => (
      <li>
        <span class="success__step-num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span>{step}</span>
      </li>
    ))}
  </ol>
  <div class="success__actions">
    <Button href="/hackarun-2026.ics" variant="time" download="hackarun-2026.ics">
      Adicionar à agenda
    </Button>
    <Button href="/equipes" variant="ghost">
      Ver equipes
    </Button>
  </div>
  <a class="success__back" href={EVENT_RETURN_HREF} data-back-to-event>
    <Icon name="arrow-left" size={16} />
    Voltar ao evento
  </a>
</div>

<style>
  .success {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    animation: success-in 700ms var(--ease-out);
  }

  .success__emblem {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    color: var(--c-success);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--c-success) 60%, transparent));
  }

  .success__emblem svg {
    width: 100%;
    height: 100%;
  }

  .success__code {
    color: var(--c-success);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .success__title {
    font-size: var(--fs-2xl);
  }

  /* foco programático: transparente (e não none) pra reaparecer no alto contraste */
  .success__title:focus {
    outline: 2px solid transparent;
  }

  /* protocolo num "ticket" com recortes laterais */
  .success__ticket {
    position: relative;
    display: grid;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-5) var(--space-6);
    border: 1px solid color-mix(in srgb, var(--c-success) 45%, transparent);
    border-radius: 4px;
    background:
      radial-gradient(
        80% 120% at 0% 0%,
        color-mix(in srgb, var(--c-success) 12%, transparent),
        transparent 60%
      ),
      var(--surface-strong);
    box-shadow: 0 0 40px -10px color-mix(in srgb, var(--c-success) 35%, transparent);
    -webkit-mask:
      radial-gradient(circle 12px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 12px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle 12px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 12px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
  }

  .success__label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .success__protocol {
    min-height: 1.3em;
    color: var(--c-success);
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 1rem + 1.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-shadow: 0 0 18px color-mix(in srgb, var(--c-success) 55%, transparent);
    user-select: all;
  }

  .success__teams {
    color: var(--text);
    font-weight: 600;
  }

  .success__teams a,
  .success__back {
    color: var(--ink-cyan);
  }

  .success__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .success__back:hover {
    color: var(--text);
  }

  .success__mail {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .success__steps {
    display: grid;
    gap: var(--space-3);
  }

  .success__steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: baseline;
    color: var(--text-muted);
  }

  .success__step-num {
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .success__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @keyframes success-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .success {
      animation: none;
    }
  }
</style>
