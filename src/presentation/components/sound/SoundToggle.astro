---
// botão SOM do header: desligado por padrão; SoundToggleView liga o áudio no clique
---

<button class="sound-toggle" type="button" data-sound-toggle aria-pressed="false" hidden>
  <span class="sound-toggle__eq" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </span>
  <span class="sound-toggle__text">Som</span>
  <span class="sr-only" data-sound-state>
    desligado
  </span>
</button>

<style>
  .sound-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-3);
    clip-path: var(--clip-btn);
    background: rgb(0 207 255 / 0.06);
    box-shadow: inset 0 0 0 1px var(--surface-line);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
    transition:
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }

  .sound-toggle:hover {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .sound-toggle[aria-pressed='true'] {
    color: var(--accent);
    background: rgb(0 207 255 / 0.12);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  /* equalizador: parado e baixo quando desligado, dançando quando ligado */
  .sound-toggle__eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .sound-toggle__eq span {
    width: 2px;
    height: 100%;
    background: currentColor;
    transform-origin: bottom;
    transform: scaleY(0.25);
    transition: transform var(--dur) var(--ease-out);
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span {
    animation: eq-bounce 0.9s var(--ease-in-out) infinite alternate;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(2) {
    animation-duration: 0.7s;
    animation-delay: -0.3s;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(3) {
    animation-duration: 1.1s;
    animation-delay: -0.6s;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(4) {
    animation-duration: 0.8s;
    animation-delay: -0.15s;
  }

  @keyframes eq-bounce {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sound-toggle[aria-pressed='true'] .sound-toggle__eq span {
      animation: none;
      transform: scaleY(0.7);
    }

    .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(odd) {
      transform: scaleY(0.45);
    }
  }
</style>
