---
// botão de som do header (só ícone): desligado por padrão; SoundToggleView liga o áudio no clique.
// Nome acessível = "Som" + estado em [data-sound-state]; aria-pressed diz se está ligado
---

<button class="sound-toggle" type="button" data-sound-toggle aria-pressed="false" hidden>
  <span class="sound-toggle__eq" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </span>
  {/* um span só: garante o espaço entre "Som" e o estado no nome acessível */}
  <span class="sr-only">
    Som <span data-sound-state>desligado</span>
  </span>
</button>

<style>
  .sound-toggle {
    position: relative;
    isolation: isolate;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: rgb(222 230 255 / 0.62);
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur) var(--ease-out);
  }

  .sound-toggle::before {
    content: '';
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: 3px;
    background: linear-gradient(180deg, rgb(28 44 140 / 0.3), rgb(6 9 30 / 0.5));
    box-shadow:
      inset 0 0 0 1px rgb(150 175 255 / 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
    transform: skewX(var(--skew));
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .sound-toggle:hover {
    color: var(--text);
  }

  .sound-toggle:hover::before {
    box-shadow:
      inset 0 0 0 1px rgb(0 229 255 / 0.55),
      0 0 16px rgb(0 229 255 / 0.25);
  }

  .sound-toggle[aria-pressed='true'] {
    color: var(--c-cyan);
  }

  .sound-toggle[aria-pressed='true']::before {
    background: linear-gradient(180deg, rgb(0 229 255 / 0.16), rgb(18 100 255 / 0.12));
    box-shadow:
      inset 0 0 0 1px rgb(0 229 255 / 0.7),
      0 0 20px rgb(0 229 255 / 0.35);
  }

  /* transparente (e não none): no alto contraste o box-shadow some e o contorno aparece */
  .sound-toggle:focus-visible {
    outline: 2px solid transparent;
  }

  .sound-toggle:focus-visible::before {
    box-shadow:
      0 0 0 2px var(--c-void),
      0 0 0 4px var(--focus);
  }

  /* equalizador: desligado = barras baixas e paradas (com um traço riscando); ligado = dançando */
  .sound-toggle__eq {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 16px;
  }

  .sound-toggle__eq span {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: currentColor;
    transform: scaleY(0.22);
    transition: transform var(--dur) var(--ease-out);
  }

  .sound-toggle__eq span:nth-child(2),
  .sound-toggle__eq span:nth-child(4) {
    transform: scaleY(0.4);
  }

  .sound-toggle__eq span:nth-child(3) {
    transform: scaleY(0.6);
  }

  .sound-toggle__eq::after {
    content: '';
    position: absolute;
    left: -3px;
    right: -3px;
    top: 50%;
    height: 1.5px;
    background: var(--c-magenta);
    box-shadow: 0 0 6px var(--c-magenta);
    transform: rotate(-35deg);
    transition: opacity var(--dur) var(--ease-out);
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq::after {
    opacity: 0;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span {
    box-shadow: 0 0 6px currentColor;
    animation: eq-bounce 0.9s var(--ease-in-out) infinite alternate;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(2) {
    animation-duration: 0.62s;
    animation-delay: -0.3s;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(3) {
    animation-duration: 1.05s;
    animation-delay: -0.6s;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(4) {
    animation-duration: 0.74s;
    animation-delay: -0.15s;
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(5) {
    animation-duration: 0.86s;
    animation-delay: -0.45s;
  }

  @keyframes eq-bounce {
    from {
      transform: scaleY(0.18);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sound-toggle[aria-pressed='true'] .sound-toggle__eq span {
      animation: none;
      transform: scaleY(0.8);
    }

    .sound-toggle[aria-pressed='true'] .sound-toggle__eq span:nth-child(odd) {
      transform: scaleY(0.5);
    }
  }
</style>
