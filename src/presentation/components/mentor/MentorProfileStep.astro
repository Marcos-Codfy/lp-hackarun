---
// etapa 02 do cadastro de mentor: área, tempo de experiência, cargo e se é egresso (curso e ano de formatura são
// [data-show-field], que a MentorFormView mostra só para quem respondeu "sim")
import TextField from '@presentation/components/registration/TextField.astro';
import SelectField from '@presentation/components/registration/SelectField.astro';
import ChoiceField from '@presentation/components/registration/ChoiceField.astro';
import FormStep from '@presentation/components/registration/FormStep.astro';
import { COURSE_SUGGESTIONS } from '@presentation/formatters/ParticipantLabels';
import {
  GRADUATE_OPTIONS,
  MENTOR_AREA_OPTIONS,
  MENTOR_EXPERIENCE_OPTIONS,
} from '@presentation/formatters/MentorLabels';
---

<FormStep
  index="02"
  title="Atuação"
  lead="Para a organização juntar cada mentor com as equipes que mais precisam dele."
>
  <SelectField
    id="mentor-area"
    field="area"
    label="Área de atuação"
    hint="A que mais combina com o seu dia a dia."
    options={MENTOR_AREA_OPTIONS}
  />
  <TextField
    id="mentor-specialties"
    field="specialties"
    label="Tecnologias e temas que você domina"
    hint="Ex.: React, Node.js, Docker, redes, pentest, Scrum."
    optional
    maxlength={120}
    wide
  />
  <div class="regform__pair">
    <TextField
      id="mentor-role"
      field="role"
      label="Cargo ou função"
      autocomplete="organization-title"
      maxlength={80}
    />
    <TextField
      id="mentor-company"
      field="company"
      label="Empresa"
      optional
      autocomplete="organization"
      maxlength={100}
    />
  </div>
  <SelectField
    id="mentor-experience"
    field="experience"
    label="Tempo de experiência na área"
    options={MENTOR_EXPERIENCE_OPTIONS}
  />
  <ChoiceField
    id="mentor-graduate"
    field="graduate"
    legend="Você é egresso(a) da UniCatólica?"
    options={GRADUATE_OPTIONS}
    columns={2}
  />
  <div class="regform__pair">
    <div data-show-field="course" hidden>
      <TextField
        id="mentor-course"
        field="course"
        label="Curso em que se formou"
        maxlength={80}
        suggestions={COURSE_SUGGESTIONS}
      />
    </div>
    <div data-show-field="graduationYear" hidden>
      <TextField
        id="mentor-graduation-year"
        field="graduationYear"
        label="Ano de formatura"
        inputmode="numeric"
        placeholder="2022"
        maxlength={4}
      />
    </div>
  </div>
</FormStep>
