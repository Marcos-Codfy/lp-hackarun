---
// card da página /equipes: foto/logo num quadro quadrado (contain sobre uma cópia borrada, logo nunca corta),
// iniciais como reserva. Sem props vira o molde do <template> que o TeamsView clona (TeamCardRenderer)
import { memberCountLabel } from '@presentation/formatters/TeamLabels';
import { softHyphenate } from '@presentation/formatters/SoftHyphens';
import TeamCardFrame from './TeamCardFrame.astro';

interface Props {
  name?: string;
  memberCount?: number;
  imageUrl?: string | null;
}

const { name = '', memberCount = 0, imageUrl = null } = Astro.props;
---

<li class:list={['team-card', { 'is-image-missing': !imageUrl }]} data-team-card>
  <TeamCardFrame name={name} imageUrl={imageUrl} />
  <div class="team-card__body">
    <h2 class="team-card__name" data-team-name>
      {softHyphenate(name)}
    </h2>
    <p class="team-card__members">
      <span
        class="team-card__pips"
        aria-hidden="true"
        data-team-pips
        style={`--count: ${memberCount}`}
      ></span>
      <span data-team-count>{memberCount > 0 && memberCountLabel(memberCount)}</span>
    </p>
  </div>
</li>

<style>
  /* coluna minmax(0): palavra longa no nome nunca alarga o card por dentro (o overflow cortaria o resto) */
  .team-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(0 229 255 / 0.2);
    border-radius: 3px;
    background:
      radial-gradient(120% 60% at 0% 100%, rgb(18 100 255 / 0.14), transparent 60%),
      linear-gradient(170deg, rgb(12 16 48 / 0.86), rgb(4 5 20 / 0.94));
    box-shadow: 0 24px 50px -32px rgb(0 0 0 / 0.9);
    transition:
      translate var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .team-card:hover {
    translate: 0 -4px;
    border-color: rgb(0 229 255 / 0.6);
    box-shadow:
      0 26px 50px -28px rgb(0 229 255 / 0.55),
      0 0 46px -16px rgb(18 100 255 / 0.6);
  }

  .team-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  /* nome longo ("Desenvolvedores") quebra só nos hífens opcionais das sílabas (softHyphenate): o hyphens: auto
     não tem dicionário pt-BR no Chrome/Brave do Windows. break-word fica só pra sequência sem sílaba nenhuma.
     Na grade de 2 colunas do celular a letra encolhe um pouco */
  .team-card__name {
    font-size: clamp(0.8rem, 3.4vw, var(--fs-sm));
    line-height: var(--lh-snug);
    letter-spacing: 0.01em;
    overflow-wrap: break-word;
    -webkit-hyphens: manual;
    hyphens: manual;
    text-wrap: balance;
  }

  .team-card__members {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* um bloquinho por integrante, sem gerar DOM extra */
  .team-card__pips {
    width: calc(var(--count, 0) * 9px);
    height: 7px;
    background: repeating-linear-gradient(90deg, var(--c-cyan) 0 6px, transparent 6px 9px);
    filter: drop-shadow(0 0 4px rgb(0 229 255 / 0.6));
  }

  @media (min-width: 40rem) {
    .team-card__body {
      padding: var(--space-4) var(--space-4) var(--space-5);
    }

    .team-card__name {
      font-size: var(--fs-base);
      letter-spacing: 0.03em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card:hover {
      translate: none;
    }
  }
</style>
