---
// card de equipe; sem props vira o molde do <template> que o TeamsView clona
interface Props {
  rank?: number;
  name?: string;
  course?: string | null;
  memberCount?: number;
}

const { rank, name = '', course = null, memberCount = 0 } = Astro.props;
const rankText = rank ? `#${String(rank).padStart(2, '0')}` : '';
const countText = memberCount ? `${memberCount} ${memberCount === 1 ? 'integrante' : 'integrantes'}` : '';
---

<li class="team-card">
  <span class="team-card__rank" aria-hidden="true" data-team-rank>
    {rankText}
  </span>
  <div class="team-card__body">
    <p class="team-card__name" data-team-name>
      {name}
    </p>
    <p class="team-card__course" data-team-course hidden={!course}>
      {course}
    </p>
  </div>
  <p class="team-card__members">
    <span class="team-card__pips" aria-hidden="true" data-team-pips style={`--count: ${memberCount}`}></span>
    <span data-team-count>{countText}</span>
  </p>
  <span class="team-card__badge" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m3.5 8.5 3 3 6-7"></path>
    </svg>
    Confirmada
  </span>
</li>

<style>
  .team-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid rgb(0 229 255 / 0.18);
    border-left: 2px solid var(--c-cyan);
    border-radius: 3px;
    background:
      radial-gradient(80% 120% at 0% 50%, rgb(0 229 255 / 0.1), transparent 60%), rgb(6 9 30 / 0.82);
    transition:
      translate var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .team-card:hover {
    translate: 4px 0;
    box-shadow: 0 0 40px -12px rgb(0 229 255 / 0.5);
  }

  .team-card__rank {
    grid-row: 1 / span 3;
    align-self: start;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(0 229 255 / 0.7);
    font-variant-numeric: tabular-nums;
  }

  .team-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 800;
    line-height: var(--lh-snug);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .team-card__course {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .team-card__members {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  /* um bloquinho por integrante, sem gerar DOM extra */
  .team-card__pips {
    width: calc(var(--count, 0) * 10px);
    height: 8px;
    background: repeating-linear-gradient(90deg, var(--c-cyan) 0 7px, transparent 7px 10px);
    filter: drop-shadow(0 0 4px rgb(0 229 255 / 0.6));
  }

  .team-card__badge {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-2);
    padding: 0.25rem 0.6rem;
    border: 1px solid rgb(44 245 180 / 0.45);
    background: rgb(44 245 180 / 0.08);
    color: var(--c-success);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .team-card__badge svg {
    width: 12px;
    height: 12px;
  }

  .team-card__body,
  .team-card__members,
  .team-card__badge {
    grid-column: 2;
  }

  @media (min-width: 40rem) {
    .team-card {
      grid-template-columns: auto 1fr auto auto;
    }

    .team-card__rank {
      grid-row: auto;
      align-self: center;
    }

    .team-card__members {
      grid-column: 3;
    }

    .team-card__badge {
      grid-column: 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card:hover {
      translate: none;
    }
  }
</style>
