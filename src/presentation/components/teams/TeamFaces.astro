---
// vitrine da LP: fotos de algumas equipes confirmadas (TeamsView preenche pelo <template>) e, enquanto não
// tem ninguém, vagas fantasma. Decorativa: o número e o botão pra /equipes contam a história
interface Props {
  hasTeams: boolean;
}

const { hasTeams } = Astro.props;
const GHOSTS = 4;
---

<div class="faces" aria-hidden="true">
  <ol role="list" class="faces__list" data-teams-faces hidden></ol>
  <span class="faces__more" data-teams-more hidden></span>
  <span class="faces__ghosts" data-teams-empty hidden={hasTeams}>
    {Array.from({ length: GHOSTS }, (_, i) => (
      <span class="faces__ghost" style={`--i: ${i}`}>
        ?
      </span>
    ))}
  </span>
  <template data-teams-face-template>
    <li class="face" data-team-card>
      <span class="face__frame" data-team-frame>
        <span class="face__initials" data-team-initials></span>
      </span>
    </li>
  </template>
</div>

<style>
  .faces {
    display: flex;
    align-items: center;
  }

  /* tamanho e sobreposição vêm de quem hospeda (--face-size, --face-overlap): a LP aumenta no desktop */
  .faces__list,
  .faces__ghosts {
    display: flex;
    align-items: center;
    padding-left: calc(var(--face-overlap, -10px) * -1);
  }

  .face,
  .faces__ghost {
    width: var(--face-size, clamp(3.5rem, 2.9rem + 2.4vw, 4.75rem));
    aspect-ratio: 1;
    margin-left: var(--face-overlap, -10px);
    flex: none;
  }

  /* quadros sobrepostos com borda neon, como os ícones de jogadores num lobby */
  .face__frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1.5px solid var(--c-cyan);
    border-radius: 3px;
    background: radial-gradient(circle at 50% 40%, rgb(18 100 255 / 0.5), var(--c-night) 75%);
    box-shadow:
      0 0 0 3px var(--c-void),
      0 0 22px rgb(0 229 255 / 0.35);
  }

  /* montserrat: na orbitron as iniciais O, D e C viram o mesmo retângulo */
  .face__initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-body);
    font-size: calc(var(--face-size, 4rem) * 0.3);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--ink-cyan);
  }

  .face__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .face__frame :global(.team-card__backdrop) {
    object-fit: cover;
    filter: blur(8px) brightness(0.65);
    transform: scale(1.3);
  }

  .face__frame :global(.team-card__img) {
    object-fit: contain;
  }

  :global(.face.is-image-missing) .face__frame :global(img) {
    display: none;
  }

  .faces__more {
    display: grid;
    place-items: center;
    min-width: 3rem;
    height: 3rem;
    margin-left: var(--space-3);
    padding-inline: var(--space-2);
    border: 1px solid rgb(0 229 255 / 0.45);
    border-radius: 3px;
    background: rgb(4 6 22 / 0.8);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .faces__ghost {
    display: grid;
    place-items: center;
    border: 1px dashed rgb(0 229 255 / 0.5);
    border-radius: 3px;
    background:
      repeating-linear-gradient(135deg, rgb(0 229 255 / 0.06) 0 8px, transparent 8px 16px), rgb(4 6 22 / 0.9);
    box-shadow: 0 0 0 3px var(--c-void);
    color: rgb(143 243 255 / 0.7);
    font-family: var(--font-display);
    font-size: calc(var(--face-size, 4rem) * 0.32);
    font-weight: 800;
    opacity: calc(1 - var(--i) * 0.18);
  }
</style>
