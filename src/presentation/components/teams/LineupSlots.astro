---
// lineup vazio estilo e-sports: slots esperando as equipes (decorativo, o texto ao lado explica)
interface Props {
  count?: number;
}

const { count = 5 } = Astro.props;
const slots = Array.from({ length: count }, (_, i) => String(i + 1).padStart(2, '0'));
---

<ol role="list" class="lineup" aria-hidden="true">
  {slots.map((code, i) => (
    <li class="lineup__slot" style={`--i: ${i}`}>
      <span class="lineup__code">#{code}</span>
      <span class="lineup__plus">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 6v12M6 12h12"></path>
        </svg>
      </span>
      <span class="lineup__label">
        <i></i>
        Vaga aberta
      </span>
      <span class="lineup__scan"></span>
    </li>
  ))}
</ol>

<style>
  .lineup {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }

  .lineup__slot {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    overflow: hidden;
    border: 1px dashed rgb(0 229 255 / 0.32);
    border-radius: 3px;
    background:
      repeating-linear-gradient(135deg, rgb(0 229 255 / 0.035) 0 10px, transparent 10px 20px),
      rgb(4 8 26 / 0.6);
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }

  .lineup__slot:hover {
    border-color: rgb(0 229 255 / 0.7);
    background:
      repeating-linear-gradient(135deg, rgb(0 229 255 / 0.07) 0 10px, transparent 10px 20px),
      rgb(4 8 26 / 0.7);
  }

  .lineup__code {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(0 229 255 / 0.6);
  }

  .lineup__plus {
    display: grid;
    justify-self: end;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgb(0 229 255 / 0.4);
    color: var(--c-cyan);
    transform: rotate(45deg);
    order: 3;
  }

  .lineup__plus svg {
    width: 1.1rem;
    height: 1.1rem;
    transform: rotate(-45deg);
  }

  .lineup__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: #8ff3ff;
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .lineup__label i {
    width: 6px;
    height: 6px;
    background: var(--c-cyan);
    box-shadow: 0 0 10px var(--c-cyan);
    animation: slot-pulse 1.8s var(--ease-in-out) infinite;
    animation-delay: calc(var(--i) * 0.25s);
  }

  /* varredura lenta, defasada por slot */
  .lineup__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(0 229 255 / 0.12) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: slot-scan 4.5s var(--ease-in-out) infinite;
    animation-delay: calc(var(--i) * 0.35s);
    pointer-events: none;
  }

  @keyframes slot-pulse {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes slot-scan {
    60%,
    100% {
      transform: translateX(100%);
    }
  }

  /* telas maiores: slots altos lado a lado, como a escalação de um time */
  @media (min-width: 640px) {
    .lineup {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .lineup__slot {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      justify-items: start;
      min-height: 15rem;
      padding: var(--space-5) var(--space-4);
    }

    .lineup__code {
      font-size: var(--fs-2xl);
    }

    .lineup__plus {
      order: 0;
      justify-self: center;
      align-self: center;
      width: 3rem;
      height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lineup__label i,
    .lineup__scan {
      animation: none;
    }

    .lineup__scan {
      opacity: 0;
    }
  }
</style>
