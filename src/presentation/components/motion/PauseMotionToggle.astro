---
import MotionGlyph from './MotionGlyph.astro';

// pausar animações no header (WCAG 2.2.2), mesma placa do botão de som. MotionPreferenceView liga tudo:
// nome acessível fixo, aria-pressed = pausado e o tooltip com a ação do próximo clique
---

<button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>
  <MotionGlyph />
  <span class="sr-only">Pausar animações</span>
  <span class="motion-toggle__tip" aria-hidden="true" data-motion-tip>
    Pausar animações
  </span>
</button>

<style>
  .motion-toggle {
    position: relative;
    isolation: isolate;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--text-dim);
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur) var(--ease-out);
  }

  .motion-toggle::before {
    content: '';
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: 3px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-ultra) 16%, transparent),
      color-mix(in srgb, var(--c-night) 55%, transparent)
    );
    box-shadow:
      inset 0 0 0 1px var(--control-line),
      inset 0 1px 0 color-mix(in srgb, var(--c-ice) 8%, transparent);
    transform: skewX(var(--skew));
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .motion-toggle:not([aria-disabled='true']):hover {
    color: var(--text);
  }

  .motion-toggle:not([aria-disabled='true']):hover::before {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--c-cyan) 55%, transparent),
      0 0 16px color-mix(in srgb, var(--c-cyan) 25%, transparent);
  }

  .motion-toggle[aria-pressed='true'] {
    color: var(--c-cyan);
  }

  .motion-toggle[aria-pressed='true']::before {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-cyan) 16%, transparent),
      color-mix(in srgb, var(--c-electric) 12%, transparent)
    );
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--c-cyan) 70%, transparent),
      0 0 20px color-mix(in srgb, var(--c-cyan) 35%, transparent);
  }

  /* reduced motion: já está tudo parado, o botão só mostra o estado */
  .motion-toggle[aria-disabled='true'] {
    color: var(--text-dim);
    cursor: default;
  }

  .motion-toggle[aria-disabled='true']::before {
    background: color-mix(in srgb, var(--c-night) 55%, transparent);
    box-shadow: inset 0 0 0 1px var(--surface-line);
  }

  /* transparente (e não none): no alto contraste o box-shadow some e o contorno aparece */
  .motion-toggle:focus-visible {
    outline: 2px solid transparent;
  }

  .motion-toggle:focus-visible::before {
    box-shadow:
      0 0 0 2px var(--c-void),
      0 0 0 4px var(--focus);
  }

  /* tooltip (WCAG 1.4.13): abre no hover e no foco de teclado, dá pra passar o mouse por cima, Esc fecha */
  .motion-toggle__tip {
    position: absolute;
    top: calc(100% + 8px);
    right: -2px;
    width: max-content;
    max-width: 14rem;
    padding: 0.5rem 0.7rem;
    border-radius: 3px;
    background: var(--surface-solid);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--c-cyan) 35%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--c-cyan) 70%, transparent),
      var(--shadow-float);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-align: right;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  /* ponte invisível no vão: o mouse sai do botão pro tooltip sem fechar */
  .motion-toggle__tip::before {
    content: '';
    position: absolute;
    inset: -10px 0 100%;
  }

  .motion-toggle:focus-visible .motion-toggle__tip {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  @media (hover: hover) {
    .motion-toggle:hover .motion-toggle__tip {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }

  .motion-toggle.is-tip-dismissed .motion-toggle__tip {
    opacity: 0;
    pointer-events: none;
  }

  @media (forced-colors: active) {
    .motion-toggle::before {
      border: 1px solid ButtonText;
    }

    .motion-toggle[aria-pressed='true']::before {
      forced-color-adjust: none;
      background: Highlight;
    }

    .motion-toggle__tip {
      border: 1px solid CanvasText;
    }
  }
</style>
