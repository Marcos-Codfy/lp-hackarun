---
// layout da LP (e das páginas que ainda usam o boot completo): aurora + palco 3D + App.boot()
import DocumentHead from './parts/DocumentHead.astro';
import Backdrop from './parts/Backdrop.astro';
import type { SeoProps } from '@presentation/components/seo/Seo.astro';
import { APP_CONFIG_ID, type AppConfig } from '@presentation/app/AppConfig';
import { safeJsonForScript } from '@shared/utils/json';
import '@presentation/styles/tokens.css';
import '@presentation/styles/base.css';

interface Props {
  seo: SeoProps;
  appConfig: AppConfig;
}

const { seo, appConfig } = Astro.props;

// texto do conteúdo nunca fecha o <script> de dados antes da hora
const configJson = safeJsonForScript(appConfig);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <DocumentHead seo={seo} />
  </head>
  <body>
    <Backdrop />

    <!-- palco 3D fixo atrás de tudo; decorativo, por isso aria-hidden -->
    <div class="experience-layer" aria-hidden="true">
      <div class="experience-fallback" data-experience-fallback></div>
      <canvas class="experience-canvas" data-experience></canvas>
    </div>

    <slot />

    <script type="application/json" id={APP_CONFIG_ID} set:html={configJson} />
    <script>
      import { App } from '@presentation/app/App';
      App.boot();
    </script>
  </body>
</html>

<style>
  /* canvas opaco (preto) somado à aurora por screen; nada de opacity/filter/transform aqui ou a mistura isola */
  .experience-layer {
    position: fixed;
    inset: 0;
    z-index: var(--z-canvas);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .experience-canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  :global(.is-experience-ready) .experience-canvas {
    opacity: 1;
  }

  /* brilho em CSS enquanto o three.js não chega (ou se nunca chegar) */
  .experience-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 42%, rgb(0 229 255 / 0.2) 0, rgb(18 100 255 / 0.14) 18%, transparent 42%),
      radial-gradient(circle at 50% 42%, transparent 23%, rgb(31 53 255 / 0.28) 24.5%, transparent 27.5%);
    transition: opacity 1.2s var(--ease-out);
  }

  :global(.is-experience-ready) .experience-fallback {
    opacity: 0;
  }
</style>
