---
// <head> comum de todas as páginas: meta, fontes self-hosted (2 com preload) e SEO
// orbitron com o til redesenhado (scripts/fonts/patch_orbitron_tilde.py): a original lê "NÀO"
import displayFont from '../../../assets/fonts/orbitron-pt-latin-wght.woff2?url';
import bodyFont from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Seo, { type SeoProps } from '@presentation/components/seo/Seo.astro';

interface Props {
  seo: SeoProps;
}

const { seo } = Astro.props;

// só o subset latin (cobre todo o português); as fontes ficam no próprio site
const LATIN =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2190-2193, U+2212, U+2215, U+FEFF, U+FFFD';
const face = (family: string, url: string, weights: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weights};src:url(${url}) format('woff2');unicode-range:${LATIN}}`;
const fontFaces = [
  face('Orbitron Variable', displayFont, '400 900'),
  face('Montserrat Variable', bodyFont, '100 900'),
  face('JetBrains Mono Variable', monoFont, '100 800'),
].join('');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#02030b" />
<meta name="color-scheme" content="dark" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
<Seo {...seo} />
<style is:inline set:html={fontFaces} />
