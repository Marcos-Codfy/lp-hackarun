---
// conteúdo da página /equipes: título, grade de equipes confirmadas e a regra de publicação. A troca com a
// página de inscrição e o "Voltar ao evento" ficam na SubNav, logo acima
import type { SlotsDTO, TeamDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import PageHalo from '@presentation/components/layout/PageHalo.astro';
import TeamGallery from '@presentation/components/teams/TeamGallery.astro';
import SectionHeader from './shared/SectionHeader.astro';
import './sections.css';

interface Props {
  teams: TeamDTO[];
  slots: SlotsDTO;
  // com as inscrições encerradas o estado vazio não chama pra se inscrever
  registrationOpen: boolean;
}

const { teams, slots, registrationOpen } = Astro.props;
---

<section class="section teams-page tone-cyan" id="inscritas" aria-labelledby="inscritas-title">
  <PageHalo />
  <div class="container section-stack teams-page__stack">
    <div class="teams-page__head">
      <SectionHeader
        id="inscritas-title"
        level="h1"
        size="lg"
        code="EQ"
        eyebrow="Grid de largada"
        title="Equipes <em>inscritas</em>"
        lead="Quem já garantiu vaga no HackaRun 2026, com a foto ou a logo de cada time. A lista se atualiza sozinha a cada inscrição confirmada."
      />
    </div>

    <TeamGallery teams={teams} slots={slots} registrationOpen={registrationOpen} />

    <p class="section-note">
      <Icon name="shield" />
      <span>
        <strong>A equipe aparece aqui depois que a organização confirma a inscrição.</strong> Só o nome, a
        foto e o número de integrantes. Quer trocar ou tirar a foto do ar? Peça por e-mail à organização, com
        o protocolo.
      </span>
    </p>
  </div>
</section>

<style>
  /* primeira seção da página, logo abaixo da SubNav (o PageLayout já desconta o header fixo) */
  .teams-page {
    padding-top: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    overflow: clip;
  }

  .teams-page__stack {
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .teams-page__head {
    display: grid;
    gap: var(--space-5);
    animation: page-in 0.8s var(--ease-out) both;
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .teams-page__head {
      animation: none;
    }
  }
</style>
