---
// conteúdo da página /equipes: trilha, título, grade de equipes confirmadas e a regra de publicação
import type { SlotsDTO, TeamDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import TeamGallery from '@presentation/components/teams/TeamGallery.astro';
import SectionHeader from './shared/SectionHeader.astro';
import './sections.css';

interface Props {
  teams: TeamDTO[];
  slots: SlotsDTO;
}

const { teams, slots } = Astro.props;
---

<section class="section teams-page tone-cyan" id="inscritas" aria-labelledby="inscritas-title">
  {/* sem 3D nesta página: um halo de HUD em CSS puro (estático) ocupa o lugar do objeto */}
  <span class="teams-page__halo" aria-hidden="true">
    <span class="teams-page__ring teams-page__ring--ticks"></span>
    <span class="teams-page__ring teams-page__ring--inner"></span>
  </span>
  <div class="container section-stack teams-page__stack">
    <div class="teams-page__head">
      <nav class="crumbs" aria-label="Você está em">
        <ol role="list" class="crumbs__list">
          <li>
            <a href="/">HackaRun 2026</a>
          </li>
          <li aria-current="page">Equipes</li>
        </ol>
      </nav>
      <SectionHeader
        id="inscritas-title"
        level="h1"
        size="lg"
        code="EQ"
        eyebrow="Grid de largada"
        title="Equipes <em>inscritas</em>"
        lead="Quem já garantiu vaga no HackaRun 2026, com a foto ou a logo de cada time. A lista se atualiza sozinha a cada inscrição confirmada."
      />
    </div>

    <TeamGallery teams={teams} slots={slots} />

    <p class="section-note">
      <Icon name="shield" />
      <span>
        <strong>A equipe aparece aqui depois que a organização confirma a inscrição.</strong> Quer trocar ou
        tirar a foto do ar? Fale com a organização e informe o protocolo.
      </span>
    </p>
  </div>
</section>

<style>
  /* primeira (e única) seção da página: a folga de cima é a do header fixo + respiro */
  .teams-page {
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 4.5rem));
    overflow: clip;
  }

  .teams-page__stack {
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  /* só no desktop: no celular os tiques passariam por cima do título */
  .teams-page__halo {
    position: absolute;
    top: calc(var(--header-h) - 1rem);
    right: -4rem;
    z-index: -1;
    display: none;
    place-items: center;
    width: 38rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, rgb(18 100 255 / 0.32), rgb(148 27 255 / 0.12) 55%, transparent 72%),
      radial-gradient(closest-side, transparent 64%, rgb(0 229 255 / 0.22) 64.4%, transparent 65.4%);
    pointer-events: none;
  }

  .teams-page__ring {
    position: absolute;
    border-radius: 50%;
  }

  /* régua de HUD: tiques finos num anel (conic + máscara radial) */
  .teams-page__ring--ticks {
    inset: 14%;
    background: repeating-conic-gradient(rgb(143 243 255 / 0.55) 0 0.4deg, transparent 0.4deg 6deg);
    -webkit-mask: radial-gradient(closest-side, transparent 92%, #000 93%);
    mask: radial-gradient(closest-side, transparent 92%, #000 93%);
  }

  .teams-page__ring--inner {
    inset: 27%;
    border: 1px solid rgb(0 229 255 / 0.35);
    box-shadow:
      0 0 40px rgb(0 229 255 / 0.18),
      inset 0 0 60px rgb(18 100 255 / 0.25);
  }

  .teams-page__head {
    display: grid;
    gap: var(--space-5);
    animation: page-in 0.8s var(--ease-out) both;
  }

  .crumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .crumbs__list li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: rgb(0 229 255 / 0.5);
  }

  .crumbs__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-cyan);
    text-decoration: none;
  }

  .crumbs__list a:hover {
    text-decoration: underline;
  }

  .crumbs__list [aria-current='page'] {
    color: var(--text);
  }

  @media (min-width: 64rem) {
    .teams-page__halo {
      display: grid;
    }
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .teams-page__head {
      animation: none;
    }
  }
</style>
