---
// refletores de palco em CSS puro (quentes: ouro/laranja); o SpotlightAnimator pausa fora da tela e acende na entrada
---

<div class="beams" aria-hidden="true">
  <span class="beams__beam beams__beam--a" data-beam></span>
  <span class="beams__beam beams__beam--b" data-beam></span>
  <span class="beams__beam beams__beam--c" data-beam></span>
  <span class="beams__beam beams__beam--d" data-beam></span>
  <span class="beams__floor" data-beam></span>
</div>

<style>
  .beams {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* cone que nasce no teto e abre pra baixo: miolo quente e borda que some */
  .beams__beam {
    position: absolute;
    top: -4%;
    width: 26vmax;
    height: 115%;
    transform-origin: 50% 0%;
    background:
      radial-gradient(14% 6% at 50% 0%, rgb(255 244 220 / 0.85), transparent 100%),
      linear-gradient(
        180deg,
        rgb(255 214 140 / 0.3) 0%,
        rgb(255 170 70 / 0.12) 35%,
        rgb(255 133 47 / 0.035) 70%,
        transparent 92%
      );
    clip-path: polygon(48.5% 0, 51.5% 0, 100% 100%, 0 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 8%, #000 40%, #000 60%, transparent 92%);
    mask-image: linear-gradient(90deg, transparent 8%, #000 40%, #000 60%, transparent 92%);
    mix-blend-mode: screen;
    animation: beam-sweep 10s var(--ease-in-out) infinite alternate;
  }

  .beams__beam--a {
    left: -6%;
    --from: -26deg;
    --to: -8deg;
  }

  .beams__beam--b {
    left: 18%;
    --from: 12deg;
    --to: -10deg;
    opacity: 0.75;
    animation-duration: 12s;
  }

  .beams__beam--c {
    left: 46%;
    --from: -16deg;
    --to: 10deg;
    opacity: 0.5;
    animation-duration: 14s;
  }

  .beams__beam--d {
    right: -8%;
    --from: 24deg;
    --to: 8deg;
    animation-duration: 11s;
    background:
      radial-gradient(14% 6% at 50% 0%, rgb(255 200 250 / 0.7), transparent 100%),
      linear-gradient(180deg, rgb(237 40 232 / 0.2) 0%, rgb(255 133 47 / 0.06) 50%, transparent 88%);
  }

  /* brilho do palco no chão */
  .beams__floor {
    position: absolute;
    right: -10%;
    bottom: -18%;
    left: -10%;
    height: 45%;
    background: radial-gradient(
      ellipse 60% 55% at 40% 100%,
      rgb(255 133 47 / 0.22),
      rgb(255 194 74 / 0.06) 50%,
      transparent 75%
    );
  }

  /* fora da tela não gasta GPU */
  :global(.is-idle) .beams__beam {
    animation-play-state: paused;
  }

  @keyframes beam-sweep {
    from {
      transform: rotate(var(--from));
    }
    to {
      transform: rotate(var(--to));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beams__beam {
      animation: none;
      transform: rotate(var(--from));
    }
  }
</style>
