---
// seção de equipes da LP: vira chamada pra página própria (/equipes); a galáxia 3D continua passando aqui
import type { LandingPageDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import SectionHeader from './shared/SectionHeader.astro';
import TeamsTeaser from './teams/TeamsTeaser.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { teams, event } = Astro.props.data;
---

<section
  id="equipes"
  class="section teams tone-cyan"
  data-scene="dust"
  data-checkpoint="Equipes"
  aria-labelledby="equipes-title"
>
  <div class="container section-stack">
    <SectionHeader
      id="equipes-title"
      code="08"
      eyebrow="Equipes"
      title="Quem já está na <em>largada</em>"
      lead="As equipes confirmadas têm uma página só delas, com a foto ou a logo de cada time. Veja quem já garantiu vaga."
    />

    <div data-reveal="up">
      <TeamsTeaser teams={teams} registration={event.registration} />
    </div>

    <p class="section-note section-note--time" data-reveal="up">
      <Icon name="users" />
      <span>
        <strong>Vagas limitadas à capacidade dos laboratórios.</strong> Monte o time e garanta a sua.
      </span>
    </p>
  </div>
</section>
