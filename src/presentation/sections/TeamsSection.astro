---
// seção de equipes da LP: como o sorteio forma as equipes (a inscrição é individual). A página /equipes fica
// escondida até o sorteio; a galáxia 3D continua passando aqui (id, cena e checkpoint iguais)
import type { LandingPageDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import SectionHeader from './shared/SectionHeader.astro';
import TeamDraw from './teams/TeamDraw.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { registration } = Astro.props.data.event;
---

<section
  id="equipes"
  class="section teams tone-cyan"
  data-scene="dust"
  data-checkpoint="Equipes"
  aria-labelledby="equipes-title"
>
  <div class="container section-stack">
    <SectionHeader
      id="equipes-title"
      code="08"
      eyebrow="Equipes"
      title="Equipes formadas no <em>sorteio</em>"
      lead="A inscrição é individual. As equipes são montadas por sorteio, presencialmente, com quem estiver credenciado na abertura do hackathon."
    />

    <div data-reveal="up">
      <TeamDraw registration={registration} />
    </div>

    <p class="section-note section-note--time" data-reveal="up">
      <Icon name="clock" />
      <span>
        <strong>A inscrição não garante vaga numa equipe.</strong> Só participa do sorteio quem estiver
        presente e credenciado no horário.
      </span>
    </p>
  </div>
</section>
