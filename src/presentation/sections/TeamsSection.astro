---
import type { LandingPageDTO } from '@application/index';
import SectionHeading from '@presentation/components/ui/SectionHeading.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import TeamRoster from '@presentation/components/teams/TeamRoster.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { teams, event } = Astro.props.data;
---

<section
  id="equipes"
  class="section teams"
  data-scene="dust"
  data-checkpoint="Equipes"
  aria-labelledby="equipes-title"
>
  <div class="container section-stack">
    <SectionHeading
      id="equipes-title"
      code="08"
      eyebrow="Equipes"
      title="Quem já está na <em>largada</em>"
      lead="As equipes confirmadas aparecem aqui assim que a inscrição é validada pela organização."
    />

    <div data-reveal="up">
      <TeamRoster teams={teams} slots={event.registration.slots} />
    </div>

    <p class="section-note section-note--time" data-reveal="up">
      <Icon name="users" />
      <span>
        <strong>Vagas limitadas à capacidade dos laboratórios.</strong> Monte o time e garanta a sua.
      </span>
    </p>
  </div>
</section>
