---
import type { RegistrationDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { RegistrationCopy } from '@presentation/formatters/RegistrationCopy';
// import ChargeStatus from './ChargeStatus.astro';

// CTA que "carrega" junto com o globo: a seção recebe is-awaiting-charge, is-charging (com --charge-ms)
// e por fim is-charged; sem JS nenhuma classe entra e o CTA fica simplesmente visível. A barra de energia é
// um fio logo embaixo do botão principal, que enche no tempo do globo.

// Leva pra página de inscrição (o rótulo segue o status: "Quero participar" antes de abrir). O botão
// secundário (que subia pra seção das equipes, hoje fora da LP) saiu, e a faixa de status fica comentada

// O principal leva pra página de inscrição (o rótulo segue o status: "Quero participar" antes de abrir); o
// secundário leva ao FAQ, que explica o sorteio das equipes. Encerrada, sobra só o aviso de encerramento
interface Props {
  registration: RegistrationDTO;
}

const { registration } = Astro.props;
const copy = new RegistrationCopy();
const cta = copy.cta(registration.status, 'final');
const open = cta.isRegistration;
---

<div class="charge" data-charge-reveal>
  <div class="charge__actions">
    <div class="charge__button">
      <span class="charge__ring" aria-hidden="true"></span>
      <Button size="lg" href={cta.href} registrationCta={open ? 'final' : undefined}>
        {copy.actionLabel(registration.status)}
        <Icon slot="icon" name="arrow-right" />
      </Button>
      <span class="charge__meter" aria-hidden="true">
        <span class="charge__fill"></span>
      </span>
    </div>

    {open && (
      <Button size="lg" variant="ghost" href="#faq-teams" class="charge__secondary">
        Como as equipes são formadas
      </Button>
    )}
  </div>
  {/* <ChargeStatus registration={registration} /> */}
</div>

<style>
  .charge {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
  }

  /* medidor de energia: fio segmentado logo embaixo do botão, invisível até a carga começar (não ocupa
     altura: no celular o miolo inteiro precisa caber numa tela) */
  .charge__meter {
    position: absolute;
    top: calc(100% + 5px);
    left: 12%;
    right: 12%;
    height: 3px;
    overflow: hidden;
    background: rgb(143 243 255 / 0.12);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease-out);
    -webkit-mask: repeating-linear-gradient(90deg, #000 0 calc(5% - 2px), transparent calc(5% - 2px) 5%);
    mask: repeating-linear-gradient(90deg, #000 0 calc(5% - 2px), transparent calc(5% - 2px) 5%);
  }

  .charge__fill {
    position: absolute;
    inset: 0;
    background: var(--grad-energy);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* celular: um embaixo do outro, os dois na mesma largura (o secundário mais baixo); a partir de 640px lado
     a lado */
  .charge__actions {
    display: grid;
    justify-items: stretch;
    gap: var(--space-4);
  }

  .charge__actions :global(.btn) {
    width: 100%;
  }

  .charge__actions :global(.charge__secondary) {
    --btn-h: 46px;
  }

  /* 360px: "Fazer minha inscrição →" numa linha só dentro do paralelogramo */
  .charge__actions :global(.btn--lg) {
    --btn-px: 1.1rem;
    --btn-fs: 0.8125rem;
  }

  @media (min-width: 25rem) {
    .charge__actions :global(.btn--lg) {
      --btn-px: 1.6rem;
      --btn-fs: 0.875rem;
    }
  }

  .charge__button {
    position: relative;
    display: grid;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
  }

  @media (min-width: 640px) {
    .charge__actions {
      grid-auto-flow: column;
      align-items: center;
      gap: var(--space-4);
    }

    .charge__actions :global(.btn) {
      width: auto;
    }

    .charge__actions :global(.charge__secondary) {
      --btn-h: 56px;
    }

    .charge__actions :global(.btn--lg) {
      --btn-px: 2.1rem;
      --btn-fs: clamp(0.875rem, 0.82rem + 0.22vw, 1.0625rem);
    }
  }

  /* onda que abre em volta do botão quando carrega */
  .charge__ring {
    position: absolute;
    inset: -12px -20px;
    border: 1px solid rgb(0 229 255 / 0.7);
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
  }

  /* aguardando a carga: CTA apagado e a barra vazia; carregando, ela enche no tempo do globo */
  :global(.is-awaiting-charge) .charge__button {
    opacity: 0.45;
    transform: scale(0.96);
    filter: saturate(0.3) drop-shadow(0 0 0 rgb(0 229 255 / 0));
  }

  :global(.is-awaiting-charge) .charge__meter {
    opacity: 1;
  }

  :global(.is-charging) .charge__fill {
    animation: charge-fill var(--charge-ms, 900ms) cubic-bezier(0.55, 0, 0.9, 0.6) forwards;
  }

  /* carregou: o botão acende com um brilho que sobe e assenta + anel que abre e some */
  :global(.is-charged) .charge__meter {
    opacity: 0;
  }

  :global(.is-charged) .charge__fill {
    transform: none;
  }

  :global(.is-charged) .charge__button {
    animation: charge-glow 1.2s var(--ease-out) both;
  }

  :global(.is-charged) .charge__ring {
    animation: charge-ring 1.1s var(--ease-out) both;
  }

  @keyframes charge-fill {
    to {
      transform: none;
    }
  }

  /* mesma lista de filtros em todo quadro: o navegador interpola em vez de pular */
  @keyframes charge-glow {
    0% {
      filter: saturate(0.3) drop-shadow(0 0 0 rgb(0 229 255 / 0));
      transform: scale(0.96);
    }
    35% {
      filter: saturate(1) drop-shadow(0 0 26px rgb(0 229 255 / 0.7));
      transform: scale(1.035);
    }
    100% {
      filter: saturate(1) drop-shadow(0 0 18px rgb(0 229 255 / 0.4));
      transform: scale(1);
    }
  }

  @keyframes charge-ring {
    0% {
      opacity: 0.7;
      transform: scale(0.94);
    }
    100% {
      opacity: 0;
      transform: scale(1.2, 1.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.is-awaiting-charge) .charge__button {
      transform: none;
    }

    :global(.is-charging) .charge__fill {
      animation: none;
      transform: scaleX(0.5);
    }

    :global(.is-charged) .charge__button,
    :global(.is-charged) .charge__ring {
      animation: none;
    }

    :global(.is-charged) .charge__button {
      filter: drop-shadow(0 0 18px rgb(0 229 255 / 0.4));
    }
  }
</style>
