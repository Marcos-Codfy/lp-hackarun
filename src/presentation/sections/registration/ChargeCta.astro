---
import type { RegistrationDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { RegistrationCopy } from '@presentation/formatters/RegistrationCopy';

// CTA que "carrega" junto com o globo: a seção recebe is-awaiting-charge, is-charging (com --charge-ms)
// e por fim is-charged; sem JS nenhuma classe entra e o CTA fica simplesmente visível
interface Props {
  registration: RegistrationDTO;
}

const { registration } = Astro.props;
const copy = new RegistrationCopy();
const cta = copy.cta(registration.status);
const href = cta.isRegistration ? '#inscricao-lobby' : cta.href;
const ctaAttrs = cta.isRegistration ? { registrationCta: 'final' } : { 'data-nav-link': true };
// no celular cada trecho vira uma linha (sem o "·" sobrando na quebra)
const statusParts = copy.statusLine(registration).split(' · ');
---

<div class="charge" data-charge-reveal>
  <div class="charge__meter" aria-hidden="true">
    <span class="charge__label">Carregando energia</span>
    <span class="charge__bar">
      <span class="charge__fill"></span>
    </span>
  </div>
  <div class="charge__button">
    <span class="charge__ring" aria-hidden="true"></span>
    <Button size="lg" href={href} {...ctaAttrs}>
      {cta.label}
      <Icon slot="icon" name="arrow-down" />
    </Button>
  </div>
  <p class:list={['charge__status', copy.isUrgent(registration.status) && 'charge__status--urgent']}>
    {statusParts.map((part, index) => (
      <>
        {index > 0 && <span class="charge__sep"> · </span>}
        <span class="charge__part">{part}</span>
      </>
    ))}
  </p>
</div>

<style>
  .charge {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
  }

  /* medidor de energia: invisível até a carga começar */
  .charge__meter {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .charge__label {
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .charge__bar {
    position: relative;
    width: min(18rem, 70vw);
    height: 4px;
    overflow: hidden;
    background: rgb(143 243 255 / 0.12);
    -webkit-mask: repeating-linear-gradient(90deg, #000 0 calc(5% - 2px), transparent calc(5% - 2px) 5%);
    mask: repeating-linear-gradient(90deg, #000 0 calc(5% - 2px), transparent calc(5% - 2px) 5%);
  }

  .charge__fill {
    position: absolute;
    inset: 0;
    background: var(--grad-energy);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .charge__button {
    position: relative;
  }

  /* onda que abre em volta do botão quando carrega */
  .charge__ring {
    position: absolute;
    inset: -12px -20px;
    border: 1px solid rgb(0 229 255 / 0.7);
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
  }

  /* plaquinha escura: a linha fica embaixo do globo aceso e o texto miúdo precisa de 4.5:1 */
  .charge__status {
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--c-void) 72%, transparent);
    box-shadow: inset 0 0 0 1px var(--surface-line);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .charge__part {
    display: block;
  }

  .charge__sep {
    display: none;
  }

  @media (min-width: 640px) {
    .charge__part {
      display: inline;
    }

    .charge__sep {
      display: inline;
    }
  }

  .charge__status--urgent {
    color: var(--ink-orange);
  }

  /* aguardando a carga: CTA apagado e a barra vazia; carregando, ela enche no tempo do globo */
  :global(.is-awaiting-charge) .charge__button {
    opacity: 0.45;
    transform: scale(0.96);
    filter: saturate(0.3) drop-shadow(0 0 0 rgb(0 229 255 / 0));
  }

  :global(.is-awaiting-charge) .charge__meter {
    opacity: 1;
  }

  :global(.is-charging) .charge__fill {
    animation: charge-fill var(--charge-ms, 900ms) cubic-bezier(0.55, 0, 0.9, 0.6) forwards;
  }

  .charge__button {
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
  }

  /* carregou: o botão acende com um brilho que sobe e assenta + anel que abre e some */
  :global(.is-charged) .charge__meter {
    opacity: 0;
  }

  :global(.is-charged) .charge__fill {
    transform: none;
  }

  :global(.is-charged) .charge__button {
    animation: charge-glow 1.2s var(--ease-out) both;
  }

  :global(.is-charged) .charge__ring {
    animation: charge-ring 1.1s var(--ease-out) both;
  }

  @keyframes charge-fill {
    to {
      transform: none;
    }
  }

  /* mesma lista de filtros em todo quadro: o navegador interpola em vez de pular */
  @keyframes charge-glow {
    0% {
      filter: saturate(0.3) drop-shadow(0 0 0 rgb(0 229 255 / 0));
      transform: scale(0.96);
    }
    35% {
      filter: saturate(1) drop-shadow(0 0 26px rgb(0 229 255 / 0.7));
      transform: scale(1.035);
    }
    100% {
      filter: saturate(1) drop-shadow(0 0 18px rgb(0 229 255 / 0.4));
      transform: scale(1);
    }
  }

  @keyframes charge-ring {
    0% {
      opacity: 0.7;
      transform: scale(0.94);
    }
    100% {
      opacity: 0;
      transform: scale(1.2, 1.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.is-awaiting-charge) .charge__button {
      transform: none;
    }

    :global(.is-charging) .charge__fill {
      animation: none;
      transform: scaleX(0.5);
    }

    :global(.is-charged) .charge__button,
    :global(.is-charged) .charge__ring {
      animation: none;
    }

    :global(.is-charged) .charge__button {
      filter: drop-shadow(0 0 18px rgb(0 229 255 / 0.4));
    }
  }
</style>
