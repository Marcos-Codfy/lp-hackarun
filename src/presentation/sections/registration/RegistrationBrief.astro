---
// painel "antes de se inscrever" da página de inscrição + três regras curtas. Só no desktop, ao lado
// do formulário; no celular e no tablet a lista vem recolhida (RegistrationBriefToggle) e cada regra aparece no
// próprio formulário
import Icon from '@presentation/components/ui/Icon.astro';
import PrepChecklist from '@presentation/components/registration/PrepChecklist.astro';

interface Props {
  teamSize: { min: number; max: number };
  drawAt: string | null;
}

const { teamSize, drawAt } = Astro.props;
---

<div class="brief sx-glass">
  <PrepChecklist teamSize={teamSize} drawAt={drawAt} variant="panel" id="reg-brief-title" />
  <ul class="brief__notes" role="list" aria-label="Bom saber">
    <li>
      <Icon name="users" size={16} />
      <span>
        A inscrição é individual e não garante vaga: as equipes saem do sorteio, só com quem estiver presente.
      </span>
    </li>
    <li>
      <Icon name="lock" size={16} />
      <span>Os dados ficam só com a organização do HackaRun.</span>
    </li>
  </ul>
</div>

<style>
  .brief {
    display: none;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .brief__notes {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--surface-line);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .brief__notes li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
  }

  .brief__notes :global(.icon) {
    margin-top: 0.1em;
    color: var(--ink-cyan);
  }

  .brief__notes a {
    color: var(--ink-cyan);
    font-weight: 600;
  }

  .brief__notes a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (min-width: 64rem) {
    .brief {
      display: grid;
    }
  }
</style>
