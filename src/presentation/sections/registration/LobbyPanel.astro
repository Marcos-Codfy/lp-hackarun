---
import type { RegistrationDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import RegistrationForm from '@presentation/components/registration/RegistrationForm.astro';

// "lobby" da equipe: painel de vidro com o formulário (o form em si é de outro módulo)
interface Props {
  registration: RegistrationDTO;
  // "11.11 · 19H" da largada, quando existir
  kickoffLabel?: string | null;
}

const { registration, kickoffLabel = null } = Astro.props;
const { min, max } = registration.teamSize;
const steps = ['Modalidade', 'Seus dados', 'Integrantes', 'Confirmar'];
---

<div class="lobby sx-glass sx-corners" id="inscricao-lobby">
  <span class="lobby__topline" aria-hidden="true"></span>
  <header class="lobby__head">
    <p class="sx-hud lobby__code">// Lobby · inscrição de equipe</p>
    <h3 class="lobby__title">
      Monte sua <em>equipe</em>
    </h3>
    <p class="lobby__lead">
      Equipes de {min} a {max} pessoas. Junte o time e preencha os dados abaixo.
    </p>
    <ol class="lobby__steps" role="list" aria-hidden="true">
      {steps.map((step, i) => (
        <li>
          <span>{String(i + 1).padStart(2, '0')}</span>
          {step}
        </li>
      ))}
    </ol>
  </header>

  <RegistrationForm registration={registration} />

  <div class="lobby__agenda">
    <Button variant="ghost" href="/hackarun-2026.ics" download="hackarun-2026.ics">
      Adicionar à agenda
      <Icon slot="icon" name="calendar" size={18} />
    </Button>
    {kickoffLabel && <p class="lobby__agenda-hint">Não perca a largada: {kickoffLabel}.</p>}
  </div>
</div>

<style>
  .lobby {
    --sx-border: linear-gradient(
      160deg,
      var(--c-cyan) 0%,
      rgb(18 100 255 / 0.35) 30%,
      rgb(148 27 255 / 0.2) 70%,
      var(--c-magenta) 100%
    );
    padding: var(--space-6) var(--space-5);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
    box-shadow:
      0 0 0 1px rgb(0 229 255 / 0.05),
      0 0 90px -30px rgb(0 229 255 / 0.5),
      0 50px 100px -50px rgb(0 0 0 / 0.95);
  }

  /* filete de energia no topo */
  .lobby__topline {
    position: absolute;
    top: 0;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-cyan), var(--c-violet), transparent);
    box-shadow: 0 0 18px var(--c-cyan);
  }

  .lobby__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .lobby__title {
    font-size: var(--fs-2xl);
  }

  .lobby__title :global(em),
  .lobby__title em {
    font-style: normal;
    background: var(--grad-energy);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lobby__lead {
    color: var(--text-muted);
  }

  .lobby__steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(140 160 255 / 0.12);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lobby__steps li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .lobby__steps span {
    color: var(--ink-cyan);
    font-weight: 700;
  }

  .lobby__agenda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(140 160 255 / 0.12);
  }

  /* sucesso e "abrem em breve" já têm o próprio "adicionar à agenda" */
  .lobby:global(:has([data-reg-success]:not([hidden]))) .lobby__agenda,
  .lobby:global(:has([data-registration-form][data-status='soon'])) .lobby__agenda {
    display: none;
  }

  .lobby__agenda-hint {
    color: var(--text-dim);
    font-size: var(--fs-sm);
  }

  @media (min-width: 640px) {
    .lobby {
      padding: var(--space-8) var(--space-8) var(--space-7);
    }
  }
</style>
