---
import type { FaqItemDTO } from '@application/index';
import NpcToken from '@presentation/components/npc/NpcToken.astro';

interface Props {
  item: FaqItemDTO;
  number: number;
  withToken?: boolean;
}

const { item, number, withToken = false } = Astro.props;
---

<details class="faq-entry">
  <summary class="faq-entry__summary">
    <span class="hud-label faq-entry__code" aria-hidden="true">
      Q.{String(number).padStart(2, '0')}
    </span>
    <span class="faq-entry__question">{item.question}</span>
    <span class="faq-entry__icon" aria-hidden="true"></span>
  </summary>
  <div class="faq-entry__answer">
    <p>{item.answer}</p>
    {withToken && (
      <p class="faq-entry__token">
        <NpcToken id="npc-3" label="Token NPC escondido no FAQ" />
      </p>
    )}
  </div>
</details>

<style>
  .faq-entry {
    border-bottom: 1px solid var(--surface-line);
    interpolate-size: allow-keywords;
  }

  .faq-entry__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 56px;
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .faq-entry__summary::-webkit-details-marker {
    display: none;
  }

  .faq-entry__summary:hover,
  .faq-entry[open] .faq-entry__summary {
    color: var(--c-cyan-soft);
  }

  .faq-entry__code {
    color: var(--text-dim);
  }

  .faq-entry__question {
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.35;
  }

  /* "+" que vira "−" ao abrir */
  .faq-entry__icon {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    clip-path: var(--clip-btn);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .faq-entry__icon::before,
  .faq-entry__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1.5px;
    background: var(--c-cyan);
    transform: translate(-50%, -50%);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq-entry__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-entry[open] .faq-entry__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-entry__answer {
    display: grid;
    gap: var(--space-3);
    padding: 0 0 var(--space-5) calc(var(--space-4) + 2.4rem);
    color: var(--text-muted);
  }

  .faq-entry[open] .faq-entry__answer {
    animation: faq-reveal var(--dur-slow) var(--ease-out);
  }

  .faq-entry__token {
    display: flex;
    justify-content: flex-end;
  }

  /* abertura suave onde o navegador já anima altura de <details> */
  .faq-entry::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-slow) var(--ease-out),
      content-visibility var(--dur-slow) allow-discrete;
  }

  .faq-entry[open]::details-content {
    block-size: auto;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 639px) {
    .faq-entry__answer {
      padding-left: 0;
    }
  }
</style>
