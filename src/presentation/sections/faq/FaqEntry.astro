---
import type { FaqItemDTO } from '@application/index';
import NpcToken from '@presentation/components/npc/NpcToken.astro';
import type { FaqLink } from './faqLinks';

interface Props {
  item: FaqItemDTO;
  number: number;
  withToken?: boolean;
  // atalho no fim da resposta (ex.: "Como faço a inscrição?" leva pra /inscricao)
  link?: FaqLink | null;
}

const { item, number, withToken = false, link = null } = Astro.props;
---

<details class="faq-entry">
  <summary class="faq-entry__summary">
    <span class="faq-entry__code" aria-hidden="true">
      Q.{String(number).padStart(2, '0')}
    </span>
    <span class="faq-entry__question">{item.question}</span>
    <span class="faq-entry__icon" aria-hidden="true"></span>
  </summary>
  <div class="faq-entry__answer">
    <p>{item.answer}</p>
    {link && (
      <p>
        <a class="faq-entry__link" href={link.href} download={link.download}>
          {link.label}
          <span aria-hidden="true"> →</span>
        </a>
      </p>
    )}
    {withToken && (
      <p class="faq-entry__token">
        <NpcToken id="npc-3" label="Token NPC escondido no FAQ" />
      </p>
    )}
  </div>
</details>

<style>
  .faq-entry {
    position: relative;
    border-radius: 3px;
    transition: background var(--dur) var(--ease-out);
    interpolate-size: allow-keywords;
  }

  .faq-entry + .faq-entry {
    border-top: 1px solid rgb(140 160 255 / 0.1);
  }

  /* barra acesa à esquerda quando aberta */
  .faq-entry::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--grad-blue);
    box-shadow: 0 0 12px rgb(0 229 255 / 0.6);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform var(--dur) var(--ease-out);
  }

  .faq-entry[open] {
    background: linear-gradient(90deg, rgb(0 229 255 / 0.07), transparent 70%);
  }

  .faq-entry[open]::before {
    transform: none;
  }

  .faq-entry__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 60px;
    padding: var(--space-4);
    cursor: pointer;
    list-style: none;
    border-radius: 3px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .faq-entry__summary::-webkit-details-marker {
    display: none;
  }

  .faq-entry__summary:hover {
    color: #c9f9ff;
  }

  .faq-entry__summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .faq-entry__code {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.14em;
  }

  .faq-entry[open] .faq-entry__code {
    color: var(--ink-cyan);
  }

  .faq-entry__question {
    font-size: var(--fs-base);
    font-weight: 600;
    line-height: 1.4;
  }

  /* "+" num losango que gira e vira "−" ao abrir */
  .faq-entry__icon {
    position: relative;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgb(0 229 255 / 0.35);
    border-radius: 2px;
    transition:
      transform var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .faq-entry__icon::before,
  .faq-entry__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 1.5px;
    background: var(--c-cyan);
    transform: translate(-50%, -50%);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq-entry__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-entry__summary:hover .faq-entry__icon {
    border-color: var(--c-cyan);
    box-shadow: 0 0 16px rgb(0 229 255 / 0.35);
  }

  .faq-entry[open] .faq-entry__icon {
    background: rgb(0 229 255 / 0.14);
    border-color: var(--c-cyan);
    transform: rotate(180deg);
  }

  .faq-entry[open] .faq-entry__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-entry__answer {
    display: grid;
    gap: var(--space-3);
    padding: 0 var(--space-4) var(--space-5);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .faq-entry[open] .faq-entry__answer {
    animation: faq-reveal var(--dur-slow) var(--ease-out);
  }

  .faq-entry__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-cyan);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  .faq-entry__token {
    display: flex;
    justify-content: flex-end;
  }

  /* abertura suave onde o navegador já anima altura de <details> */
  .faq-entry::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-slow) var(--ease-out),
      content-visibility var(--dur-slow) allow-discrete;
  }

  .faq-entry[open]::details-content {
    block-size: auto;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (min-width: 640px) {
    .faq-entry__summary {
      gap: var(--space-4);
      padding-left: var(--space-5);
    }

    /* resposta alinhada com o texto da pergunta, depois do código Q.xx */
    .faq-entry__answer {
      padding-right: var(--space-6);
      padding-left: calc(var(--space-5) + var(--space-4) + 2.6rem);
    }
  }
</style>
