---
// selo de público (programação e cards do evento): ponto aceso + texto curto num paralelogramo de vidro.
// tom: open = ciano, hackathon = violeta, teams = laranja, final = ouro, muted = neutro (marcas como "Em paralelo")
interface Props {
  tone: 'open' | 'hackathon' | 'teams' | 'final' | 'muted';
  label: string;
  as?: 'span' | 'li' | 'p';
}

const { tone, label, as: Tag = 'span' } = Astro.props;
---

<Tag class:list={['badge', `badge--${tone}`]}>
  <span class="badge__dot" aria-hidden="true"></span>
  {label}
</Tag>

<style>
  .badge {
    --badge-ink: var(--ink-cyan);
    --badge-dot: var(--c-cyan);
    --badge-line: rgb(0 229 255 / 0.45);
    --badge-bg: rgb(0 229 255 / 0.1);
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 1.625rem;
    padding: 0.2rem 0.7rem;
    color: var(--badge-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* casca inclinada atrás do texto reto, igual aos chips */
  .badge::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 2px;
    background: var(--badge-bg);
    box-shadow: inset 0 0 0 1px var(--badge-line);
    transform: skewX(var(--skew));
  }

  .badge__dot {
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--badge-dot);
    box-shadow: 0 0 8px var(--badge-dot);
    transform: rotate(45deg);
  }

  .badge--hackathon {
    --badge-ink: #e3c2ff;
    --badge-dot: var(--c-magenta);
    --badge-line: rgb(178 107 255 / 0.55);
    --badge-bg: linear-gradient(100deg, rgb(148 27 255 / 0.18), rgb(237 40 232 / 0.1));
  }

  .badge--teams {
    --badge-ink: var(--ink-orange);
    --badge-dot: var(--c-orange);
    --badge-line: rgb(255 133 47 / 0.55);
    --badge-bg: rgb(255 133 47 / 0.12);
  }

  .badge--final {
    --badge-ink: #ffdf9e;
    --badge-dot: var(--c-gold);
    --badge-line: rgb(255 194 74 / 0.55);
    --badge-bg: linear-gradient(100deg, rgb(255 194 74 / 0.14), rgb(255 133 47 / 0.1));
  }

  .badge--muted {
    --badge-ink: var(--text-muted);
    --badge-dot: rgb(157 188 255 / 0.7);
    --badge-line: rgb(150 175 255 / 0.25);
    --badge-bg: rgb(8 12 40 / 0.55);
  }

  .badge--muted .badge__dot {
    box-shadow: none;
  }

  @media (forced-colors: active) {
    .badge::before {
      border: 1px solid CanvasText;
    }

    .badge__dot {
      background: CanvasText;
    }
  }
</style>
