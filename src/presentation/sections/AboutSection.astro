---
import type { LandingPageDTO } from '@application/index';
import type { IconName } from '@presentation/components/ui/icons';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import SectionHeader from './shared/SectionHeader.astro';
import PillarCard from './about/PillarCard.astro';
import AboutTicker from './about/AboutTicker.astro';
import AboutStats from './about/AboutStats.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event } = Astro.props.data;
const { stats } = event;

const pillars: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'book',
    title: 'Minicursos',
    text: 'Algoritmos, testes, Git, dados e IA com prática orientada em laboratório. Todo mundo chega afiado na largada.',
  },
  {
    icon: 'cap',
    title: 'Mentoria de egressos',
    text: 'Quem já passou pelo curso orienta sua equipe em arquitetura, planejamento e boas práticas.',
  },
  {
    icon: 'route',
    title: 'Corrida de missões',
    text: 'Estações técnicas espalhadas por salas e laboratórios. Cada pista decifrada vale pontos.',
  },
  {
    icon: 'spotlight',
    title: 'Final no shopping',
    text: 'Entrega até as 15h e premiação no palco do Capim Dourado, com telão e banda ao vivo.',
  },
];

const ticker = [
  'Minicursos',
  'Mentoria',
  `${stats.stations} missões`,
  'NPCs à solta',
  new DayLabelFormatter().range(event.firstDate, event.lastDate),
  'Final no telão',
  'Palmas–TO',
];

const readout = [
  { value: stats.days, label: 'dias de evento' },
  { value: stats.stations, label: 'missões' },
  { value: stats.workshops, label: 'minicursos' },
  { value: 1, label: 'final no telão' },
];
---

<section
  id="sobre"
  class="section section--split about tone-blue"
  data-scene="orbit"
  data-checkpoint="O evento"
  aria-labelledby="sobre-title"
>
  <AboutTicker items={ticker} />

  <div class="container">
    <div class="section-split__content section-stack about__body">
      <SectionHeader
        id="sobre-title"
        code="01"
        eyebrow="O evento"
        title="Não é só um hackathon. É uma <em>corrida</em>."
        lead="Aprendizado na prática: minicursos, mentoria de egressos e uma corrida de missões técnicas por salas e laboratórios, até entregar uma solução final no prazo. Estudantes, professores, egressos e empresas no mesmo lugar."
      />

      <ul class="about__pillars" role="list" data-reveal-group>
        {pillars.map((pillar, index) => (
          <PillarCard index={index} {...pillar} />
        ))}
      </ul>

      <AboutStats stats={readout} />
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 0;
  }

  .about__body {
    padding-top: clamp(4rem, 2rem + 6vw, 8rem);
  }

  .about__pillars {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .about__pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
