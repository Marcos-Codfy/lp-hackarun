---
import type { LandingPageDTO } from '@application/index';
import type { IconName } from '@presentation/components/ui/icons';
import SectionHeading from '@presentation/components/ui/SectionHeading.astro';
import StatCounter from '@presentation/components/ui/StatCounter.astro';
import Marquee from '@presentation/components/ui/Marquee.astro';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import PillarCard from './about/PillarCard.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event } = Astro.props.data;
const { stats } = event;

const pillars: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'book',
    title: 'Minicursos',
    text: 'Algoritmos, testes, Git, dados e IA com prática orientada em laboratório. Todo mundo chega afiado na largada.',
  },
  {
    icon: 'cap',
    title: 'Mentoria de egressos',
    text: 'Quem já passou pelo curso orienta sua equipe em arquitetura, planejamento e boas práticas.',
  },
  {
    icon: 'route',
    title: 'Corrida de missões',
    text: 'Estações técnicas espalhadas por salas e laboratórios. Cada pista decifrada vale pontos.',
  },
  {
    icon: 'spotlight',
    title: 'Final no shopping',
    text: 'Entrega até as 15h e premiação no palco do Capim Dourado, com telão e banda ao vivo.',
  },
];

const marquee = [
  'Minicursos',
  'Mentoria',
  `${stats.stations} missões`,
  'NPCs à solta',
  new DayLabelFormatter().range(event.firstDate, event.lastDate),
  'Final no telão',
  'Palmas–TO',
];
---

<section
  id="sobre"
  class="section about"
  data-scene="nebula"
  data-checkpoint="O evento"
  aria-labelledby="sobre-title"
>
  <Marquee items={marquee} />

  <div class="container section-stack about__body">
    <SectionHeading
      id="sobre-title"
      code="01"
      eyebrow="O evento"
      title="Não é só um hackathon. É uma <em>corrida</em>."
      lead="Aprendizado na prática: minicursos, mentoria de egressos e uma corrida de missões técnicas por salas e laboratórios, até entregar uma solução final no prazo. Estudantes, professores, egressos e empresas no mesmo lugar."
    />

    <ul class="about__pillars" role="list" data-reveal-group>
      {pillars.map((pillar, index) => (
        <PillarCard index={index} {...pillar} />
      ))}
    </ul>

    <ul class="about__stats" role="list" data-reveal-group>
      <li>
        <StatCounter value={stats.days} label="dias de evento" />
      </li>
      <li>
        <StatCounter value={stats.stations} label="missões" />
      </li>
      <li>
        <StatCounter value={stats.workshops} label="minicursos" />
      </li>
      <li>
        <StatCounter value={1} label="final no telão" />
      </li>
    </ul>
  </div>
</section>

<style>
  .about {
    padding-top: 0;
  }

  .about__body {
    padding-top: var(--space-9);
  }

  .about__pillars {
    display: grid;
    gap: var(--space-4);
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--surface-line);
  }

  @media (min-width: 640px) {
    .about__pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about__pillars {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .about__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .about__stats > li + li {
      padding-left: var(--space-5);
      border-left: 1px solid var(--surface-line);
    }
  }
</style>
