---
import type { LandingPageDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import { RegistrationCopy } from '@presentation/formatters/RegistrationCopy';
import SectionHeader from './shared/SectionHeader.astro';
import TrackCard from './about/TrackCard.astro';
import AboutTicker from './about/AboutTicker.astro';
import AboutStats from './about/AboutStats.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event } = Astro.props.data;
const { stats } = event;
const stands = stats.stands;
const cta = new RegistrationCopy().cta(event.registration.status);
const ctaAttrs = cta.isRegistration ? { registrationCta: 'about' } : { 'data-nav-link': true };

const ticker = [
  'Oficinas',
  'Palestras',
  'Exposição',
  'Hackathon',
  `${stats.stations} missões`,
  'NPCs à solta',
  new DayLabelFormatter().range(event.firstDate, event.lastDate),
  'Final no Capim Dourado Shopping',
  'UNICATÓLICA',
];

const readout = [
  { value: stats.days, label: 'dias de evento' },
  { value: stats.workshops, label: 'oficinas' },
  ...(stands ? [{ value: stands, prefix: 'até', label: 'estandes na exposição' }] : []),
  { value: 1, label: 'final no Capim Dourado Shopping' },
];
---

<section
  id="sobre"
  class="section section--split about tone-blue"
  data-scene="orbit"
  data-checkpoint="O evento"
  aria-labelledby="sobre-title"
>
  <AboutTicker items={ticker} />

  <div class="container">
    <div class="section-split__content section-stack about__body">
      <SectionHeader
        id="sobre-title"
        code="01"
        eyebrow="O evento"
        title="Da sala de aula ao <em>palco</em>."
        lead="O 1º HackaRun é tecnologia, inovação e empreendedorismo na UniCatólica, em duas frentes: uma programação aberta ao público e um hackathon dos alunos, com final no palco do Capim Dourado Shopping."
      />

      <ul class="about__tracks" role="list" data-reveal-group>
        <TrackCard
          index={0}
          tone="open"
          badge="Aberto ao público"
          title="Programação aberta"
          text={`Oficinas práticas, palestras e exposição de produtos e soluções tecnológicas${stands ? ` em até ${stands} estandes` : ''}.`}
          facts={[
            { label: 'Para', value: 'Comunidade de tecnologia e estudantes do 3º ano do ensino médio' },
            { label: 'Quando', value: '11 a 13/11, a partir das 19h · UniCatólica, Bloco II' },
          ]}
        >
          <Button variant="ghost" href="#programacao" data-nav-link>
            Ver programação
          </Button>
        </TrackCard>
        <TrackCard
          index={1}
          tone="hackathon"
          badge="Só alunos da UniCatólica"
          title="Hackathon"
          text="Corrida por objetivos em equipes: encontrar pistas, cumprir missões e desenvolver soluções com programação, engenharia de software e IA."
          facts={[
            { label: 'Para', value: 'Alunos da UniCatólica, em equipes' },
            {
              label: 'Quando',
              value:
                'Lançamento em 12/11 · desenvolvimento final em 14/11, das 8h às 13h · final às 17h, no Capim Dourado Shopping',
            },
          ]}
        >
          <Button href={cta.href} {...ctaAttrs}>
            {cta.label}
          </Button>
        </TrackCard>
      </ul>

      <AboutStats stats={readout} />
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 0;
  }

  .about__body {
    padding-top: clamp(4rem, 2rem + 6vw, 8rem);
  }

  .about__tracks {
    display: grid;
    gap: var(--space-5);
  }

  /* lado a lado no tablet; no desktop a coluna do texto é estreita (o 3D fica à direita) e eles empilham */
  @media (min-width: 640px) {
    .about__tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about__tracks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
