---
import type { LandingPageDTO } from '@application/index';
// import Button from '@presentation/components/ui/Button.astro';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
// import { RegistrationCopy } from '@presentation/formatters/RegistrationCopy';
import SectionHeader from './shared/SectionHeader.astro';
import TrackCard from './about/TrackCard.astro';
import AboutTicker from './about/AboutTicker.astro';
// import AboutStats from './about/AboutStats.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event } = Astro.props.data;
//const { stats } = event;
// const stands = stats.stands;
// const cta = new RegistrationCopy().cta(event.registration.status, 'about');
// const ctaAttrs = cta.isRegistration ? { registrationCta: 'about' } : {};

// o local da final é revelado só na seção 06; aqui a fita apenas anuncia que existe uma grande final.
// Sem palestras nem exposições: saíram da programação
const ticker = [
  'Oficinas',
  'Missões',
  'Mentoria',
  'Hackathon',
  `Jogos`,
  'NPCs',
  new DayLabelFormatter().range(event.firstDate, event.lastDate),
  'Grande final',
  'UNICATÓLICA',
];

// const readout = [
//   { value: stats.days, label: 'dias de evento' },
//   { value: stats.workshops, label: 'oficinas' },
//   ...(stands ? [{ value: stands, prefix: 'até', label: 'estandes na exposição' }] : []),
//   { value: 1, label: 'final no Capim Dourado Shopping' },
// ];
---

<section
  id="sobre"
  class="section section--split about tone-blue"
  data-scene="orbit"
  data-checkpoint="O evento"
  aria-labelledby="sobre-title"
>
  <AboutTicker items={ticker} />

  <div class="container">
    <div class="section-split__content section-stack about__body">
      <SectionHeader
        id="sobre-title"
        code="01"
        eyebrow="O evento"
        title="Corra atrás da <em>sua ideia</em>."
        lead="O HackaRun 2026 é uma competição de tecnologia, inovação e empreendedorismo no formato de corrida por objetivos, na qual as equipes cumprem missões sequenciais e desenvolvem uma solução tecnológica a partir de um desafio divulgado pela organização. O evento termina com a apresentação dos projetos e a premiação."
      />

      <ul class="about__tracks" role="list" data-reveal-group>
        {/*
          facts={[
            { label: 'Para', value: 'Comunidade de tecnologia e estudantes do 3º ano do ensino médio' },
            { label: 'Quando', value: '11 a 13/11, a partir das 19h · UniCatólica, Bloco II' },
          ]}
          <Button variant="ghost" href="#programacao" data-nav-link>
            Ver programação
          </Button>
        */}
        <TrackCard
          index={0}
          tone="open"
          badge="Quem pode participar?"
          title="Público alvo"
          text="Estudantes da UniCatólica, especialmente dos cursos de Engenharia de Software e Inteligência Artificial; universitários de outras instituições; profissionais e entusiastas da área de tecnologia."
          note="Menores de 18 anos precisam de autorização do responsável legal e devem cumprir as exigências institucionais."
        />
        <TrackCard
          index={1}
          tone="open"
          badge="Inscrições & Equipes"
          title="Equipe surpresa"
          text="A inscrição deve ser feita de forma individual, pois a formação das equipes será realizada por sorteio presencial no dia 12 de novembro. Para participar do sorteio, é obrigatório estar presente e credenciado no local e horário estabelecidos. Após a definição, as equipes deverão ser mantidas até o fim da competição, salvo em situações excepcionais autorizadas pela organização."
          note="As equipes terão preferencialmente quatro integrantes, podendo chegar a cinco conforme a distribuição dos participantes pela organização."
        />
        {/*
        <TrackCard
          index={1}
          tone="hackathon"
          badge="Só alunos da UniCatólica"
          title="Hackathon"
          text="Corrida por objetivos em equipes: encontrar pistas, cumprir missões e desenvolver soluções com programação, engenharia de software e IA."
          facts={[
            { label: 'Para', value: 'Alunos da UniCatólica, em equipes' },
            {
              label: 'Quando',
              value:
                'Lançamento em 12/11 · desenvolvimento final em 14/11, das 8h às 13h · final às 17h, no Capim Dourado Shopping',
            },
          ]}
        >
          <Button href={cta.href} {...ctaAttrs}>
            {cta.label}
          </Button>
        </TrackCard>
        */}
      </ul>

      {/* <AboutStats stats={readout} /> */}
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 0;
  }

  .about__body {
    padding-top: clamp(4rem, 2rem + 6vw, 8rem);
  }

  /* minmax(0, 1fr): a trilha auto crescia até o min-content do card e cortava a borda direita em 320px */
  .about__tracks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  /* lado a lado no tablet; no desktop a coluna do texto é estreita (o 3D fica à direita) e eles empilham */
  @media (min-width: 640px) {
    .about__tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about__tracks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
