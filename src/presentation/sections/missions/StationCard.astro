---
import type { StationDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import NpcToken from '@presentation/components/npc/NpcToken.astro';
import { stationIcon } from './stationIcon';

interface Props {
  station: StationDTO;
  // null = pontuação ainda não publicada: o chip vira "?? pts" decorativo (o painel do regulamento explica)
  maxPoints: number | null;
  withToken?: boolean;
}

const { station, maxPoints, withToken = false } = Astro.props;
const isFinal = station.kind === 'final';
const titleId = `station-${station.id}`;
---

<li
  class:list={['station sx-glass sx-glass--solid sx-corners sx-hover', isFinal && 'station--final']}
  aria-labelledby={titleId}
  data-station
>
  <span class="station__node" aria-hidden="true"></span>
  <span class="station__fx" aria-hidden="true">
    <span class="station__num sx-outline-num">{Number(station.code) || station.code}</span>
  </span>
  <div class="station__top">
    <p class="sx-hud station__code">Missão {station.code}</p>
    {isFinal ? (
      <span class="station__badge">Final</span>
    ) : (
      <span class="station__pts" aria-hidden={maxPoints === null ? 'true' : undefined}>
        <b>{maxPoints ?? '??'}</b> pts
      </span>
    )}
  </div>
  <h3 class="station__title" id={titleId}>
    {station.title}
  </h3>
  <p class="station__challenge">{station.challenge}</p>
  <div class="station__foot">
    <p class="station__space">
      <Icon name={stationIcon(station.space)} size={18} />
      <span class="sr-only">Local: </span>
      {station.space}
    </p>
    <ul class="station__skills" role="list" aria-label="Habilidades">
      {station.skills.map((skill) => (
        <li class="sx-tag">{skill}</li>
      ))}
    </ul>
  </div>
  {withToken && (
    <span class="station__token">
      <NpcToken id="npc-2" label="Token NPC escondido numa missão" />
    </span>
  )}
</li>

<style>
  .station {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  /* camada recortada pros efeitos (o card em si não corta, senão some a cantoneira) */
  .station__fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .station--final {
    --sx-border: var(--grad-energy);
    background:
      radial-gradient(120% 70% at 100% 0%, rgb(148 27 255 / 0.28), transparent 60%),
      radial-gradient(90% 60% at 0% 100%, rgb(0 229 255 / 0.18), transparent 70%),
      linear-gradient(170deg, rgb(12 18 60 / 0.92), rgb(4 5 18 / 0.95));
    box-shadow: 0 0 60px -12px rgb(18 100 255 / 0.55);
  }

  /* nó da rota: o trilho desenha a linha, cada card acende o seu ponto */
  .station__node {
    display: none;
  }

  /* número vazado gigante; no hover ganha o degradê */
  .station__num {
    position: absolute;
    top: 3.6rem;
    right: 1.25rem;
    font-size: clamp(6.5rem, 5rem + 4vw, 9rem);
    -webkit-text-stroke-color: color-mix(in srgb, var(--sx-accent) 34%, transparent);
    transition:
      -webkit-text-stroke-color var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
    pointer-events: none;
  }

  .station:hover .station__num {
    -webkit-text-stroke-color: color-mix(in srgb, var(--sx-accent) 80%, transparent);
  }

  .station__top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .station__pts {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--sx-line);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .station__pts b {
    color: var(--text);
    font-weight: 700;
  }

  .station__badge {
    padding: 0.3rem 0.8rem;
    background: var(--grad-energy);
    box-shadow: 0 0 20px rgb(148 27 255 / 0.5);
    color: var(--c-void);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transform: skewX(var(--skew));
  }

  .station__title {
    position: relative;
    margin-top: clamp(4rem, 3rem + 3vw, 6rem);
    font-size: var(--fs-xl);
    line-height: 1.08;
    text-shadow: 0 2px 18px rgb(2 3 11 / 0.9);
  }

  .station__challenge {
    position: relative;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .station__foot {
    position: relative;
    display: grid;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--sx-line);
  }

  .station__space {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .station__space :global(.icon) {
    color: var(--sx-ink);
  }

  .station__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .station__token {
    position: absolute;
    top: 3.5rem;
    left: var(--space-4);
  }

  /* modo trilho horizontal (desktop com pin): largura fixa por card */
  :global(.is-horizontal) .station {
    flex: none;
    width: clamp(19rem, 23vw, 22rem);
    min-height: 27rem;
  }

  :global(.is-horizontal) .station__node {
    position: absolute;
    top: -2.05rem;
    left: 1.25rem;
    display: block;
    width: 9px;
    height: 9px;
    background: var(--c-void);
    border: 1px solid var(--sx-accent);
    transform: rotate(45deg);
    box-shadow: 0 0 12px color-mix(in srgb, var(--sx-accent) 60%, transparent);
  }

  :global(.is-horizontal) .station--final .station__node {
    background: var(--c-magenta);
    border-color: var(--c-magenta);
  }

  @media (min-width: 640px) {
    .station {
      padding: var(--space-6);
    }
  }
</style>
