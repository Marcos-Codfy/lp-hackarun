---
import Icon from '@presentation/components/ui/Icon.astro';
import RegulationLink from '@presentation/components/registration/RegulationLink.astro';
import ScoreMeter from './ScoreMeter.astro';
import { SCORING_WEIGHTS } from './scoringWeights';

// enquanto o regulamento não sai: o que ele vai trazer e quando, no lugar do painel de pontuação.
// O tópico da pontuação mostra o peso de cada critério em medidores (um bloco a cada 5%); os outros só levam
// um fio divisor. O PDF completo vira um cartão de download, o mesmo da página de inscrição
interface Props {
  // "12.11", "19h35", "12 de novembro" e o horário do lançamento do desafio ("19h55")
  date: string;
  hour: string;
  dateLong: string;
  // não aparece mais no painel; segue opcional porque o MissionsSection ainda passa
  launchAt?: string | null;
}

const { date, hour, dateLong } = Astro.props;
// resumo de cada tópico do regulamento (o texto completo é apresentado na abertura)
interface Topic {
  title: string;
  text: string;
  // mostra os pesos dos critérios em medidores logo abaixo do texto
  weights?: boolean;
}

const topics: Topic[] = [
  {
    title: 'Regras da competição',
    text: 'Cumprir as missões e os prazos, respeitar a autoria dos materiais e garantir que a solução funcione. Fraude ou plágio podem custar pontos ou a desclassificação.',
  },
  {
    title: 'Critérios de pontuação',
    text: 'Banca com notas de 0 a 10, com estes pesos na nota final:',
    weights: true,
  },
  {
    title: 'Prazos',
    text: 'Missões de 12 a 14/11, com entrega final até às 13h do dia 14. Pitch presencial das 17h30 às 18h30 do mesmo dia.',
  },
  {
    title: 'Uso de inteligência artificial',
    text: 'Liberado na ideação, no código, nos testes e na documentação, desde que declarado. A equipe responde pelo que a IA gerar.',
  },
  {
    title: 'Critérios de desempate',
    text: 'Maior nota em funcionalidade, depois qualidade técnica, missões e evidências e pitch presencial. Persistindo o empate, a banca decide.',
  },
];
---

<div class="rulebook sx-glass sx-corners" data-reveal="up">
  <div class="rulebook__grid">
    <div class="rulebook__intro">
      <p class="rulebook__meta">
        <span class="rulebook__code" aria-hidden="true">
          03
        </span>
        <span class="rulebook__rule" aria-hidden="true"></span>
        <span class="rulebook__eyebrow">Regulamento</span>
      </p>
      <h3 class="rulebook__title">As regras serão apresentadas na abertura.</h3>
      <p class="rulebook__stamp sx-grad-text">
        <span aria-hidden="true">
          {date} · {hour.toUpperCase()}
        </span>
        <span class="sr-only">
          {dateLong}, às {hour}
        </span>
      </p>
      {/* o regulamento só baixa (download + Content-Disposition no public/_headers), como no rodapé e no FAQ */}
      <div class="rulebook__download">
        <RegulationLink title="Confira o regulamento completo" />
      </div>
    </div>

    <ul class="rulebook__list" role="list" aria-label="O que o regulamento traz">
      {topics.map((topic) => (
        <li class="rule">
          <div class="rule__head">
            <span class="rule__label">{topic.title}</span>
            <span class="rule__lock" aria-hidden="true">
              <Icon name="lock" size={14} />
              {date}
            </span>
          </div>
          <p class="rule__text">{topic.text}</p>
          {topic.weights && (
            <ul class="rule__weights" role="list" aria-label="Peso de cada critério na nota final" data-bars>
              {SCORING_WEIGHTS.map((criterion) => (
                <ScoreMeter label={criterion.label} share={criterion.weight / 100} compact>
                  <b>{criterion.weight}%</b>
                </ScoreMeter>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .rulebook {
    padding: var(--space-6) var(--space-5);
  }

  .rulebook__grid {
    display: grid;
    gap: var(--space-7);
  }

  .rulebook__intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  /* mesmo selo das outras seções (o "02" dos NPCs): número no paralelogramo + fio + nome */
  .rulebook__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 500;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .rulebook__code {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 1.5rem;
    padding-inline: 0.4rem;
    border: 1px solid color-mix(in srgb, var(--sx-accent) 60%, transparent);
    background: color-mix(in srgb, var(--sx-accent) 16%, transparent);
    box-shadow: 0 0 16px color-mix(in srgb, var(--sx-accent) 30%, transparent);
    color: var(--text);
    letter-spacing: 0.08em;
    transform: skewX(var(--skew));
  }

  .rulebook__rule {
    width: clamp(1.5rem, 4vw, 3.5rem);
    height: 1px;
    background: linear-gradient(90deg, var(--sx-accent), transparent);
  }

  .rulebook__eyebrow {
    color: var(--sx-ink);
  }

  /* o cartão do PDF respira do selo de cima e fica na largura da coluna */
  .rulebook__download {
    margin-top: var(--space-3);
  }

  .rulebook__title {
    font-size: var(--fs-2xl);
    line-height: 1.1;
  }

  .rulebook__stamp {
    justify-self: start;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.6rem);
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    filter: drop-shadow(0 0 20px rgb(0 229 255 / 0.45));
  }

  .rulebook__list {
    display: grid;
    gap: var(--space-4);
  }

  .rule__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-size: var(--fs-sm);
  }

  .rule__label {
    color: var(--text);
    font-weight: 600;
  }

  .rule__text {
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .rule__lock {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.12em;
  }

  .rule__lock :global(.icon) {
    color: var(--sx-ink);
  }

  /* um fio entre os tópicos separa o que o regulamento traz sem precisar de medidor em cada um */
  .rule + .rule {
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--sx-accent) 20%, transparent);
  }

  .rule__weights {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  @media (min-width: 640px) {
    .rulebook {
      padding: var(--space-7);
    }
  }

  @media (min-width: 1024px) {
    .rulebook__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      gap: var(--space-8);
    }
  }
</style>
