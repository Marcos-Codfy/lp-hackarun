---
import type { ScoringDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';

interface Props {
  scoring: ScoringDTO;
}

const { scoring } = Astro.props;
---

<div class="scoring sx-glass sx-corners" data-reveal="up">
  <div class="scoring__grid">
    <div class="scoring__intro">
      <p class="sx-hud">// Pontuação por estação</p>
      <h3 class="scoring__title">
        Até <span class="scoring__max sx-grad-text">{scoring.maxPoints}</span> pontos por estação
      </h3>
      <p class="section-note section-note--time scoring__note">
        <Icon name="clock" />
        <span>
          <strong>O tempo nunca vale mais que a correção técnica.</strong> A missão final tem avaliação
          própria da banca.
        </span>
      </p>
    </div>

    <ul class="scoring__bars" role="list" data-bars>
      {scoring.criteria.map((criterion) => (
        <li class:list={['meter', criterion.key === 'time' && 'meter--time']}>
          <div class="meter__head">
            <span class="meter__label">{criterion.label}</span>
            <span class="meter__pts">
              <b>{criterion.points}</b> pts
            </span>
          </div>
          <span class="meter__track" aria-hidden="true">
            <span class="meter__fill" data-bar-fill style={`--share: ${criterion.share}`}></span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .scoring {
    padding: var(--space-6) var(--space-5);
  }

  .scoring__grid {
    display: grid;
    gap: var(--space-7);
  }

  .scoring__intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .scoring__title {
    font-size: var(--fs-2xl);
    line-height: 1.1;
  }

  .scoring__max {
    display: inline-block;
    font-size: 1.6em;
    font-weight: 900;
    line-height: 0.9;
    vertical-align: -0.12em;
    filter: drop-shadow(0 0 20px rgb(0 229 255 / 0.45));
  }

  .scoring__bars {
    display: grid;
    gap: var(--space-5);
  }

  .meter__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-size: var(--fs-sm);
  }

  .meter__label {
    color: var(--text);
    font-weight: 600;
  }

  .meter__pts {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .meter__pts b {
    color: var(--sx-ink);
    font-weight: 700;
  }

  /* medidor segmentado: a máscara fica no trilho, então o preenchimento cresce sem distorcer os blocos */
  .meter__track {
    position: relative;
    display: block;
    height: 10px;
    background: rgb(143 243 255 / 0.1);
    -webkit-mask: repeating-linear-gradient(90deg, #000 0 calc(5% - 3px), transparent calc(5% - 3px) 5%);
    mask: repeating-linear-gradient(90deg, #000 0 calc(5% - 3px), transparent calc(5% - 3px) 5%);
  }

  .meter__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--share) * 100%);
    background: var(--grad-blue);
    transform-origin: left center;
  }

  .meter--time .meter__pts b {
    color: var(--ink-orange);
  }

  .meter--time .meter__fill {
    background: linear-gradient(90deg, var(--c-gold), var(--c-orange));
  }

  @media (min-width: 640px) {
    .scoring {
      padding: var(--space-7);
    }
  }

  @media (min-width: 1024px) {
    .scoring__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      gap: var(--space-8);
    }
  }
</style>
