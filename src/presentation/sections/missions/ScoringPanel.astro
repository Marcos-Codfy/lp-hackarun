---
import type { ScoringDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import ScoreMeter from './ScoreMeter.astro';

interface Props {
  scoring: ScoringDTO;
}

const { scoring } = Astro.props;
---

<div class="scoring sx-glass sx-corners" data-reveal="up">
  <div class="scoring__grid">
    <div class="scoring__intro">
      <p class="sx-hud">// Pontuação por estação</p>
      <h3 class="scoring__title">
        Até <span class="scoring__max sx-grad-text">{scoring.maxPoints}</span> pontos por estação
      </h3>
      <p class="section-note section-note--time scoring__note">
        <Icon name="clock" />
        <span>
          <strong>O tempo nunca vale mais que a correção técnica.</strong> A missão final tem avaliação
          própria da banca.
        </span>
      </p>
    </div>

    <ul class="scoring__bars" role="list" data-bars>
      {scoring.criteria.map((criterion) => (
        <ScoreMeter
          label={criterion.label}
          share={criterion.share}
          tone={criterion.key === 'time' ? 'time' : 'default'}
        >
          <b>{criterion.points}</b> pts
        </ScoreMeter>
      ))}
    </ul>
  </div>
</div>

<style>
  .scoring {
    padding: var(--space-6) var(--space-5);
  }

  .scoring__grid {
    display: grid;
    gap: var(--space-7);
  }

  .scoring__intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .scoring__title {
    font-size: var(--fs-2xl);
    line-height: 1.1;
  }

  .scoring__max {
    display: inline-block;
    font-size: 1.6em;
    font-weight: 900;
    line-height: 0.9;
    vertical-align: -0.12em;
    filter: drop-shadow(0 0 20px rgb(0 229 255 / 0.45));
  }

  .scoring__bars {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .scoring {
      padding: var(--space-7);
    }
  }

  @media (min-width: 1024px) {
    .scoring__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      gap: var(--space-8);
    }
  }
</style>
