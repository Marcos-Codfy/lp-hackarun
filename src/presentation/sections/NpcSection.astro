---
import type { LandingPageDTO } from '@application/index';
import SectionHeader from './shared/SectionHeader.astro';
import QuestLog from './npc/QuestLog.astro';
// import NpcTerminal from './npc/NpcTerminal.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

// seção não depende de dados por enquanto; a prop fica pelo contrato da página
const { data: _data } = Astro.props;
---

<section
  id="npcs"
  class="section section--split npcs tone-violet"
  data-scene="enigma"
  data-checkpoint="NPCs"
  aria-labelledby="npcs-title"
>
  <span class="npcs__haze" aria-hidden="true"></span>
  <div class="container">
    <div class="section-split__content section-stack npcs__content">
      <SectionHeader
        id="npcs-title"
        code="02"
        eyebrow="NPCs"
        title="Os <em>NPCs</em> estão entre nós."
        lead="Além de desenvolver seus projetos e pensar em soluções criativas, as equipes terão um período dedicado a missões, contando com os NPCs para encontrar pistas, descobrir informações e desvendar os desafios que surgirem pelo caminho."
      />

      {/*
      <div data-reveal="up">
        <NpcTerminal />
      </div>
      */}

      <QuestLog />
    </div>
  </div>
</section>

<style>
  .npcs {
    min-height: 100svh;
    overflow: clip;
  }

  .npcs__content {
    gap: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
  }

  /* névoa violeta atrás do texto: amarra a seção à cor do enigma */
  .npcs__haze {
    position: absolute;
    top: 10%;
    left: -10%;
    z-index: -1;
    width: 60vw;
    height: 70%;
    background: radial-gradient(closest-side, rgb(148 27 255 / 0.18), transparent);
    filter: blur(20px);
    pointer-events: none;
  }
</style>
