---
import type { LandingPageDTO } from '@application/index';
import { EventStampFormatter } from '@presentation/formatters/EventStampFormatter';
import { ScheduleLookup } from '@presentation/formatters/ScheduleLookup';
import SectionHeader from './shared/SectionHeader.astro';
import SpotlightBeams from './final/SpotlightBeams.astro';
import FinalVenue from './final/FinalVenue.astro';
import RunOfShow from './final/RunOfShow.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event, schedule } = Astro.props.data;
const venue = event.venues.find((v) => v.role === 'final');
const ceremonyAt = event.milestones.find((m) => m.key === 'ceremony')?.at ?? null;
const stamp = ceremonyAt ? new EventStampFormatter(event.timezone).format(ceremonyAt) : null;
// roteiro e horário da premiação saem do bloco da final na programação
const lookup = new ScheduleLookup(schedule);
const experience = lookup.finalSession();
const awards = lookup.activity('awards');
---

<section
  id="final"
  class="section section--split final tone-gold"
  data-scene="stage"
  data-checkpoint="Grande final"
  aria-labelledby="final-title"
  data-spotlight
>
  <SpotlightBeams />

  <div class="container">
    <div class="section-split__content section-stack final__content">
      <SectionHeader
        id="final-title"
        code="06"
        eyebrow="Grande final"
        size="sm"
        title="A final é no <em>Capim Dourado Shopping</em>."
      />

      {stamp && ceremonyAt && (
        <div class="final__when" data-reveal="up">
          {experience && <p class="final__kicker sx-hud">// {experience.title}</p>}
          <p class="final__stamp">
            <time datetime={ceremonyAt}>
              <span aria-hidden="true">
                <span class="final__date">{stamp.date}</span>
                <span class="final__hour">{stamp.hour}</span>
              </span>
              <span class="sr-only">{stamp.long}</span>
            </time>
          </p>
          <p class="final__line">
            A partir das {stamp.hour.toLowerCase()}
            {awards && <> · premiação oficial às {lookup.startOf(awards)}</>}
          </p>
        </div>
      )}

      {venue && <FinalVenue venue={venue} />}

      {experience && <RunOfShow activities={experience.activities} />}

      <p class="final__cheer sx-grad-text" data-reveal="up">
        Chame sua torcida.
      </p>
    </div>
  </div>
</section>

<style>
  .final {
    min-height: 100svh;
    overflow: clip;
  }

  .final__content {
    gap: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
  }

  /* trava "A final é no / Capim Dourado / Shopping." sem partir o nome do shopping (cabe 9,8em por linha) */
  .final__content :global(.sx-head__title) {
    max-width: 10.5em;
  }

  .final__stamp time > span[aria-hidden] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.3em;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 1.8rem + 5.6vw, 6.4rem);
    font-weight: 900;
    line-height: 0.88;
    /* sem o respiro, a bandeira do 1 encosta na barra do 7 e "17H" vira "ПH" */
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .final__date {
    color: var(--text);
    text-shadow:
      0 0 30px rgb(255 236 200 / 0.25),
      0 2px 30px rgb(2 3 11 / 0.8);
  }

  .final__hour {
    background: linear-gradient(100deg, #ffe7a3 0%, var(--c-gold) 30%, var(--c-orange) 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 26px rgb(255 133 47 / 0.6));
  }

  .final__when {
    display: grid;
    gap: var(--space-3);
  }

  .final__line {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .final__cheer {
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    filter: drop-shadow(0 0 24px rgb(255 133 47 / 0.45));
  }
</style>
