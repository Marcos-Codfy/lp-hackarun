---
import type { LandingPageDTO } from '@application/index';
import type { IconName } from '@presentation/components/ui/icons';
import Icon from '@presentation/components/ui/Icon.astro';
import { EventStampFormatter } from '@presentation/formatters/EventStampFormatter';
import SectionHeader from './shared/SectionHeader.astro';
import SpotlightBeams from './final/SpotlightBeams.astro';
import FinalVenue from './final/FinalVenue.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event } = Astro.props.data;
const venue = event.venues.find((v) => v.role === 'final');
const ceremonyAt = event.milestones.find((m) => m.key === 'ceremony')?.at ?? null;
const stamp = ceremonyAt ? new EventStampFormatter(event.timezone).format(ceremonyAt) : null;

const highlights: { icon: IconName; label: string }[] = [
  { icon: 'spotlight', label: 'Palco iluminado' },
  { icon: 'monitor', label: 'Telão gigante com o ranking' },
  { icon: 'music', label: 'Banda ao vivo' },
  { icon: 'crown', label: 'Anúncio dos campeões' },
];
---

<section
  id="final"
  class="section section--split final tone-gold"
  data-scene="stage"
  data-checkpoint="Grande final"
  aria-labelledby="final-title"
  data-spotlight
>
  <SpotlightBeams />

  <div class="container">
    <div class="section-split__content section-stack final__content">
      <SectionHeader id="final-title" code="06" eyebrow="Grande final" title="A final é no <em>telão</em>." />

      {stamp && ceremonyAt && (
        <p class="final__stamp" data-reveal="up">
          <time datetime={ceremonyAt}>
            <span aria-hidden="true">
              <span class="final__date">{stamp.date}</span>
              <span class="final__hour">{stamp.hour}</span>
            </span>
            <span class="sr-only">{stamp.long}</span>
          </time>
        </p>
      )}

      {venue && <FinalVenue venue={venue} />}

      <ul class="final__highlights" role="list" data-reveal-group>
        {highlights.map((item) => (
          <li class="sx-glass sx-glass--solid sx-hover">
            <span class="sx-icon">
              <Icon name={item.icon} size={18} />
            </span>
            <span>{item.label}</span>
          </li>
        ))}
      </ul>

      <p class="final__cheer sx-grad-text" data-reveal="up">
        Chame sua torcida.
      </p>
    </div>
  </div>
</section>

<style>
  .final {
    min-height: 100svh;
    overflow: clip;
  }

  .final__content {
    gap: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
  }

  .final__stamp time > span[aria-hidden] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.3em;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 1.8rem + 5.6vw, 6.4rem);
    font-weight: 900;
    line-height: 0.88;
    font-variant-numeric: tabular-nums;
  }

  .final__date {
    color: var(--text);
    text-shadow:
      0 0 30px rgb(255 236 200 / 0.25),
      0 2px 30px rgb(2 3 11 / 0.8);
  }

  .final__hour {
    background: linear-gradient(100deg, #ffe7a3 0%, #ffc24a 30%, #ff852f 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 26px rgb(255 133 47 / 0.6));
  }

  .final__highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .final__highlights li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4.5rem;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .final__highlights .sx-icon {
    width: 2.25rem;
    height: 2.25rem;
  }

  .final__cheer {
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    filter: drop-shadow(0 0 24px rgb(255 133 47 / 0.45));
  }

  /* celular estreito: ícone em cima do texto pra caber em 2 colunas */
  @media (max-width: 479px) {
    .final__highlights li {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--space-4);
    }
  }
</style>
