---
import type { LandingPageDTO } from '@application/index';
import SectionHeader from './shared/SectionHeader.astro';
import DayTabs from './schedule/DayTabs.astro';
import DayPanel from './schedule/DayPanel.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { schedule } = Astro.props.data;
const days = schedule.length;
// âncora de cada dia: #dia-11 ... #dia-14
const panelId = (date: string) => `dia-${date.slice(8, 10)}`;
---

<section
  id="programacao"
  class="section schedule tone-blue"
  data-scene="terrain"
  data-checkpoint="Programação"
  aria-labelledby="programacao-title"
>
  <div class="container section-stack">
    <SectionHeader
      id="programacao-title"
      code="04"
      eyebrow="Programação"
      title={`${days} dias de <em>programação</em>.`}
      lead="Oficinas de capacitação em 11/11, abertura e sorteio das equipes em 12/11 e desenvolvimento em 13/11. O hackathon termina no dia 14, no Capim Dourado Shopping."
    />

    <div class="days" data-day-tabs>
      <DayTabs days={schedule} panelId={panelId} />
      <div class="days__panels sx-corners">
        {schedule.map((day) => (
          <DayPanel day={day} id={panelId(day.date)} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .days {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  /* sem JS: os quatro dias empilhados, com respiro de linha do tempo entre eles */
  .days__panels {
    display: grid;
    gap: clamp(4rem, 3rem + 3vw, 6.5rem);
  }

  /* as cantoneiras de HUD só existem em volta do painel das abas */
  .days:not(.is-tabbed) .days__panels::after {
    display: none;
  }

  /* painel do dia em vidro escuro: lê bem por cima do terreno 3D */
  .days.is-tabbed .days__panels {
    --sx-corner: color-mix(in srgb, var(--sx-accent) 90%, white 10%);
    position: relative;
    padding: var(--space-6) var(--space-4) var(--space-2);
    border-radius: 3px;
    background:
      radial-gradient(120% 60% at 0% 0%, rgb(47 107 255 / 0.12), transparent 60%),
      linear-gradient(170deg, rgb(8 11 36 / 0.86), rgb(3 4 16 / 0.92));
    box-shadow:
      inset 0 0 0 1px rgb(140 160 255 / 0.12),
      0 40px 80px -48px rgb(0 0 0 / 0.95);
  }

  @media (min-width: 640px) {
    .days.is-tabbed .days__panels {
      padding: var(--space-7) var(--space-6) var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .days.is-tabbed {
      grid-template-columns: minmax(15rem, 0.32fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }

    .days.is-tabbed > :global(.day-tabs) {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }

    .days.is-tabbed .days__panels {
      padding: var(--space-7) var(--space-7) var(--space-5);
    }
  }
</style>
