---
import type { LandingPageDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import SectionHeader from './shared/SectionHeader.astro';
import DayRound from './schedule/DayRound.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { schedule } = Astro.props.data;
const days = schedule.length;
---

<section
  id="programacao"
  class="section schedule tone-blue"
  data-scene="terrain"
  data-checkpoint="Programação"
  aria-labelledby="programacao-title"
>
  <div class="container section-stack">
    <div class="schedule__head">
      <SectionHeader
        id="programacao-title"
        code="04"
        eyebrow="Programação"
        title={`${days} dias. <em>${days} rounds.</em>`}
        lead="Capacitação, lançamento, corrida e final. Cada noite é um round, e o último termina no palco."
      />
      <div class="schedule__agenda" data-reveal="up">
        <Button variant="ghost" href="/hackarun-2026.ics" download="hackarun-2026.ics">
          Adicionar à agenda
          <Icon slot="icon" name="calendar" size={18} />
        </Button>
        <p class="schedule__agenda-hint">Arquivo .ics com todos os horários</p>
      </div>
    </div>

    <div class="timeline" data-timeline>
      <span class="timeline__rail" aria-hidden="true">
        <span class="timeline__fill" data-timeline-fill></span>
      </span>
      <ol class="timeline__list" role="list">
        {schedule.map((day, index) => (
          <DayRound day={day} index={index} />
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .schedule__head {
    display: grid;
    gap: var(--space-6);
  }

  .schedule__agenda {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .schedule__agenda-hint {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .timeline {
    position: relative;
  }

  /* trilho da linha do tempo; o preenchimento "desenha" com o scroll e termina em laranja (a final) */
  .timeline__rail {
    position: absolute;
    top: 0.75rem;
    bottom: 0;
    left: 0;
    width: 1px;
    background: rgb(157 188 255 / 0.16);
  }

  .timeline__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--c-cyan), var(--c-electric) 62%, var(--c-orange));
    box-shadow: 0 0 12px rgb(0 229 255 / 0.7);
    transform-origin: top center;
  }

  .timeline__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(4rem, 3rem + 3vw, 6.5rem);
  }

  @media (min-width: 1024px) {
    .schedule__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .schedule__agenda {
      justify-items: end;
      text-align: end;
    }
  }
</style>
