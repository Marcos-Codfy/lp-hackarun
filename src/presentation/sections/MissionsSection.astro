---
import type { LandingPageDTO } from '@application/index';
import SectionHeader from './shared/SectionHeader.astro';
import { ScheduleLookup } from '@presentation/formatters/ScheduleLookup';
import StationCard from './missions/StationCard.astro';
import ScoringPanel from './missions/ScoringPanel.astro';
import RulebookPanel from './missions/RulebookPanel.astro';
import './sections.css';
// trilho de deslizar do celular e a grade a partir de 640px
import './missions/missions-rail.css';

interface Props {
  data: LandingPageDTO;
}

const { missions, schedule } = Astro.props.data;
const { stations, scoring } = missions;
// sem pontuação publicada, o painel mostra quando sai o regulamento (horário lido da programação)
const lookup = new ScheduleLookup(schedule);
const rulebook = lookup.activity('rulebook');
const launch = lookup.activity('challenge-launch');
const total = stations.length;
const pad = (n: number) => String(n).padStart(2, '0');
// token npc-2 fica na 5ª estação (Detetives de Dados); se a lista encolher, vai pra última
const tokenIndex = Math.min(4, total - 1);
---

<section
  id="missoes"
  class="section missions tone-cyan"
  data-scene="map"
  data-checkpoint="Missões"
  aria-labelledby="missoes-title"
  data-missions
>
  <div class="container section-stack">
    {/* canto superior direito fica livre: é onde o mapa 3D das missões aparece */}
    <div class="missions__head">
      <SectionHeader
        id="missoes-title"
        code="03"
        eyebrow="Missões"
        title={`${total} missões. <em>1 relógio.</em>`}
        lead="Uma corrida por objetivos: encontre pistas, cumpra missões e desenvolva soluções com programação, engenharia de software e IA. Pontuação, prazos e desempate saem no regulamento."
      />
    </div>

    <div class="missions__pin" data-missions-pin>
      <ol
        class="missions__track"
        role="list"
        aria-label="Estações da corrida"
        data-missions-track
        data-reveal-group
      >
        {stations.map((station, index) => (
          <StationCard
            station={station}
            maxPoints={scoring?.maxPoints ?? null}
            withToken={index === tokenIndex}
          />
        ))}
      </ol>

      <div class="missions__progress" aria-hidden="true">
        <span class="missions__count">
          <b data-missions-current>01</b>
          <span>/ {pad(total)}</span>
        </span>
        <span class="missions__bar">
          <span class="missions__bar-fill" data-missions-bar></span>
        </span>
        <span class="sx-hud missions__hint">
          <span class="missions__hint-pin">Role para avançar</span>
          <span class="missions__hint-rail">Deslize</span> &raquo;
        </span>
      </div>
    </div>

    {scoring ? (
      <ScoringPanel scoring={scoring} />
    ) : (
      rulebook && (
        <RulebookPanel
          date={lookup.shortDate(rulebook.day).replace('/', '.')}
          hour={lookup.startOf(rulebook)}
          dateLong={lookup.longDate(rulebook.day)}
          launchAt={launch ? lookup.startOf(launch) : null}
        />
      )
    )}
  </div>
</section>

<style>
  .missions__head {
    max-width: 44rem;
  }

  @media (min-width: 1024px) {
    .missions__track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* trilho horizontal: o JS liga essa classe só no desktop sem reduced motion */
  .missions.is-horizontal .missions__pin {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-top: 2.5rem;
    padding-inline: max(var(--gutter), (100vw - var(--container)) / 2);
    overflow-x: clip;
  }

  .missions.is-horizontal .missions__track {
    position: relative;
    display: flex;
    width: max-content;
    gap: var(--space-5);
    will-change: transform;
  }

  /* a rota: linha tracejada que liga os nós de cada missão */
  .missions.is-horizontal .missions__track::before {
    content: '';
    position: absolute;
    top: -1.6rem;
    right: 0;
    left: 0;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--line-strong) 0 8px, transparent 8px 14px);
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }

  .missions.is-horizontal .missions__progress {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .missions__count {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .missions__count b {
    color: var(--text);
    font-size: var(--fs-2xl);
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 0 22px rgb(0 229 255 / 0.5);
  }

  .missions__bar {
    position: relative;
    flex: 1;
    max-width: 28rem;
    height: 2px;
    background: rgb(143 243 255 / 0.12);
  }

  .missions__bar-fill {
    position: absolute;
    inset: 0;
    background: var(--grad-energy);
    box-shadow: 0 0 12px rgb(0 229 255 / 0.7);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .missions__hint {
    margin-left: auto;
    color: var(--text-dim);
  }
</style>
