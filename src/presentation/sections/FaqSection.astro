---
import type { FaqItemDTO, LandingPageDTO } from '@application/index';
import { ScheduleLookup } from '@presentation/formatters/ScheduleLookup';
import { registrationHref } from '@presentation/view-models/registration/registrationOrigin';
import SectionHeader from './shared/SectionHeader.astro';
import FaqEntry from './faq/FaqEntry.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { faq, schedule } = Astro.props.data;
const lookup = new ScheduleLookup(schedule);
const rulebook = lookup.activity('rulebook');
const rulebookAt = rulebook
  ? ` O regulamento do hackathon é apresentado em ${lookup.shortDate(rulebook.day)}, às ${lookup.startOf(rulebook)}.`
  : '';

// agrupa por categoria mantendo a ordem do conteúdo (Evento, Programação aberta, Hackathon, Inscrição)
const groups = new Map<string, FaqItemDTO[]>();
for (const item of faq) groups.set(item.category, [...(groups.get(item.category) ?? []), item]);

// token npc-3 mora na resposta sobre os NPCs (só aparece pra quem abre); senão vai na última
const tokenId = faq.find((item) => item.id === 'npcs')?.id ?? faq.at(-1)?.id;
const numberOf = (item: FaqItemDTO) => faq.indexOf(item) + 1;
// a inscrição mora na própria página: a resposta sobre ela leva até lá (fechada, não tem pra onde levar)
const signupLink =
  Astro.props.data.event.registration.status === 'closed'
    ? null
    : { href: registrationHref('faq'), label: 'Ir para a página de inscrição' };
---

<section
  id="faq"
  class="section faq tone-cyan"
  data-scene="dust"
  data-checkpoint="FAQ"
  aria-labelledby="faq-title"
>
  <div class="container faq__layout">
    <div class="faq__aside">
      <SectionHeader
        id="faq-title"
        code="09"
        eyebrow="FAQ"
        size="sm"
        title="Perguntas <em>frequentes</em>"
        lead={`Evento, programação aberta, hackathon e inscrição: o essencial, separado por assunto.${rulebookAt}`}
      />
    </div>

    <div class="faq__groups">
      {[...groups.entries()].map(([category, items]) => (
        <div class="faq__group sx-glass sx-corners" data-reveal="up">
          <h3 class="faq__category">
            <span class="faq__category-dot" aria-hidden="true"></span>
            {category}
            <span class="faq__category-count" aria-hidden="true">
              {String(items.length).padStart(2, '0')}
            </span>
          </h3>
          <div class="faq__entries">
            {items.map((item) => (
              <FaqEntry
                item={item}
                number={numberOf(item)}
                withToken={item.id === tokenId}
                link={item.id === 'signup' ? signupLink : null}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__layout {
    display: grid;
    gap: var(--space-7);
  }

  .faq__groups {
    display: grid;
    gap: var(--space-5);
  }

  .faq__group {
    padding: var(--space-2);
  }

  .faq__category {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-3);
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 500;
    letter-spacing: var(--tracking-hud);
    line-height: 1.6;
  }

  .faq__category-dot {
    width: 6px;
    height: 6px;
    background: var(--c-cyan);
    box-shadow: 0 0 10px var(--c-cyan);
    transform: rotate(45deg);
  }

  .faq__category-count {
    margin-left: auto;
    color: var(--text-dim);
  }

  .faq__entries {
    border-top: 1px solid rgb(0 229 255 / 0.16);
  }

  @media (min-width: 1024px) {
    .faq__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-8);
      align-items: start;
    }

    .faq__aside {
      position: sticky;
      top: calc(var(--header-h) + var(--space-7));
    }
  }
</style>
