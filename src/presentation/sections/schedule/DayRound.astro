---
import type { EventDayDTO } from '@application/index';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import SessionItem from './SessionItem.astro';

interface Props {
  day: EventDayDTO;
  index: number;
}

const { day, index } = Astro.props;
const label = new DayLabelFormatter().format(day.date);
const round = String(index + 1).padStart(2, '0');
const isFinal = day.stage === 'final';
---

<li class:list={['round', isFinal && 'round--final']} data-timeline-node>
  <span class="round__node" aria-hidden="true"></span>
  <div class="round__aside">
    <div class="round__head">
      <p class="round__tag">
        Round {round}
        {isFinal && <span class="round__tag-final">Final</span>}
      </p>
      <p class="round__date">
        <time datetime={day.date}>
          <span aria-hidden="true">
            <span class="round__day">{label.day}</span>
            <span class="round__month">
              {label.month}
              <span class="round__weekday">{label.weekday}</span>
            </span>
          </span>
          <span class="sr-only">{label.long}</span>
        </time>
      </p>
    </div>
    <h3 class="round__title">{day.title}</h3>
    <p class="round__summary">{day.summary}</p>
  </div>
  <ul class="round__sessions" role="list">
    {day.sessions.map((session) => (
      <SessionItem session={session} />
    ))}
  </ul>
</li>

<style>
  .round {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-left: var(--space-6);
  }

  /* nó na linha do tempo; acende quando o scroll chega (classe vem do TimelineAnimator) */
  .round__node {
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 15px;
    height: 15px;
    transform: translateX(-7px) rotate(45deg);
    background: var(--c-void);
    border: 1px solid color-mix(in srgb, var(--sx-accent) 70%, transparent);
    transition:
      background var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .round.is-reached .round__node {
    background: var(--c-cyan);
    border-color: var(--c-cyan);
    box-shadow:
      0 0 14px var(--c-cyan),
      0 0 34px rgb(18 100 255 / 0.7);
  }

  .round--final.is-reached .round__node {
    background: var(--c-orange);
    border-color: var(--c-orange);
    box-shadow:
      0 0 14px var(--c-orange),
      0 0 34px rgb(255 194 74 / 0.5);
  }

  .round__aside {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .round__head {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .round__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.3rem 0.75rem;
    background: color-mix(in srgb, var(--sx-accent) 22%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sx-accent) 60%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
    transform: skewX(var(--skew));
  }

  .round__tag-final {
    padding: 0.05rem 0.4rem;
    background: var(--c-orange);
    color: var(--c-void);
  }

  .round--final .round__tag {
    background: rgb(255 133 47 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(255 133 47 / 0.6);
  }

  .round__date time > span[aria-hidden] {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .round__day {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2.2rem + 2.8vw, 4.5rem);
    font-weight: 900;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
    background: var(--sx-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 22px color-mix(in srgb, var(--sx-accent) 50%, transparent));
  }

  .round--final .round__day {
    background: linear-gradient(100deg, #ffd27a, var(--c-orange));
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 0 22px rgb(255 133 47 / 0.5));
  }

  .round__month {
    display: grid;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0.08em;
  }

  .round__weekday {
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 500;
    letter-spacing: var(--tracking-hud);
  }

  .round--final .round__weekday {
    color: var(--ink-orange);
  }

  .round__title {
    font-size: var(--fs-2xl);
    text-shadow: 0 2px 22px rgb(2 3 11 / 0.9);
  }

  .round__summary {
    max-width: 30rem;
    color: var(--text-muted);
    text-shadow: 0 1px 14px rgb(2 3 11 / 0.95);
  }

  .round__sessions {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .round {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      column-gap: var(--space-8);
      padding-left: var(--space-7);
    }
  }
</style>
