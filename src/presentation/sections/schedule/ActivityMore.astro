---
import type { ActivityDTO } from '@application/index';

// texto longo da atividade (miniementa, atividades previstas) num <details>: a lista fica limpa e abre quem quer
interface Props {
  activity: ActivityDTO;
}

const { activity } = Astro.props;
const hasMore = Boolean(activity.details) || activity.checklist.length > 0 || Boolean(activity.speaker);
const speaker = activity.speaker;
const label = activity.kind === 'workshop' ? 'Miniementa' : 'Detalhes';
---

{hasMore && (
  <details class="more">
    <summary class="more__summary">
      <span class="more__icon" aria-hidden="true" />
      {label}
      <span class="sr-only">: {activity.title}</span>
    </summary>
    <div class="more__body">
      {activity.details && <p>{activity.details}</p>}
      {activity.checklist.length > 0 && (
        <>
          <p class="more__caption">Atividades previstas</p>
          <ul class="more__list" role="list">
            {activity.checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}
      {speaker && (
        <>
          <p class="more__caption">{speaker.name ? `Sobre ${speaker.name}` : 'Sobre o palestrante'}</p>
          <p class:list={[!speaker.bio && 'more__pending']}>{speaker.bio ?? 'Mini currículo em breve.'}</p>
        </>
      )}
    </div>
  </details>
)}

<style>
  .more {
    width: 100%;
    margin-top: var(--space-1);
    interpolate-size: allow-keywords;
  }

  /* cara de botão: contorno e fundo suave deixam claro que dá pra tocar */
  .more__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.5rem;
    padding: var(--space-1) var(--space-4) var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--sx-accent) 45%, transparent);
    background: color-mix(in srgb, var(--sx-accent) 9%, transparent);
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    border-radius: 2px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .more__summary::-webkit-details-marker {
    display: none;
  }

  .more__summary:hover {
    border-color: var(--sx-accent);
    background: color-mix(in srgb, var(--sx-accent) 18%, transparent);
    color: var(--text);
  }

  .more__summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* "+" num losango pequeno que vira "−" ao abrir (mesma linguagem do FAQ) */
  .more__icon {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--sx-accent) 55%, transparent);
    border-radius: 2px;
    transform: rotate(45deg);
    transition:
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .more__icon::before,
  .more__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%) rotate(-45deg);
    transition: transform var(--dur) var(--ease-out);
  }

  .more__icon::after {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .more[open] .more__icon {
    background: color-mix(in srgb, var(--sx-accent) 22%, transparent);
    border-color: var(--sx-accent);
  }

  .more[open] .more__icon::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .more__body {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border-left: 1px solid var(--sx-line);
    background: linear-gradient(90deg, var(--sx-soft), transparent 80%);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .more__caption {
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .more__pending {
    color: var(--text-dim);
    font-style: italic;
  }

  .more__list {
    display: grid;
    gap: var(--space-2);
  }

  .more__list li {
    position: relative;
    padding-left: var(--space-5);
  }

  .more__list li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0.2rem;
    width: 6px;
    height: 6px;
    border: 1px solid var(--sx-accent);
    transform: rotate(45deg);
  }

  .more[open] .more__body {
    animation: more-in var(--dur-slow) var(--ease-out);
  }

  /* abertura suave onde o navegador já anima altura de <details> */
  .more::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-slow) var(--ease-out),
      content-visibility var(--dur-slow) allow-discrete;
  }

  .more[open]::details-content {
    block-size: auto;
  }

  @keyframes more-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  /* cores forçadas apagam o fundo dos traços: o "+/−" volta na cor do texto do sistema */
  @media (forced-colors: active) {
    .more__icon::before,
    .more__icon::after {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more[open] .more__body {
      animation: none;
    }

    .more::details-content {
      transition: none;
    }
  }
</style>
