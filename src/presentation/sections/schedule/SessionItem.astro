---
import type { SessionDTO } from '@application/index';
import Chip from '@presentation/components/ui/Chip.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { SessionTimeFormatter } from '@presentation/formatters/SessionTimeFormatter';

interface Props {
  session: SessionDTO;
}

const { session } = Astro.props;
const time = new SessionTimeFormatter();
const isDeadline = session.kind === 'deadline';
const isFinalStage = session.kind === 'ceremony' || session.venue.role === 'final';
// prazo e palco final ganham âmbar: é o que ninguém pode perder
const flag =
  isDeadline && session.end
    ? `Entrega até ${time.hour(session.end)}`
    : isFinalStage
      ? `Palco · ${session.venue.shortName}`
      : null;
---

<li class:list={['session', (isDeadline || isFinalStage) && 'session--hot']}>
  <div class="session__meta">
    <span class="session__time">
      <Icon name="clock" size={16} />
      {time.format(session)}
    </span>{' '}
    <span class="session__venue">
      <Icon name="map-pin" size={16} />
      <span class="sr-only">Local: </span>
      {session.venue.shortName}
    </span>{' '}
    {flag && <span class="session__flag">{flag}</span>}
  </div>
  <h4 class="session__title">{session.title}</h4>
  <p class="session__desc">{session.description}</p>
  {session.topics.length > 0 && (
    <ul class="session__topics" role="list" aria-label="Tópicos">
      {session.topics.map((topic) => (
        <Chip as="li" tone={isDeadline || isFinalStage ? 'time' : 'default'}>
          {topic}
        </Chip>
      ))}
    </ul>
  )}
</li>

<style>
  .session {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-5);
    background: rgb(4 11 24 / 0.62);
    border-left: 2px solid var(--line-strong);
  }

  .session--hot {
    border-left-color: var(--time);
    background: linear-gradient(90deg, rgb(255 181 71 / 0.08), rgb(4 11 24 / 0.62) 60%);
  }

  .session__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }

  .session__time,
  .session__venue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .session__time {
    color: var(--c-cyan-soft);
  }

  .session--hot .session__time {
    color: var(--time);
  }

  .session__venue {
    color: var(--text-muted);
  }

  .session__flag {
    padding: 0.2em 0.6em;
    clip-path: var(--clip-btn);
    background: var(--time);
    color: var(--c-deep);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .session__title {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .session__desc {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .session__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
