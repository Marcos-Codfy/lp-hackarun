---
import type { SessionDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import { SessionTimeFormatter } from '@presentation/formatters/SessionTimeFormatter';

interface Props {
  session: SessionDTO;
}

const { session } = Astro.props;
const time = new SessionTimeFormatter();
const isDeadline = session.kind === 'deadline';
const isFinalStage = session.kind === 'ceremony' || session.venue.role === 'final';
const isHot = isDeadline || isFinalStage;
// prazo e palco final ganham laranja: é o que ninguém pode perder
const flag =
  isDeadline && session.end
    ? `Entrega até ${time.hour(session.end)}`
    : isFinalStage
      ? `Palco · ${session.venue.shortName}`
      : null;
---

<li class:list={['session sx-glass sx-glass--solid sx-hover', isHot && 'session--hot']}>
  <div class="session__meta">
    <span class="session__time">
      <Icon name="clock" size={16} />
      {time.format(session)}
    </span>{' '}
    <span class="session__venue">
      <Icon name="map-pin" size={16} />
      <span class="sr-only">Local: </span>
      {session.venue.shortName}
    </span>{' '}
    {flag && <span class="session__flag">{flag}</span>}
  </div>
  <h4 class="session__title">{session.title}</h4>
  <p class="session__desc">{session.description}</p>
  {session.topics.length > 0 && (
    <ul class="session__topics" role="list" aria-label="Tópicos">
      {session.topics.map((topic) => (
        <li class="sx-tag">{topic}</li>
      ))}
    </ul>
  )}
</li>

<style>
  .session {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-left: 2px solid var(--sx-accent);
  }

  /* laranja (tempo) troca o tom do card inteiro: borda, tags e brilho */
  .session--hot {
    --sx-accent: var(--c-orange);
    --sx-accent-2: var(--c-gold);
    --sx-ink: #ffb27a;
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 133 47 / 0.18), transparent 60%),
      linear-gradient(170deg, rgb(26 14 30 / 0.88), rgb(6 5 16 / 0.94));
    box-shadow: 0 0 50px -18px rgb(255 133 47 / 0.55);
  }

  .session__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }

  .session__time,
  .session__venue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .session__time {
    color: var(--sx-ink);
    font-weight: 600;
  }

  .session__venue {
    color: var(--text-muted);
  }

  .session__flag {
    margin-left: auto;
    padding: 0.25em 0.7em;
    background: linear-gradient(100deg, var(--c-gold), var(--c-orange));
    box-shadow: 0 0 22px rgb(255 133 47 / 0.55);
    color: var(--c-void);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transform: skewX(var(--skew));
  }

  .session__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .session__desc {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .session__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 639px) {
    .session__flag {
      margin-left: 0;
    }
  }
</style>
