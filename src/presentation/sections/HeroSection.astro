---
import type { LandingPageDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Chip from '@presentation/components/ui/Chip.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import HudCorners from '@presentation/components/ui/HudCorners.astro';
import Countdown from '@presentation/components/countdown/Countdown.astro';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import { RegistrationCopy } from '@presentation/formatters/RegistrationCopy';
import HeroWordmark from './hero/HeroWordmark.astro';
import HeroHud from './hero/HeroHud.astro';
import HeroPartners from './hero/HeroPartners.astro';
import ScrollCue from './hero/ScrollCue.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event, partners } = Astro.props.data;
const dates = new DayLabelFormatter().range(event.firstDate, event.lastDate);
const host = event.venues.find((v) => v.role === 'host')?.shortName ?? 'Unicatólica';
const finalVenue = event.venues.find((v) => v.role === 'final');
const organizer = partners.find((p) => p.role === 'organizer')?.name ?? host;
const partner = partners.find((p) => p.role === 'partner')?.name ?? finalVenue?.name ?? '';
const cta = new RegistrationCopy().cta(event.registration.status);
const ctaAttrs = cta.isRegistration ? { registrationCta: 'hero' } : { 'data-nav-link': true };
---

<section
  id="inicio"
  class="section hero"
  data-scene="core"
  data-checkpoint="Largada"
  aria-labelledby="inicio-title"
  data-hero
>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="container hero__frame">
    <HudCorners size={18} class="hero__corners" />
    <HeroHud label={event.tagline} />

    <div class="hero__content" data-hero-content>
      <div class="hero-in" style="--d: 120ms">
        {/* espaços explícitos: o compressHTML some com quebra de linha e o leitor de tela grudaria as palavras */}
        <Chip tone="accent">
          <span>{dates}</span> <span aria-hidden="true">·</span>
          <span class="sr-only">,</span> <span>{host}</span> <span aria-hidden="true">→</span>
          <span class="sr-only">e</span> <span>Final no {finalVenue?.shortName ?? 'Capim Dourado'}</span>
        </Chip>
      </div>

      <HeroWordmark />

      <p class="hero__tagline hero-in" style="--d: 260ms">
        Encontre os NPCs. Decifre as pistas. <strong>Codifique contra o relógio.</strong>
      </p>

      <div class="hero__countdown hero-in" style="--d: 380ms">
        <Countdown milestones={event.milestones} variant="hero" />
      </div>

      <div class="hero__ctas hero-in" style="--d: 480ms">
        <Button size="lg" href={cta.href} {...ctaAttrs}>
          {cta.label}
          <Icon slot="icon" name="arrow-right" />
        </Button>
        <Button variant="ghost" size="lg" href="#programacao" data-nav-link>
          Ver programação
        </Button>
      </div>

      <div class="hero-in" style="--d: 580ms">
        <HeroPartners organizer={organizer} partner={partner} />
      </div>
    </div>

    <ScrollCue />
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-4);
  }

  /* véu radial: o globo continua aparecendo, mas o centro fica legível */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 60% 46% at 50% 50%,
      rgb(4 11 24 / 0.6) 0%,
      rgb(4 11 24 / 0.32) 55%,
      transparent 100%
    );
  }

  .hero__frame {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .hero__frame :global(.hero__corners) {
    display: none;
  }

  .hero__content {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .hero__tagline {
    max-width: 30ch;
    color: var(--text-muted);
    font-size: var(--fs-lg);
    text-shadow: 0 1px 18px rgb(4 11 24 / 0.9);
  }

  .hero__tagline strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero__countdown {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .hero__ctas {
    display: grid;
    width: 100%;
    max-width: 22rem;
    gap: var(--space-3);
  }

  /* entradas em CSS: começam no primeiro paint e terminam mesmo se o JS falhar */
  .hero-in {
    animation: hero-rise 0.9s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  @media (min-width: 640px) {
    .hero__frame {
      padding: var(--space-5);
    }

    .hero__frame :global(.hero__corners) {
      display: block;
    }

    .hero__ctas {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      animation: none;
    }
  }
</style>
