---
import type { LandingPageDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Countdown from '@presentation/components/countdown/Countdown.astro';
import { DayLabelFormatter } from '@presentation/formatters/DayLabelFormatter';
import { RegistrationCopy } from '@presentation/formatters/RegistrationCopy';
import HeroHud from './hero/HeroHud.astro';
import HeroLogo from './hero/HeroLogo.astro';
import HeroSlogan from './hero/HeroSlogan.astro';
import HeroMeta from './hero/HeroMeta.astro';
import HeroFooter from './hero/HeroFooter.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { event, partners } = Astro.props.data;
const days = new DayLabelFormatter();
const first = days.format(event.firstDate);
const last = days.format(event.lastDate);
const dates = `${days.range(event.firstDate, event.lastDate)} ${event.edition}`;
const datesLong = `De ${Number(first.day)} a ${last.long.split(', ')[1] ?? ''} de ${event.edition}`;
const host = event.venues.find((v) => v.role === 'host')?.shortName ?? 'UniCatólica';
const finalVenue = event.venues.find((v) => v.role === 'final');
const organizer = partners.find((p) => p.role === 'organizer')?.name ?? host;
const partner = partners.find((p) => p.role === 'partner')?.name ?? finalVenue?.name ?? '';
const cta = new RegistrationCopy().cta(event.registration.status);
const ctaAttrs = cta.isRegistration ? { registrationCta: 'hero' } : { 'data-nav-link': true };
---

<section
  id="inicio"
  class="section hero"
  data-scene="core"
  data-checkpoint="Largada"
  aria-labelledby="inicio-title"
  data-hero
>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__frame">
    <div class="hero__content" data-hero-fade>
      <HeroHud label={`1ª edição · ${event.tagline}`} />
      <HeroLogo />
      <HeroSlogan />
      <div class="hero-in" style="--d: 1.05s">
        <HeroMeta
          dates={dates}
          datesLong={datesLong}
          host={host}
          finalVenue={finalVenue?.shortName ?? 'Capim Dourado'}
        />
      </div>

      <div class="hero__actions hero-in" style="--d: 1.2s">
        <div class="hero__countdown">
          <Countdown milestones={event.milestones} variant="hero" />
        </div>
        <span class="hero__divider" aria-hidden="true"></span>
        <div class="hero__ctas">
          <Button size="lg" href={cta.href} {...ctaAttrs}>
            {cta.label}
          </Button>
          <Button variant="ghost" size="lg" href="#programacao" data-nav-link>
            Ver programação
          </Button>
        </div>
      </div>
    </div>

    {/* a entrada (CSS) e a saída no scroll (GSAP) ficam em elementos diferentes: opacidade não briga */}
    <div class="hero-in" style="--d: 1.4s">
      <div data-hero-fade>
        <HeroFooter organizer={organizer} partner={partner} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: 100svh;
    /* os raios do logo podem passar da borda no celular */
    overflow-x: clip;
    padding-block: calc(var(--header-h) + var(--space-4)) var(--space-4);
  }

  /* véu só na faixa do texto: o centro (logo + globo) fica aberto */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 70% 34% at 50% 72%,
        rgb(2 3 11 / 0.62) 0%,
        rgb(2 3 11 / 0.2) 60%,
        transparent 100%
      ),
      /* escurece a base pro contador e volta a zero na borda: sem faixa em cima do letreiro */
      linear-gradient(180deg, transparent 62%, rgb(2 3 11 / 0.5) 88%, rgb(2 3 11 / 0) 100%);
  }

  .hero__frame {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-6);
  }

  .hero__content {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .hero__actions {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    width: 100%;
    margin-top: var(--space-2);
  }

  .hero__countdown {
    display: grid;
    justify-items: center;
  }

  .hero__divider {
    display: none;
  }

  .hero__ctas {
    display: grid;
    gap: var(--space-3);
    width: min(100%, 22rem);
  }

  /* entradas em CSS: começam no primeiro paint e terminam mesmo se o JS falhar */
  .hero-in {
    animation: hero-rise 0.9s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  @media (min-width: 640px) {
    .hero__ctas {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      gap: var(--space-4);
    }
  }

  /* desktop: contador e CTAs lado a lado, separados por um fio vertical */
  @media (min-width: 1024px) {
    .hero__content {
      gap: var(--space-5);
    }

    .hero__actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-7);
    }

    .hero__divider {
      display: block;
      width: 1px;
      height: 5.5rem;
      background: linear-gradient(180deg, transparent, rgb(150 175 255 / 0.35), transparent);
    }

    /* CTAs empilhados com a mesma largura: o bloco fica do tamanho do logo */
    .hero__ctas {
      display: grid;
      gap: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      animation: none;
    }
  }
</style>
