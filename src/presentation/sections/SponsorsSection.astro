---
// patrocinadores no lugar da chamada de equipes (o TeamsSection fica comentado no index.astro)
import type { LandingPageDTO } from '@application/index';
import SectionHeader from './shared/SectionHeader.astro';
import SponsorCard from './sponsors/SponsorCard.astro';
import { FEATURED_SPONSORS, OTHER_SPONSORS } from './sponsors/sponsors';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

// a seção não depende de dados; a prop fica pelo contrato da página
const { data: _data } = Astro.props;

// patrocinadores, logos e textos do "Sobre" ficam em ./sponsors/sponsors.ts
---

<section
  id="patrocinadores"
  class="section sponsors tone-cyan"
  data-scene="dust"
  data-checkpoint="Patrocinadores"
  aria-labelledby="patrocinadores-title"
>
  <div class="container section-stack">
    <SectionHeader
      id="patrocinadores-title"
      code="09"
      eyebrow="Patrocinadores"
      title="Quem impulsiona <em>essa corrida</em>"
      lead="Grandes ideias precisam de parceiros que acreditam nelas. Conheça as marcas que apoiam o HackaRun e impulsionam o futuro da tecnologia."
      align="center"
    />

    {/* top 3 em placas grandes; os demais em placas médias, 3 por fileira. A numeração segue nas duas */}
    <ul class="sponsors__grid sponsors__grid--featured" role="list" data-reveal-group>
      {FEATURED_SPONSORS.map((sponsor, index) => (
        <SponsorCard index={index} sponsor={sponsor} size="lg" />
      ))}
    </ul>
    <ul class="sponsors__grid" role="list" data-reveal-group>
      {OTHER_SPONSORS.map((sponsor, index) => (
        <SponsorCard index={FEATURED_SPONSORS.length + index} sponsor={sponsor} />
      ))}
    </ul>
  </div>
</section>

<style>
  /* celular: 1 por linha; tablet: 2; desktop: 3 por fileira nas duas grades (as de destaque são mais altas) */
  .sponsors__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    width: 100%;
  }

  @media (min-width: 640px) {
    .sponsors__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }

    /* 3 destaques no tablet: o terceiro ocupa a linha toda em vez de ficar sozinho num canto */
    .sponsors__grid--featured > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    /* placas médias: 3 por fileira numa faixa mais estreita, centralizada abaixo dos destaques */
    .sponsors__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 60rem;
      margin-inline: auto;
    }

    .sponsors__grid--featured {
      max-width: none;
    }

    .sponsors__grid--featured {
      gap: var(--space-6);
    }

    .sponsors__grid--featured > :global(:last-child:nth-child(odd)) {
      grid-column: auto;
    }
  }
</style>
