---
import type { SpeakerDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import SpeakerProfile from './SpeakerProfile.astro';

// convidado já revelado; o bloqueado usa o LockedMentorCard
interface Props {
  speaker: SpeakerDTO;
  role: string;
}

const { speaker, role } = Astro.props;
const name = speaker.name ?? '';
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
// perfil completo (mini currículo) abre pelo "Ver perfil" no SpeakerProfile
const profileId = `perfil-${speaker.id}`;
const hasBio = speaker.bio.length > 0;
---

<li class="crew-card sx-glass sx-glass--solid sx-corners sx-hover">
  <div class="crew-card__portrait">
    {speaker.avatarUrl ? (
      <img src={speaker.avatarUrl} alt="" width="320" height="400" loading="lazy" decoding="async" />
    ) : (
      <span class="crew-card__initials sx-grad-text" aria-hidden="true">
        {initials}
      </span>
    )}
  </div>
  <p class="sx-hud crew-card__role">{role}</p>
  <h3 class="crew-card__name">{name}</h3>
  <p class="crew-card__headline">{speaker.headline}</p>
  {speaker.topic && <p class="crew-card__topic">{speaker.topic}</p>}
  {hasBio && (
    <>
      <button class="crew-card__more" type="button" popovertarget={profileId}>
        Ver perfil
        <Icon name="arrow-right" size={14} />
      </button>
      <SpeakerProfile id={profileId} speaker={speaker} name={name} role={role} />
    </>
  )}
</li>

<style>
  /* coluna flexível: o "Ver perfil" desce pro pé do card e fica alinhado mesmo com nomes de 2 a 4 linhas */
  .crew-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .crew-card__portrait {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: 2px;
    background: radial-gradient(circle at 50% 35%, rgb(148 27 255 / 0.4), rgb(4 3 16 / 0.95) 75%);
  }

  .crew-card__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .crew-card__initials {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    font-weight: 900;
  }

  .crew-card__name {
    font-size: var(--fs-base);
    letter-spacing: 0.04em;
  }

  .crew-card__headline,
  .crew-card__topic {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .crew-card__topic {
    color: var(--sx-ink);
  }

  /* "Ver perfil": mesmo jeito HUD dos links da LP, a seta anda no hover */
  .crew-card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-top: auto;
    white-space: nowrap;
    padding: var(--space-1) 0;
    border: 0;
    background: none;
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
    cursor: pointer;
  }

  .crew-card__more :global(.icon) {
    transition: transform var(--dur) var(--ease-out);
  }

  .crew-card__more:hover {
    color: var(--text);
  }

  .crew-card__more:hover :global(.icon) {
    transform: translateX(3px);
  }

  .crew-card__more:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  /* desktop: card mais largo (4 por fileira), então mais respiro e o nome um pouco maior */
  @media (min-width: 1024px) {
    .crew-card {
      gap: var(--space-3);
      padding: var(--space-4) var(--space-4) var(--space-5);
    }

    .crew-card__name {
      font-size: var(--fs-lg);
    }
  }
</style>
