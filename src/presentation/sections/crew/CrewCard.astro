---
import type { SpeakerDTO } from '@application/index';

// convidado já revelado; o bloqueado usa o LockedMentorCard
interface Props {
  speaker: SpeakerDTO;
  role: string;
}

const { speaker, role } = Astro.props;
const name = speaker.name ?? '';
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
---

<li class="crew-card sx-glass sx-glass--solid sx-corners sx-hover">
  <div class="crew-card__portrait">
    {speaker.avatarUrl ? (
      <img src={speaker.avatarUrl} alt="" width="320" height="400" loading="lazy" decoding="async" />
    ) : (
      <span class="crew-card__initials sx-grad-text" aria-hidden="true">
        {initials}
      </span>
    )}
  </div>
  <p class="sx-hud crew-card__role">{role}</p>
  <h3 class="crew-card__name">{name}</h3>
  <p class="crew-card__headline">{speaker.headline}</p>
  {speaker.topic && <p class="crew-card__topic">{speaker.topic}</p>}
</li>

<style>
  .crew-card {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .crew-card__portrait {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: 2px;
    background: radial-gradient(circle at 50% 35%, rgb(148 27 255 / 0.4), rgb(4 3 16 / 0.95) 75%);
  }

  .crew-card__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .crew-card__initials {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    font-weight: 900;
  }

  .crew-card__name {
    font-size: var(--fs-base);
    letter-spacing: 0.04em;
  }

  .crew-card__headline,
  .crew-card__topic {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .crew-card__topic {
    color: var(--sx-ink);
  }
</style>
