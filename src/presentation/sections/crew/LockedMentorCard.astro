---
// mentor ainda não revelado: silhueta "???" com scanlines e um feixe de varredura (curiosidade)
interface Props {
  label: string;
  index: number;
  hint?: string | null;
}

const { label, index, hint = null } = Astro.props;
const code = `ID.${String(index + 1).padStart(2, '0')}`;
---

<li
  class="locked sx-glass sx-glass--solid sx-corners sx-hover"
  style={`--delay: ${(index * 0.45).toFixed(2)}s`}
>
  <div class="locked__portrait" aria-hidden="true">
    <svg class="locked__silhouette" viewBox="0 0 120 120" fill="none">
      <circle cx="60" cy="46" r="21" fill="currentColor"></circle>
      <path d="M16 120c4-27 22-42 44-42s40 15 44 42z" fill="currentColor"></path>
    </svg>
    <span class="locked__q">???</span>
    <span class="locked__beam"></span>
    <span class="locked__code">{code}</span>
    <span class="locked__status">
      <i></i>
      Bloqueado
    </span>
  </div>
  <p class="locked__role sx-hud">{label}</p>
  <p class="locked__name">
    <span aria-hidden="true">A revelar</span>
    <span class="sr-only">{label}: a revelar</span>
  </p>
  {hint && <p class="locked__hint">{hint}</p>}
</li>

<style>
  .locked {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .locked__portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: 2px;
    background:
      repeating-linear-gradient(0deg, rgb(210 168 255 / 0.06) 0 1px, transparent 1px 4px),
      radial-gradient(
        circle at 50% 38%,
        rgb(148 27 255 / 0.42),
        rgb(26 11 61 / 0.6) 45%,
        rgb(4 3 16 / 0.95) 78%
      );
    box-shadow: inset 0 0 0 1px rgb(178 107 255 / 0.22);
    color: rgb(210 168 255 / 0.2);
  }

  .locked__silhouette {
    position: absolute;
    inset: 16% 10% 0;
    width: 80%;
    height: 84%;
    filter: drop-shadow(0 0 12px rgb(148 27 255 / 0.5));
  }

  .locked__q {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem);
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #f0dcff;
    text-shadow:
      0 0 14px rgb(237 40 232 / 0.8),
      0 0 40px rgb(148 27 255 / 0.7);
    animation: glitch 5.2s steps(1) infinite;
    animation-delay: var(--delay);
  }

  /* feixe de varredura de cima pra baixo: "tem alguém aqui" */
  .locked__beam {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgb(237 40 232 / 0) 40%,
      rgb(237 40 232 / 0.28) 49%,
      rgb(255 255 255 / 0.5) 50%,
      rgb(148 27 255 / 0.22) 51%,
      transparent 62%
    );
    transform: translateY(-100%);
    animation: scan 3.8s var(--ease-in-out) infinite;
    animation-delay: var(--delay);
    mix-blend-mode: screen;
  }

  .locked__code,
  .locked__status {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .locked__code {
    top: 0.5rem;
    left: 0.6rem;
    color: rgb(222 200 255 / 0.6);
  }

  .locked__status {
    right: 0.6rem;
    bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #f0b8ff;
  }

  .locked__status i {
    width: 5px;
    height: 5px;
    background: var(--c-magenta);
    box-shadow: 0 0 8px var(--c-magenta);
    animation: blink 1.6s steps(1) infinite;
  }

  .locked__role {
    color: var(--sx-ink);
  }

  .locked__name {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .locked__hint {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  @keyframes scan {
    0% {
      transform: translateY(-100%);
    }
    70%,
    100% {
      transform: translateY(100%);
    }
  }

  @keyframes glitch {
    0%,
    92%,
    100% {
      transform: none;
      opacity: 1;
    }
    93% {
      transform: translateX(-3px) skewX(-12deg);
      opacity: 0.6;
    }
    95% {
      transform: translateX(2px);
      opacity: 1;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .locked__q,
    .locked__beam,
    .locked__status i {
      animation: none;
    }

    .locked__beam {
      opacity: 0;
    }
  }
</style>
