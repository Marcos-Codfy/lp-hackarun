---
import type { LandingPageDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';
import { ScheduleLookup } from '@presentation/formatters/ScheduleLookup';
import SectionHeader from './shared/SectionHeader.astro';
import PrizeCard from './prizes/PrizeCard.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { prizes, schedule } = Astro.props.data;
const lookup = new ScheduleLookup(schedule);
const awards = lookup.activity('awards');
---

<section
  id="premios"
  class="section section--split prizes tone-gold"
  data-scene="trophy"
  data-checkpoint="Prêmios"
  aria-labelledby="premios-title"
>
  <span class="prizes__haze" aria-hidden="true"></span>
  <div class="container">
    <div class="section-split__content section-stack">
      <SectionHeader
        id="premios-title"
        code="07"
        eyebrow="Prêmios"
        title="O que está <em>em jogo</em>"
        lead="As melhores equipes sobem ao palco da final para levar troféu, certificados e prêmios."
      />

      <ul class="prizes__grid" role="list" data-reveal-group>
        {prizes.map((prize, index) => (
          <PrizeCard prize={prize} featured={index === 0} />
        ))}
      </ul>

      <p class="section-note" data-reveal="up">
        <Icon name="lock" />
        <span>
          Prêmios revelados em breve pela organização.
          {awards && (
            <>
              {' '}
              A premiação oficial é em {lookup.shortDate(awards.day)}, às {lookup.startOf(awards)}, no{' '}
              {awards.session.venue.name}.
            </>
          )}
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .prizes {
    overflow: clip;
  }

  /* brilho dourado vindo do troféu (direita) */
  .prizes__haze {
    position: absolute;
    top: 20%;
    right: -10%;
    z-index: -1;
    width: 55vw;
    height: 60%;
    background: radial-gradient(closest-side, rgb(255 133 47 / 0.12), transparent);
    filter: blur(30px);
    pointer-events: none;
  }

  .prizes__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .prizes__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .prizes__grid > :global(.prize--featured) {
      grid-column: 1 / -1;
    }
  }
</style>
