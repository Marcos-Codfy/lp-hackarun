---
// clímax da LP: o globo carrega (data-scene-hold) e o CTA acende. O formulário mora na página /inscricao;
// aqui ficam o contador, o que ter em mãos, os dois caminhos (inscrição e como o sorteio forma as equipes) e o
// status da inscrição, que é individual
import type { LandingPageDTO } from '@application/index';
import Countdown from '@presentation/components/countdown/Countdown.astro';
import PrepChecklist from '@presentation/components/registration/PrepChecklist.astro';
import SectionHeader from './shared/SectionHeader.astro';
import ChargeCta from './registration/ChargeCta.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

const { registration, milestones } = Astro.props.data.event;
---

<section
  id="inscricao"
  class="section registration tone-cyan"
  data-scene="core"
  data-scene-hold="900"
  data-checkpoint="Inscrição"
  data-anchor-offset="0"
  aria-labelledby="inscricao-title"
>
  {/* palco alto com miolo sticky: o globo fica no centro enquanto rola, sem travar o scroll */}
  <div class="registration__stage">
    <div class="registration__sticky">
      <div class="registration__scrim" aria-hidden="true"></div>
      <div class="container registration__center">
        <SectionHeader
          id="inscricao-title"
          code="10"
          eyebrow="Checkpoint final"
          title="Sua vaga na <em>corrida</em>"
          align="center"
          size="lg"
        />
        <div class="registration__countdown">
          <Countdown milestones={milestones} variant="compact" />
        </div>
        {registration.status !== 'closed' && (
          <PrepChecklist teamSize={registration.teamSize} id="inscricao-prep" />
        )}
        <ChargeCta registration={registration} />
      </div>
    </div>
  </div>
</section>

<style>
  /* /#inscricao (o "Voltar ao evento" de quem chegou direto) para com o palco colado no topo: o miolo sticky
     já desconta o header. O pulo nativo usa o scroll-margin; o do app, o data-anchor-offset */
  .registration {
    padding-top: 0;
    scroll-margin-top: calc(-1 * (var(--header-h) + var(--space-4)));
  }

  .registration__stage {
    min-height: 160svh;
  }

  .registration__sticky {
    position: sticky;
    top: 0;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-3);
  }

  /* véu só no miolo: o globo continua aparecendo em volta */
  .registration__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 46% 40% at 50% 50%,
      rgb(2 3 11 / 0.66) 0%,
      rgb(2 3 11 / 0.32) 60%,
      transparent 100%
    );
  }

  /* celular: o miolo inteiro (título, contador, lista e CTAs) cabe numa tela de 360x740 */
  .registration__center {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  /* título mais junto do selo no celular (o globo aparece em volta) */
  .registration__center :global(.sx-head) {
    gap: var(--space-3);
  }

  @media (min-height: 46rem) {
    .registration__center {
      gap: var(--space-5);
    }
  }

  .registration__countdown {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  @media (min-width: 640px) {
    .registration__sticky {
      padding-block: calc(var(--header-h) + var(--space-5)) var(--space-6);
    }

    .registration__center :global(.sx-head) {
      gap: var(--space-5);
    }
  }

  @media (min-width: 640px) and (min-height: 46rem) {
    .registration__center {
      gap: var(--space-6);
    }
  }
</style>
