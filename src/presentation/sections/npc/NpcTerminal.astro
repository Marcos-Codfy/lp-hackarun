---
import NpcToken from '@presentation/components/npc/NpcToken.astro';

// terminal que "recebe" a dica do NPC; o texto completo está no HTML e o JS só digita por cima
const hint = 'npc_07: "o que você procura está onde tudo termina..."';
---

<figure class="terminal sx-glass sx-corners" data-terminal>
  <div class="terminal__bar" aria-hidden="true">
    <span class="terminal__dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="terminal__title">npc_link // canal 07</span>
    <span class="terminal__signal">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <span>sinal</span>
    </span>
  </div>
  <div class="terminal__screen">
    <p class="terminal__line terminal__line--dim" data-terminal-boot>
      <span class="terminal__prompt">&gt;</span> conectando ao npc_07...
      <span class="terminal__ok">ok</span>
    </p>
    <p class="terminal__line terminal__line--dim" data-terminal-boot>
      <span class="terminal__prompt">&gt;</span> sinal instável. pista recebida:
    </p>
    <p class="terminal__line terminal__line--hint">
      <span class="sr-only">{hint}</span>
      <span aria-hidden="true">
        <span data-type-text>{hint}</span>
        <span class="terminal__caret"></span>
      </span>
    </p>
    <p class="terminal__line terminal__line--foot" data-terminal-boot>
      <span aria-hidden="true">
        <span class="terminal__prompt">&gt;</span> tokens escondidos na página: <b>3</b>
      </span>
      <NpcToken id="npc-1" label="Token NPC escondido no terminal" />
    </p>
  </div>
  <span class="terminal__scanlines" aria-hidden="true"></span>
  <figcaption class="sr-only">Exemplo de pista entregue por um NPC</figcaption>
</figure>

<style>
  .terminal {
    --sx-border: linear-gradient(
      140deg,
      #b26bff 0%,
      rgb(148 27 255 / 0.25) 35%,
      rgb(237 40 232 / 0.2) 70%,
      #ed28e8 100%
    );
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(148 27 255 / 0.08),
      0 0 60px -10px rgb(148 27 255 / 0.55),
      0 0 120px -30px rgb(237 40 232 / 0.45),
      0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid rgb(178 107 255 / 0.22);
    background: linear-gradient(90deg, rgb(148 27 255 / 0.2), rgb(8 6 28 / 0.5) 70%);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .terminal__dots {
    display: flex;
    gap: 7px;
  }

  .terminal__dots i {
    width: 7px;
    height: 7px;
    background: rgb(210 168 255 / 0.25);
    transform: rotate(45deg);
  }

  .terminal__dots i:first-child {
    background: var(--c-magenta);
    box-shadow: 0 0 10px var(--c-magenta);
  }

  .terminal__title {
    color: rgb(222 200 255 / 0.8);
  }

  /* barras de sinal oscilando: "instável" */
  .terminal__signal {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    margin-left: auto;
    height: 12px;
    color: var(--sx-ink);
  }

  .terminal__signal i {
    width: 3px;
    background: var(--c-magenta);
    animation: signal 1.4s var(--ease-in-out) infinite alternate;
  }

  .terminal__signal i:nth-child(1) {
    height: 4px;
  }

  .terminal__signal i:nth-child(2) {
    height: 7px;
    animation-delay: 0.2s;
  }

  .terminal__signal i:nth-child(3) {
    height: 10px;
    animation-delay: 0.4s;
  }

  .terminal__signal i:nth-child(4) {
    height: 12px;
    animation-delay: 0.6s;
    opacity: 0.3;
  }

  .terminal__signal span {
    margin-left: 6px;
    line-height: 1;
  }

  .terminal__screen {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.6;
  }

  .terminal__prompt {
    color: var(--c-magenta);
  }

  .terminal__line--dim {
    color: rgb(222 210 255 / 0.62);
  }

  .terminal__ok {
    margin-left: var(--space-2);
    color: var(--c-success);
  }

  .terminal__line--hint {
    min-height: 3.2em;
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--c-magenta);
    background: linear-gradient(90deg, rgb(237 40 232 / 0.12), transparent 80%);
    color: #f6e9ff;
    font-size: var(--fs-sm);
    text-shadow: 0 0 14px rgb(237 40 232 / 0.55);
  }

  .terminal__line--foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px dashed rgb(178 107 255 / 0.22);
    color: rgb(222 210 255 / 0.62);
  }

  .terminal__line--foot b {
    color: var(--sx-ink);
    font-weight: 700;
  }

  .terminal__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 3px;
    vertical-align: text-bottom;
    background: var(--c-magenta);
    box-shadow: 0 0 12px var(--c-magenta);
    animation: caret-blink 1s steps(1) infinite;
  }

  /* digitando: o cursor fica aceso (pisca só parado) */
  :global(.is-typing) .terminal__caret {
    animation: none;
  }

  .terminal__scanlines {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px);
    mix-blend-mode: overlay;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes signal {
    to {
      opacity: 0.25;
    }
  }

  @media (min-width: 640px) {
    .terminal__screen {
      padding: var(--space-6) var(--space-6) var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__caret,
    .terminal__signal i {
      animation: none;
    }
  }
</style>
