---
import HudFrame from '@presentation/components/ui/HudFrame.astro';
import NpcToken from '@presentation/components/npc/NpcToken.astro';

// terminal que "recebe" a dica do NPC; o texto completo está no HTML e o JS só digita por cima
const hint = 'npc_07: "o que você procura está onde tudo termina..."';
---

<HudFrame as="figure" glass class="terminal" data-terminal>
  <div class="terminal__bar" aria-hidden="true">
    <span class="terminal__dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="terminal__title">npc_link · canal 07</span>
  </div>
  <div class="terminal__screen">
    <p class="terminal__line terminal__line--dim">&gt; conectando ao npc_07...</p>
    <p class="terminal__line terminal__line--dim">&gt; sinal instável. pista recebida:</p>
    <p class="terminal__line terminal__line--hint">
      <span class="sr-only">{hint}</span>
      <span aria-hidden="true">
        &gt; <span data-type-text>{hint}</span>
        <span class="terminal__caret"></span>
      </span>
    </p>
    <p class="terminal__line terminal__line--foot">
      <span aria-hidden="true">&gt; tokens escondidos na página: 3</span>
      <NpcToken id="npc-1" label="Token NPC escondido no terminal" />
    </p>
  </div>
  <figcaption class="sr-only">Exemplo de pista entregue por um NPC</figcaption>
</HudFrame>

<style>
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: calc(var(--space-5) * -1) calc(var(--space-5) * -1) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--surface-line);
    background: rgb(4 11 24 / 0.6);
  }

  .terminal__dots {
    display: flex;
    gap: 6px;
  }

  .terminal__dots i {
    width: 8px;
    height: 8px;
    background: var(--surface-line);
    transform: rotate(45deg);
  }

  .terminal__dots i:first-child {
    background: var(--c-cyan);
  }

  .terminal__title,
  .terminal__screen {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .terminal__title {
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }

  .terminal__screen {
    display: grid;
    gap: var(--space-2);
    line-height: 1.55;
  }

  .terminal__line--dim {
    color: var(--text-dim);
  }

  .terminal__line--hint {
    min-height: 3.1em;
    color: var(--c-cyan-soft);
    font-size: var(--fs-sm);
  }

  .terminal__line--foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
    color: var(--text-dim);
  }

  .terminal__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--c-cyan);
    animation: caret-blink 1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 640px) {
    .terminal__bar {
      margin: calc(var(--space-6) * -1) calc(var(--space-6) * -1) var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__caret {
      animation: none;
    }
  }
</style>
