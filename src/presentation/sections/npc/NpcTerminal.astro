---
import TerminalBar from './TerminalBar.astro';
import TerminalScreen from './TerminalScreen.astro';

// terminal que "recebe" a dica do NPC: casca de vidro, barra de título e tela com as linhas
---

<figure class="terminal sx-glass sx-corners" data-terminal>
  <TerminalBar />
  <TerminalScreen />
  <span class="terminal__scanlines" aria-hidden="true"></span>
  <figcaption class="sr-only">Exemplo de pista entregue por um NPC</figcaption>
</figure>

<style>
  .terminal {
    --sx-border: linear-gradient(
      140deg,
      #b26bff 0%,
      rgb(148 27 255 / 0.25) 35%,
      rgb(237 40 232 / 0.2) 70%,
      var(--c-magenta) 100%
    );
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(148 27 255 / 0.08),
      0 0 60px -10px rgb(148 27 255 / 0.55),
      0 0 120px -30px rgb(237 40 232 / 0.45),
      0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  .terminal__scanlines {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px);
    mix-blend-mode: overlay;
  }
</style>
