---
// log de missão estilo jogo: os 4 passos de cada pista, ligados por um traço violeta
const steps = [
  { title: 'Encontre o NPC', text: 'Eles circulam pela corrida. Fique de olho em quem parece saber demais.' },
  { title: 'Arranque a pista', text: 'Converse, negocie, prove que a sua equipe merece a dica.' },
  { title: 'Resolva a missão', text: 'A pista destrava a estação. O código é com vocês.' },
  {
    title: 'Cumpra e avance',
    text: 'Missão cumprida, objetivo batido. Como cada uma pontua, o regulamento revela.',
  },
];
---

<ol class="quest" role="list" data-reveal-group>
  {steps.map((step, index) => (
    <li class="quest__step">
      <span class="quest__num sx-grad-text" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <div class="quest__body">
        <h3 class="quest__title">
          <span class="sr-only">Passo {index + 1}: </span>
          {step.title}
        </h3>
        <p class="quest__text">{step.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .quest {
    display: grid;
    gap: var(--space-3);
  }

  .quest__step {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    transition: background var(--dur) var(--ease-out);
  }

  /* traço que liga os passos */
  .quest__step::before {
    content: '';
    position: absolute;
    top: 3.4rem;
    bottom: -0.75rem;
    left: 1.2rem;
    width: 1px;
    background: linear-gradient(180deg, rgb(178 107 255 / 0.55), rgb(237 40 232 / 0.05));
  }

  .quest__step:last-child::before {
    display: none;
  }

  .quest__num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    filter: drop-shadow(0 0 14px rgb(237 40 232 / 0.35));
    transition: filter var(--dur) var(--ease-out);
  }

  .quest__step:hover .quest__num {
    filter: drop-shadow(0 0 22px rgb(237 40 232 / 0.75));
  }

  .quest__title {
    font-size: var(--fs-base);
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .quest__text {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  @media (min-width: 640px) {
    .quest {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2) var(--space-5);
    }

    .quest__step::before {
      display: none;
    }
  }
</style>
