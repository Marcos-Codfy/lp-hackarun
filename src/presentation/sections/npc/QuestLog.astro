---
import QuestMore from './QuestMore.astro';

// log de missão estilo jogo: as 3 missões sequenciais do hackathon, ligadas por um traço violeta
interface Step {
  title: string;
  text: string;
  items?: string[];
  deadline?: string;
}

const steps: Step[] = [
  {
    title: 'Problemas e Requisitos',
    text: 'A missão começa em 12/11, às 20h15, e vocês terão até 13/11, às 10h para definir a base do projeto.',
    items: [
      'Delimitação do problema',
      'Definição do público-alvo e da proposta de valor',
      'Canvas simplificado',
      'Backlog priorizado',
    ],
  },
  {
    title: 'Desenvolvimento e Validação do Protótipo',
    text: 'Com a primeira etapa concluída, é hora de colocar a mão na massa! Desenvolvam a solução, implementem o fluxo principal e comprovem seu funcionamento.',
    items: [
      'Protótipo funcional',
      'Código versionado',
      'Fluxo principal implementado',
      'Evidências de testes e correções',
    ],
    deadline: 'Período: de 13/11, às 10h, até 14/11, às 10h.',
  },
  {
    title: 'Produto Final e Pitch em Vídeo',
    text: 'Chegou a hora de entregar o projeto completo! Finalizem a solução, organizem os materiais e preparem um pitch em vídeo para apresentar o resultado.',
    items: [
      'Versão final da solução',
      'Repositório do projeto',
      'Instruções de execução e documentação',
      'Vídeo de pitch com duração de 1min15s a 2min',
    ],
    deadline: 'Período: de 14/11, às 10h, até 14/11, às 13h.',
  },
];
---

<div class="quest-wrap">
  <h3 class="quest-wrap__title">Modelos Sequenciais</h3>
  <ol class="quest" role="list" data-reveal-group>
    {steps.map((step, index) => (
      <li class="quest__step">
        <span class="quest__num sx-grad-text" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class="quest__body">
          <h4 class="quest__title">
            <span class="sr-only">Missão {index + 1}: </span>
            {step.title}
          </h4>
          <QuestMore title={step.title}>
            <p>{step.text}</p>
            {step.items && (
              <ul class="more__list" role="list">
                {step.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {step.deadline && <p class="more__period">{step.deadline}</p>}
          </QuestMore>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .quest-wrap {
    display: grid;
    gap: var(--space-4);
  }

  /* mini título no estilo HUD dos selos da LP */
  .quest-wrap__title {
    color: #d2a8ff;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .quest-wrap__title::before {
    content: '// ';
    color: var(--c-magenta);
  }

  .quest {
    display: grid;
    gap: var(--space-3);
  }

  .quest__step {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
  }

  /* traço que liga as missões: são sequenciais, então a linha fica em todas as telas */
  .quest__step::before {
    content: '';
    position: absolute;
    top: 3.4rem;
    bottom: -0.75rem;
    left: 1.2rem;
    width: 1px;
    background: linear-gradient(180deg, rgb(178 107 255 / 0.55), rgb(237 40 232 / 0.05));
  }

  .quest__step:last-child::before {
    display: none;
  }

  .quest__num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    filter: drop-shadow(0 0 14px rgb(237 40 232 / 0.35));
    transition: filter var(--dur) var(--ease-out);
  }

  .quest__step:hover .quest__num {
    filter: drop-shadow(0 0 22px rgb(237 40 232 / 0.75));
  }

  .quest__body {
    display: grid;
    gap: var(--space-2);
  }

  .quest__title {
    font-size: var(--fs-base);
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
</style>
