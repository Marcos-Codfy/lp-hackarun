---
// log de missão estilo jogo: os 4 passos de cada pista
const steps = [
  { title: 'Encontre o NPC', text: 'Eles circulam pela corrida. Fique de olho em quem parece saber demais.' },
  { title: 'Arranque a pista', text: 'Converse, negocie, prove que a sua equipe merece a dica.' },
  { title: 'Resolva a missão', text: 'A pista destrava a estação. O código é com vocês.' },
  { title: 'Valide e avance', text: 'Chave validada, pontos no ranking e rota liberada pra próxima.' },
];
---

<ol class="quest" role="list" data-reveal-group>
  {steps.map((step, index) => (
    <li class="quest__step">
      <span class="quest__num" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <div class="quest__body">
        <h3 class="quest__title">
          <span class="sr-only">Passo {index + 1}: </span>
          {step.title}
        </h3>
        <p class="quest__text">{step.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .quest {
    display: grid;
    gap: var(--space-2);
  }

  .quest__step {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--surface-line);
  }

  .quest__step:last-child {
    border-bottom: 1px solid var(--surface-line);
  }

  .quest__num {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 900;
    line-height: 0.9;
    background: var(--grad-energy);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .quest__title {
    font-size: var(--fs-xl);
    line-height: 1.05;
  }

  .quest__text {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
</style>
