---
// "Descrição" que abre e fecha nas missões: o mesmo <details> da miniementa da programação
interface Props {
  // nome da missão, lido junto pelo leitor de tela ("Descrição: Problemas e Requisitos")
  title: string;
  label?: string;
}

const { title, label = 'Descrição' } = Astro.props;
---

<details class="more">
  <summary class="more__summary">
    <span class="more__icon" aria-hidden="true" />
    {label}
    <span class="sr-only">: {title}</span>
  </summary>
  <div class="more__body">
    <slot />
  </div>
</details>

<style>
  .more {
    width: 100%;
    margin-top: var(--space-1);
    interpolate-size: allow-keywords;
  }

  .more__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2rem;
    padding-right: var(--space-3);
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    border-radius: 2px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .more__summary::-webkit-details-marker {
    display: none;
  }

  .more__summary:hover {
    color: var(--text);
  }

  .more__summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* "+" num losango pequeno que vira "−" ao abrir (mesma linguagem do FAQ) */
  .more__icon {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--sx-accent) 55%, transparent);
    border-radius: 2px;
    transform: rotate(45deg);
    transition:
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .more__icon::before,
  .more__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%) rotate(-45deg);
    transition: transform var(--dur) var(--ease-out);
  }

  .more__icon::after {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .more[open] .more__icon {
    background: color-mix(in srgb, var(--sx-accent) 22%, transparent);
    border-color: var(--sx-accent);
  }

  .more[open] .more__icon::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .more__body {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border-left: 1px solid var(--sx-line);
    background: linear-gradient(90deg, var(--sx-soft), transparent 80%);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  /* a lista e o período chegam pelo slot (escopo do QuestLog): por isso o :global */
  .more__body :global(.more__list) {
    display: grid;
    gap: var(--space-2);
  }

  .more__body :global(.more__list li) {
    position: relative;
    padding-left: var(--space-5);
  }

  .more__body :global(.more__period) {
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
  }

  .more__body :global(.more__list li::before) {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0.2rem;
    width: 6px;
    height: 6px;
    border: 1px solid var(--sx-accent);
    transform: rotate(45deg);
  }

  .more[open] .more__body {
    animation: more-in var(--dur-slow) var(--ease-out);
  }

  /* abertura suave onde o navegador já anima altura de <details> */
  .more::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-slow) var(--ease-out),
      content-visibility var(--dur-slow) allow-discrete;
  }

  .more[open]::details-content {
    block-size: auto;
  }

  @keyframes more-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  /* cores forçadas apagam o fundo dos traços: o "+/−" volta na cor do texto do sistema */
  @media (forced-colors: active) {
    .more__icon::before,
    .more__icon::after {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more[open] .more__body {
      animation: none;
    }

    .more::details-content {
      transition: none;
    }
  }
</style>
