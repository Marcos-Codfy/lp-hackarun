---
// chamada da LP pra página /equipes: contador ao vivo, vitrine de fotos e os dois caminhos (ver ou se inscrever).
// Celular: tudo numa coluna. Desktop: texto e botões à esquerda, vitrine grande centrada à direita
import type { RegistrationDTO, TeamDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import TeamCounter from '@presentation/components/teams/TeamCounter.astro';
import TeamFaces from '@presentation/components/teams/TeamFaces.astro';
import { toPublicTeam } from '@presentation/view-models/teams/TeamsViewModel';

interface Props {
  teams: TeamDTO[];
  registration: RegistrationDTO;
}

const { teams, registration } = Astro.props;
const { slots } = registration;
const confirmed = teams.filter((t) => t.status === 'confirmed').map(toPublicTeam);
---

<div
  class="teaser sx-glass sx-corners"
  data-teams
  data-teams-initial={JSON.stringify(confirmed)}
  data-teams-slots={JSON.stringify(slots)}
  data-slots-level={slots.level}
>
  <p class="teaser__hud sx-hud">
    <span class="teaser__live" aria-hidden="true"></span>
    Grid de largada
  </p>
  <div class="teaser__counter">
    <TeamCounter count={confirmed.length} slots={slots} />
  </div>
  <div class="teaser__faces">
    <TeamFaces hasTeams={confirmed.length > 0} />
  </div>
  <p class="teaser__text">
    Cada equipe confirmada ganha um card com <strong>foto ou logo</strong> na página de equipes. A lista
    atualiza sozinha assim que a organização confirma a inscrição.
  </p>
  <div class="teaser__actions">
    <Button href="/equipes" size="lg">
      Ver as equipes
    </Button>
    {registration.status !== 'closed' && (
      <Button href="#inscricao" variant="ghost" size="lg" registrationCta="teams">
        Inscrever minha equipe
      </Button>
    )}
  </div>
</div>

<style>
  /* minmax(0, 1fr): o rótulo do botão (que não quebra) não alarga a trilha além do card */
  .teaser {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding: var(--space-5) var(--space-4);
  }

  .teaser__hud {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .teaser__live {
    width: 6px;
    height: 6px;
    background: var(--c-success);
    box-shadow: 0 0 10px var(--c-success);
  }

  .teaser__text {
    max-width: 40rem;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .teaser__text strong {
    color: var(--text);
  }

  .teaser__actions {
    display: grid;
    gap: var(--space-3);
  }

  /* celular estreito: o botão ocupa a largura e, se ainda faltar espaço, o rótulo quebra em vez de vazar */
  .teaser__actions :global(.btn) {
    --btn-px: 1.25rem;
    max-width: 100%;
  }

  .teaser__actions :global(.btn__label) {
    white-space: normal;
    text-align: center;
    line-height: 1.2;
  }

  @media (min-width: 40rem) {
    .teaser {
      gap: var(--space-6);
      padding: var(--space-7);
    }

    .teaser__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .teaser__actions :global(.btn) {
      --btn-px: 2.1rem;
    }

    .teaser__actions :global(.btn__label) {
      white-space: nowrap;
    }
  }

  /* desktop: duas colunas, a vitrine cresce e fica no meio da altura do card */
  @media (min-width: 64rem) {
    .teaser {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'hud faces'
        'counter faces'
        'text faces'
        'actions faces';
      column-gap: var(--space-8);
      row-gap: var(--space-5);
      align-items: start;
    }

    .teaser__hud {
      grid-area: hud;
    }

    .teaser__counter {
      grid-area: counter;
    }

    .teaser__text {
      grid-area: text;
    }

    .teaser__actions {
      grid-area: actions;
      padding-top: var(--space-2);
    }

    .teaser__faces {
      --face-size: clamp(4.75rem, 1rem + 5vw, 6rem);
      --face-overlap: -14px;
      grid-area: faces;
      align-self: center;
      justify-self: end;
    }
  }
</style>
