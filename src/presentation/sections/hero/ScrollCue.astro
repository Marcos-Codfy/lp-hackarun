---
// "role para largar": trilho fino com um cometa descendo; decorativo
---

<div class="scroll-cue" aria-hidden="true">
  <span class="scroll-cue__label">Role para largar</span>
  <span class="scroll-cue__rail">
    <span class="scroll-cue__comet"></span>
  </span>
</div>

<style>
  .scroll-cue {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .scroll-cue__label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .scroll-cue__rail {
    position: relative;
    width: 1px;
    height: 2.5rem;
    overflow: hidden;
    background: linear-gradient(180deg, rgb(150 175 255 / 0.3), rgb(150 175 255 / 0.05));
  }

  .scroll-cue__comet {
    position: absolute;
    left: 0;
    width: 1px;
    height: 45%;
    background: linear-gradient(180deg, transparent, var(--c-cyan) 80%, #fff);
    box-shadow: 0 0 8px var(--c-cyan);
    animation: cue-run 2s var(--ease-in-out) infinite;
  }

  @keyframes cue-run {
    from {
      transform: translateY(-110%);
    }
    to {
      transform: translateY(240%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue__comet {
      animation: none;
      top: 30%;
    }
  }
</style>
