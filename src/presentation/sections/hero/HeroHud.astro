---
// linha de HUD acima do logo: "// HACKATHON DE ..." com réguas que se desenham dos dois lados
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<p class="hero-hud">
  <span class="hero-hud__rule" aria-hidden="true"></span>
  <span class="hero-hud__text">
    <span class="hero-hud__slash" aria-hidden="true">
      //
    </span>
    {label}
  </span>
  <span class="hero-hud__rule hero-hud__rule--end" aria-hidden="true"></span>
</p>

<style>
  .hero-hud {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
    max-width: 62rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.6;
    text-transform: uppercase;
    text-align: center;
    color: #9ff4ff;
    text-shadow: 0 0 14px rgb(0 229 255 / 0.55);
    animation: hud-in 1s 0.15s var(--ease-out) both;
  }

  .hero-hud__text {
    text-wrap: balance;
  }

  .hero-hud__slash {
    margin-right: 0.35em;
    color: var(--c-magenta);
    text-shadow: 0 0 12px rgb(237 40 232 / 0.7);
  }

  /* régua com um losango na ponta de dentro */
  .hero-hud__rule {
    position: relative;
    display: none;
    flex: 1;
    max-width: 9rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(0 229 255 / 0.7));
    transform-origin: right;
    animation: rule-draw 1.1s 0.35s var(--ease-out) both;
  }

  .hero-hud__rule::after {
    content: '';
    position: absolute;
    top: -2px;
    right: -2px;
    width: 5px;
    height: 5px;
    background: var(--c-cyan);
    box-shadow: 0 0 10px var(--c-cyan);
    transform: rotate(45deg);
  }

  .hero-hud__rule--end {
    background: linear-gradient(270deg, transparent, rgb(0 229 255 / 0.7));
    transform-origin: left;
  }

  .hero-hud__rule--end::after {
    right: auto;
    left: -2px;
  }

  @keyframes hud-in {
    from {
      opacity: 0;
      letter-spacing: 0.4em;
    }
  }

  @keyframes rule-draw {
    from {
      transform: scaleX(0);
    }
  }

  @media (min-width: 480px) {
    .hero-hud {
      font-size: var(--fs-hud);
      letter-spacing: 0.24em;
    }

    .hero-hud__rule {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .hero-hud {
      letter-spacing: 0.34em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-hud,
    .hero-hud__rule {
      animation: none;
    }
  }
</style>
