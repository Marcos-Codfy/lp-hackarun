---
// H1 do hero: é o LCP, então pinta visível no 1º frame e a montagem roda em CSS (sem esperar JS)
---

<h1 id="inicio-title" class="hero-wordmark">
  <span class="sr-only">HackaRun 2026</span>
  <span class="hero-wordmark__word" aria-hidden="true">
    <span class="hero-wordmark__hacka">HACKA</span>
    <span class="hero-wordmark__run">RUN</span>
    <span class="hero-wordmark__badge">2026</span>
  </span>
  <svg
    class="hero-wordmark__underline"
    viewBox="0 0 600 48"
    fill="none"
    aria-hidden="true"
    focusable="false"
    data-hero-underline
  >
    <defs>
      <linearGradient id="hero-energy-stroke" x1="0" y1="0" x2="600" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#00cfff" stop-opacity="0"></stop>
        <stop offset="0.18" stop-color="#00cfff"></stop>
        <stop offset="0.82" stop-color="#1e7bff"></stop>
        <stop offset="1" stop-color="#1e7bff" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <path
      class="hero-wordmark__bolt"
      data-hero-bolt
      d="M4 30H150l22-16 24 26 26-20 22 12H420l20-14 22 20 22-12H596"
      pathLength="1"
      stroke="url(#hero-energy-stroke)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <path
      class="hero-wordmark__spark"
      d="M4 30H150l22-16 24 26 26-20 22 12H420l20-14 22 20 22-12H596"
      pathLength="1"
      stroke="#ffffff"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      data-hero-spark
    ></path>
  </svg>
</h1>

<style>
  .hero-wordmark {
    position: relative;
    display: grid;
    justify-items: center;
    font-size: var(--fs-hero);
    font-weight: 900;
    line-height: 0.82;
  }

  .hero-wordmark__word {
    position: relative;
    display: inline-flex;
    transform: skewX(-8deg);
    white-space: nowrap;
  }

  .hero-wordmark__hacka,
  .hero-wordmark__run {
    display: inline-block;
    animation: wordmark-assemble 1s var(--ease-out) both;
  }

  .hero-wordmark__hacka {
    --from-x: -14%;
    color: var(--c-white);
    text-shadow: 0 4px 40px rgb(4 11 24 / 0.7);
  }

  .hero-wordmark__run {
    --from-x: 18%;
    padding-right: 0.06em;
    background: var(--grad-energy);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 22px rgb(0 207 255 / 0.45));
    animation-delay: 60ms;
  }

  .hero-wordmark__badge {
    position: absolute;
    top: 0;
    right: 0;
    padding: 0.35em 0.6em;
    font-family: var(--font-mono);
    font-size: max(0.6875rem, 0.09em);
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1;
    color: var(--c-deep);
    background: var(--c-cyan);
    clip-path: var(--clip-btn);
    transform: translate(35%, -110%) skewX(8deg);
    animation: badge-pop 0.6s 0.7s var(--ease-out) both;
  }

  .hero-wordmark__underline {
    width: 100%;
    height: auto;
    margin-top: -0.02em;
    overflow: visible;
    filter: drop-shadow(0 0 6px rgb(0 207 255 / 0.8));
  }

  .hero-wordmark__bolt {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: bolt-draw 1.1s 0.5s var(--ease-out) both;
  }

  /* faísca que corre a linha: parada fora do traço até o HeroIntroAnimator soltar */
  .hero-wordmark__spark {
    stroke-dasharray: 0.08 1.2;
    stroke-dashoffset: 0.08;
  }

  /* começa visível (opacidade 0.2): o LCP conta já no primeiro paint */
  @keyframes wordmark-assemble {
    from {
      opacity: 0.2;
      transform: translate3d(var(--from-x), 0, 0) scaleX(1.12);
    }
  }

  @keyframes badge-pop {
    from {
      opacity: 0;
      transform: translate(35%, -60%) skewX(8deg) scale(0.6);
    }
  }

  @keyframes bolt-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wordmark__hacka,
    .hero-wordmark__run,
    .hero-wordmark__badge,
    .hero-wordmark__bolt {
      animation: none;
    }
  }
</style>
