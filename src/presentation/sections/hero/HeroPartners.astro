---
import { Image } from 'astro:assets';
import partnerLogo from '../../../assets/brand/capim-dourado-white.png';

// crédito discreto do parceiro da final: logo branco a ~60% de opacidade, acende no hover.
// A UniCatólica assina o selo de cursos no topo do hero; repetir o logo aqui daria dois na mesma tela
// (a realização continua grande na faixa "Quem faz acontecer", antes do rodapé)
interface Props {
  partner: string;
}

const { partner } = Astro.props;
---

<p class="hero-partners">
  <span class="hero-partners__role">
    Parceria<span class="sr-only">:</span>
  </span>
  <Image src={partnerLogo} alt={partner} width={76} densities={[1, 2]} class="hero-partners__logo" />
</p>

<style>
  .hero-partners {
    display: grid;
    justify-items: center;
    gap: 6px;
    opacity: 0.62;
    transition: opacity var(--dur) var(--ease-out);
  }

  .hero-partners:hover {
    opacity: 0.95;
  }

  .hero-partners__role {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero-partners :global(.hero-partners__logo) {
    width: auto;
    height: 1.9rem;
    margin-block: 0.175rem;
  }

  /* desktop: alinha com a borda esquerda do hero */
  @media (min-width: 1024px) {
    .hero-partners {
      justify-items: start;
    }
  }

  @media (min-width: 1440px) {
    .hero-partners :global(.hero-partners__logo) {
      height: 2.2rem;
      margin-block: 0.2rem;
    }
  }
</style>
