---
import HeroPartners from './HeroPartners.astro';
import ScrollCue from './ScrollCue.astro';

// faixa de baixo do hero: parceiro à esquerda, dica de scroll no meio, coordenadas à direita
interface Props {
  partner: string;
}

const { partner } = Astro.props;
---

<div class="hero-footer">
  <div class="hero-footer__partners">
    <HeroPartners partner={partner} />
  </div>
  <div class="hero-footer__cue">
    <ScrollCue />
  </div>
  <p class="hero-footer__coords">
    <span aria-hidden="true">10°11'S 48°20'W</span>
    <span class="hero-footer__city">Palmas – TO</span>
  </p>
</div>

<style>
  .hero-footer {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  .hero-footer__cue,
  .hero-footer__coords {
    display: none;
  }

  .hero-footer__coords {
    gap: var(--space-2);
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1.6;
    text-align: right;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .hero-footer__city {
    color: var(--text-muted);
  }

  @media (min-width: 1024px) {
    .hero-footer {
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
    }

    .hero-footer__partners {
      justify-self: start;
    }

    .hero-footer__cue {
      display: block;
    }

    .hero-footer__coords {
      display: grid;
    }
  }

  @media (min-width: 1024px) and (max-height: 700px) {
    .hero-footer__cue {
      visibility: hidden;
    }
  }
</style>
