---
import { Image } from 'astro:assets';
import Icon from '@presentation/components/ui/Icon.astro';
import SponsorAbout from './SponsorAbout.astro';
import type { Sponsor } from './sponsors';

// um patrocinador: selo HUD em cima, logo no centro (no brilho da cor da marca) e, embaixo, o "Sobre" (abre
// o painel com o texto e o site) e o atalho direto pro site
interface Props {
  index: number;
  sponsor: Sponsor;
}

const { index, sponsor } = Astro.props;
const { id, name, logo, height, accent, url, caption } = sponsor;
const widthRem = (logo.width / logo.height) * height;
const widths = [1, 2, 3].map((d) => Math.min(logo.width, Math.round(widthRem * 16 * d)));
const aboutId = `sobre-${id}`;
---

<li class="sponsor sx-glass sx-corners" style={`--accent: ${accent}; --delay: ${(index * 0.75).toFixed(2)}s`}>
  <span class="sponsor__fx" aria-hidden="true">
    <span class="sponsor__sweep"></span>
  </span>
  <p class="sponsor__tag">
    <span class="sponsor__dot" aria-hidden="true"></span>
    Patrocinador
    <span class="sponsor__num" aria-hidden="true">
      {String(index + 1).padStart(2, '0')}
    </span>
  </p>
  <span class="sponsor__mark" style={`--h: ${height}rem`}>
    <Image
      class="sponsor__img"
      src={logo}
      alt={name}
      widths={[...new Set(widths)]}
      sizes={`${widthRem}rem`}
      loading="lazy"
    />
  </span>
  {caption && <p class="sponsor__caption">{caption}</p>}
  <div class="sponsor__actions">
    <button class="sponsor__action" type="button" popovertarget={aboutId}>
      Sobre
      <span class="sr-only"> {name}</span>
      <Icon name="arrow-right" size={14} />
    </button>
    <a class="sponsor__action" href={url} target="_blank" rel="noopener noreferrer">
      Site
      <span class="sr-only"> de {name} (abre em nova aba)</span>
      <Icon name="external" size={14} />
    </a>
  </div>
  <SponsorAbout id={aboutId} sponsor={sponsor} />
</li>

<style>
  .sponsor {
    --accent-2: var(--c-electric);
    --ink: color-mix(in srgb, var(--accent) 55%, white);
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    justify-items: center;
    align-items: center;
    gap: var(--space-4);
    min-height: 15rem;
    padding: var(--space-5) var(--space-4);
    text-align: center;
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .sponsor > :not(.sponsor__fx) {
    position: relative;
  }

  .sponsor:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 70px -24px color-mix(in srgb, var(--accent) 70%, transparent);
  }

  /* refletor no topo + um feixe de luz que atravessa a placa de tempos em tempos */
  .sponsor__fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background:
      radial-gradient(60% 55% at 50% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%),
      radial-gradient(
        50% 40% at 50% 100%,
        color-mix(in srgb, var(--accent-2) 10%, transparent),
        transparent 70%
      );
    pointer-events: none;
  }

  .sponsor__sweep {
    position: absolute;
    inset: -20% auto -20% -40%;
    width: 35%;
    background: linear-gradient(
      100deg,
      transparent,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent
    );
    transform: skewX(-18deg);
    animation: sponsor-sweep 6s var(--ease-in-out) infinite;
  }

  /* cada placa com o feixe num tempo: não passam todas juntas */
  .sponsor__sweep {
    animation-delay: var(--delay, 0s);
  }

  .sponsor__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .sponsor__dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: rotate(45deg);
    box-shadow: 0 0 10px var(--accent);
  }

  .sponsor__num {
    color: var(--text-dim);
  }

  .sponsor__mark {
    display: grid;
    place-items: center;
    max-width: 100%;
  }

  /* a logo encolhe junto com a placa no celular, sem passar da altura pedida */
  .sponsor__img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(var(--h) * 0.8);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent) 35%, transparent));
  }

  .sponsor__caption {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.5;
    text-wrap: balance;
  }

  /* pé da placa: "Sobre" e "Site" no mesmo jeito HUD dos links da LP */
  .sponsor__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    align-self: end;
  }

  .sponsor__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .sponsor__action :global(.icon) {
    transition: transform var(--dur) var(--ease-out);
  }

  .sponsor__action:hover {
    color: var(--text);
  }

  .sponsor__action:hover :global(.icon) {
    transform: translateX(3px);
  }

  .sponsor__action:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  @keyframes sponsor-sweep {
    0%,
    55% {
      transform: translateX(0) skewX(-18deg);
    }
    100% {
      transform: translateX(520%) skewX(-18deg);
    }
  }

  @media (min-width: 640px) {
    .sponsor {
      min-height: 17rem;
      padding: var(--space-6) var(--space-5);
    }

    .sponsor__img {
      max-height: var(--h);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsor {
      transition: none;
    }

    .sponsor:hover {
      transform: none;
    }

    .sponsor__sweep {
      animation: none;
      opacity: 0;
    }
  }
</style>
