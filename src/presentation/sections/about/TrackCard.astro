---
import AudienceBadge from '../shared/AudienceBadge.astro';

// uma das duas frentes do evento: selo de público em destaque, o que é, pra quem e quando, e a ação
interface Props {
  index: number;
  tone: 'open' | 'hackathon';
  badge: string;
  title: string;
  text: string;
  facts: { label: string; value: string }[];
}

const { index, tone, badge, title, text, facts } = Astro.props;
---

<li class:list={['track sx-glass sx-corners', `track--${tone}`]}>
  <span class="track__fx" aria-hidden="true">
    <span class="track__num sx-outline-num">{index + 1}</span>
  </span>
  <AudienceBadge as="p" tone={tone} label={badge} />
  <h3 class="track__title">{title}</h3>
  <p class="track__text">{text}</p>
  <dl class="track__facts">
    {facts.map((fact) => (
      <div class="track__fact">
        <dt>{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>
  <div class="track__cta">
    <slot />
  </div>
</li>

<style>
  .track {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .track > :not(.track__fx) {
    position: relative;
  }

  .track--hackathon {
    --sx-accent: var(--c-violet);
    --sx-accent-2: var(--c-magenta);
    --sx-ink: #d2a8ff;
  }

  .track__title {
    margin-top: var(--space-2);
    font-size: var(--fs-xl);
    line-height: 1.1;
  }

  .track__text {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .track__facts {
    display: grid;
    justify-self: stretch;
    align-content: start;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--sx-line);
  }

  .track__fact {
    display: grid;
    align-content: start;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .track__fact dt {
    padding-top: 0.2em;
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .track__fact dd {
    color: var(--text);
  }

  .track__cta {
    display: flex;
    margin-top: var(--space-2);
  }

  /* brilho do tom no canto e o número vazado gigante (mesma linguagem das missões) */
  .track__fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: radial-gradient(
      70% 50% at 100% 0%,
      color-mix(in srgb, var(--sx-accent) 16%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .track__num {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: clamp(5rem, 4rem + 3vw, 7rem);
    -webkit-text-stroke-color: color-mix(in srgb, var(--sx-accent) 30%, transparent);
  }

  @media (min-width: 640px) {
    .track {
      padding: var(--space-6);
    }
  }

  /* desktop: os cards empilham na coluna do texto, e "pra quem / quando" ficam lado a lado */
  @media (min-width: 1024px) {
    .track__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .track__fact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>
