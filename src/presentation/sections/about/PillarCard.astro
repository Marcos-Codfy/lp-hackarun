---
import Icon from '@presentation/components/ui/Icon.astro';
import type { IconName } from '@presentation/components/ui/icons';

interface Props {
  index: number;
  icon: IconName;
  title: string;
  text: string;
}

const { index, icon, title, text } = Astro.props;
const code = String(index + 1).padStart(2, '0');
---

<li class="pillar sx-glass sx-corners sx-hover">
  <div class="pillar__top">
    <span class="sx-icon">
      <Icon name={icon} size={20} />
    </span>
    <span class="pillar__code sx-hud" aria-hidden="true">
      P.{code}
    </span>
  </div>
  <h3 class="pillar__title">{title}</h3>
  <p class="pillar__text">{text}</p>
  <span class="pillar__fx" aria-hidden="true">
    <span class="pillar__scan"></span>
  </span>
</li>

<style>
  .pillar {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .pillar__fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .pillar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    padding-left: 0.35rem;
  }

  .pillar__code {
    color: var(--text-dim);
  }

  .pillar__title {
    font-size: var(--fs-lg);
    line-height: 1.15;
  }

  .pillar__text {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* linha de luz que varre o card no hover */
  .pillar__scan {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    background: linear-gradient(
      100deg,
      transparent,
      color-mix(in srgb, var(--sx-accent) 16%, transparent),
      transparent
    );
    transform: translateX(-120%) skewX(-16deg);
    transition: transform 900ms var(--ease-out);
    pointer-events: none;
  }

  .pillar:hover .pillar__scan {
    transform: translateX(320%) skewX(-16deg);
  }

  @media (min-width: 640px) {
    .pillar {
      padding: var(--space-6) var(--space-5) var(--space-5);
    }
  }
</style>
