---
import type { PrizeDTO } from '@application/index';
import Icon from '@presentation/components/ui/Icon.astro';

interface Props {
  prize: PrizeDTO;
  featured?: boolean;
}

const { prize, featured = false } = Astro.props;
const rank = prize.rank !== null ? String(prize.rank).padStart(2, '0') : '—';
---

<li class:list={['prize sx-glass sx-corners sx-hover', featured && 'prize--featured']}>
  <span class="prize__fx" aria-hidden="true">
    <span class="prize__glow"></span>
  </span>
  <div class="prize__top">
    <span class="prize__badge" aria-hidden="true">
      <span class="prize__badge-label">Rank</span>
      <span class="prize__badge-num">{rank}</span>
    </span>
    <span class="prize__icon">
      <Icon name={featured ? 'trophy' : 'crown'} size={featured ? 34 : 24} />
    </span>
  </div>
  <h3 class="prize__title">{prize.title}</h3>
  <p class="prize__desc">{prize.description}</p>
  {prize.revealed ? (
    <p class="prize__reward">{prize.reward}</p>
  ) : (
    <div class="prize__locked">
      <span class="prize__redacted" aria-hidden="true"></span>
      <p class="prize__locked-text">
        <Icon name="lock" size={16} />
        <span>A revelar</span>
      </p>
    </div>
  )}
</li>

<style>
  .prize {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .prize__fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  /* luz de cima, como refletor no troféu */
  .prize__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 55% at 85% 0%, rgb(255 194 74 / 0.16), transparent 70%);
  }

  .prize--featured {
    --sx-border: linear-gradient(
      150deg,
      #ffe7a3 0%,
      var(--c-gold) 25%,
      rgb(255 133 47 / 0.3) 60%,
      var(--c-orange) 100%
    );
    box-shadow:
      0 0 80px -20px rgb(255 194 74 / 0.45),
      0 30px 60px -36px rgb(0 0 0 / 0.9);
  }

  .prize--featured .prize__glow {
    background:
      radial-gradient(60% 70% at 90% 0%, rgb(255 194 74 / 0.24), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgb(255 133 47 / 0.1), transparent 70%);
  }

  .prize__top {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  /* insígnia de rank em chevron dourado */
  .prize__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.45rem 1.4rem 0.45rem 0.9rem;
    background: linear-gradient(100deg, #ffe7a3, var(--c-gold) 45%, var(--c-orange));
    clip-path: polygon(0 0, calc(100% - 0.8rem) 0, 100% 50%, calc(100% - 0.8rem) 100%, 0 100%);
    color: var(--c-void);
    filter: drop-shadow(0 0 14px rgb(255 194 74 / 0.5));
  }

  .prize__badge-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .prize__badge-num {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    line-height: 1;
  }

  .prize--featured .prize__badge-num {
    font-size: var(--fs-2xl);
  }

  .prize__icon {
    color: var(--sx-ink);
    filter: drop-shadow(0 0 12px rgb(255 194 74 / 0.6));
  }

  .prize__title {
    position: relative;
    font-size: var(--fs-lg);
    line-height: 1.1;
  }

  .prize--featured .prize__title {
    font-size: var(--fs-2xl);
  }

  .prize__desc {
    position: relative;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .prize__reward {
    margin-top: auto;
    padding-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 800;
    text-transform: uppercase;
  }

  /* estado bloqueado: tarja "censurada" com brilho passando + rótulo */
  .prize__locked {
    position: relative;
    display: grid;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed rgb(255 194 74 / 0.25);
  }

  .prize__redacted {
    position: relative;
    display: block;
    width: 72%;
    height: 0.9rem;
    overflow: hidden;
    background: rgb(255 194 74 / 0.12);
  }

  .prize__redacted::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 20%, rgb(255 231 163 / 0.55) 50%, transparent 80%);
    transform: translateX(-100%);
    animation: prize-shimmer 2.8s var(--ease-in-out) infinite;
  }

  .prize__locked-text {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--sx-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  @keyframes prize-shimmer {
    to {
      transform: translateX(100%);
    }
  }

  @media (min-width: 640px) {
    .prize {
      padding: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prize__redacted::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
