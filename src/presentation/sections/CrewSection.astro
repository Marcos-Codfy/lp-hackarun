---
import type { LandingPageDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { mentorHref } from '@presentation/view-models/mentor/mentorOrigin';
// import { ScheduleLookup } from '@presentation/formatters/ScheduleLookup';
import { SpeakerRoleLabel } from '@presentation/formatters/SpeakerRoleLabel';
import SectionHeader from './shared/SectionHeader.astro';
import CrewCard from './crew/CrewCard.astro';
import LockedMentorCard from './crew/LockedMentorCard.astro';
import './sections.css';

interface Props {
  data: LandingPageDTO;
}

// cards dos convidados (speakers.json): revelado mostra foto, nome e o perfil; sem nome fica "???"
const { speakers } = Astro.props.data;
const roles = new SpeakerRoleLabel();
// // quando equipes e mentores são apresentados (lido da programação)
// const lookup = new ScheduleLookup(schedule);
// const reveal = lookup.activity('teams-and-mentors');
// const revealAt = reveal
//   ? ` Equipes e mentores são apresentados na abertura, em ${lookup.shortDate(reveal.day)}, às ${lookup.startOf(reveal)}.`
//   : '';
---

<section
  id="mentores"
  class="section crew tone-violet"
  data-scene="terrain"
  data-checkpoint="Mentores"
  aria-labelledby="mentores-title"
>
  <div class="container section-stack">
    <SectionHeader
      id="mentores-title"
      code="05"
      eyebrow="Mentores"
      title="Quem vai estar <em>do seu lado</em>"
      lead="Vocês poderão contar com o apoio de mentores para esclarecer dúvidas e orientar o desenvolvimento do projeto. Todas as equipes poderão solicitar orientação."
    />

    <ul class="crew__grid" role="list" data-reveal-group>
      {speakers.map((speaker, index) =>
        speaker.revealed ? (
          <CrewCard speaker={speaker} role={roles.of(speaker.role)} />
        ) : (
          <LockedMentorCard label={roles.of(speaker.role)} index={index} hint={speaker.topic} />
        ),
      )}
    </ul>

    <div class="crew__rules sx-glass sx-corners" data-reveal="up">
      <p class="sx-hud">// Regras da mentoria</p>
      <ul class="crew__rules-list" role="list">
        <li>
          <span class="sx-icon">
            <Icon name="chat" size={20} />
          </span>
          <p>
            <strong>O mentor orienta, mas não escreve a solução.</strong>
            As equipes são responsáveis por suas entregas, e mentores não poderão avaliar equipes que tenham
            orientado.
          </p>
        </li>
        <li>
          <span class="sx-icon">
            <Icon name="route" size={20} />
          </span>
          <p>
            <strong>Os mentores ajudam a encontrar o caminho.</strong>
            Orientações sobre produto, programação, arquitetura, testes, segurança, documentação e gestão do
            tempo, conforme a disponibilidade durante o evento.
          </p>
        </li>
      </ul>
    </div>

    {/* convite pra quem quer ajudar: leva ao cadastro de mentores (/seja-mentor) */}
    <div class="crew__invite sx-glass" data-reveal="up">
      <div class="crew__invite-text">
        <p class="sx-hud">// Quer ser mentor?</p>
        <h3 class="crew__invite-title">Egresso ou profissional de tecnologia?</h3>
        <p>
          Cadastre-se e ajude as equipes do HackaRun a tirar a ideia do papel. A organização confirma o seu
          perfil por e-mail.
        </p>
      </div>
      <Button href={mentorHref('crew')} variant="ghost">
        Quero ser mentor
      </Button>
    </div>
  </div>
</section>

<style>
  .crew__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
  }

  .crew__rules {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
  }

  .crew__rules-list {
    display: grid;
    gap: var(--space-6);
  }

  .crew__rules-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .crew__rules-list p {
    color: var(--text-muted);
  }

  .crew__rules-list strong {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--text);
    font-weight: 600;
  }

  .crew__invite {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5);
  }

  .crew__invite-text {
    display: grid;
    gap: var(--space-2);
    color: var(--text-muted);
  }

  .crew__invite-title {
    color: var(--text);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: var(--lh-snug);
  }

  /* celular: o botão ocupa a largura do cartão */
  .crew__invite :global(.btn) {
    justify-self: stretch;
  }

  @media (min-width: 640px) {
    .crew__invite {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-7);
      padding: var(--space-6) var(--space-7);
    }

    .crew__invite :global(.btn) {
      justify-self: start;
    }

    .crew__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }

    .crew__rules {
      padding: var(--space-7);
    }
  }

  @media (min-width: 1024px) {
    .crew__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .crew__rules-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }
</style>
