---
// aviso de privacidade (LGPD) linkado no consentimento e no rodapé; a versão é a que vai na coluna Consentimento
import BaseLayout from '@presentation/layouts/BaseLayout.astro';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import Wordmark from '@presentation/components/ui/Wordmark.astro';
import PrivacyNotice from '@presentation/components/privacy/PrivacyNotice.astro';
import { CONSENT_VERSION } from '@application/index';
import { serverContainer } from '@composition/server';
import type { AppConfig } from '@presentation/app/AppConfig';
import '@presentation/sections/sections.css';

const { event } = await serverContainer().getLandingPage.execute();

const appConfig: AppConfig = {
  milestones: event.milestones,
  registration: event.registration,
  teamsEndpoint: event.registration.endpoint,
};

const seo = {
  title: 'Aviso de privacidade · HackaRun 2026',
  description:
    'Como o HackaRun 2026 trata os dados da inscrição das equipes: o que coleta, para que usa, por quanto tempo e como pedir a remoção.',
  path: '/privacidade',
};
---

<BaseLayout seo={seo} appConfig={appConfig}>
  <header class="privacy__header">
    <a class="privacy__brand" href="/" aria-label="HackaRun 2026, página inicial">
      <Wordmark size="sm" priority />
    </a>
  </header>
  <main id="conteudo">
    <section
      id="privacidade"
      class="section tone-cyan privacy"
      data-scene="dust"
      data-checkpoint="Privacidade"
      aria-labelledby="privacidade-title"
    >
      <div class="container container--narrow privacy__frame">
        <p class="hud-label">
          <span aria-hidden="true">// </span>LGPD · versão {CONSENT_VERSION}
        </p>
        <h1 id="privacidade-title" class="privacy__title">
          Aviso de <em>privacidade</em>
        </h1>
        <p class="privacy__lead">
          O que acontece com os dados da inscrição das equipes no HackaRun 2026. Curto e direto, sem
          juridiquês.
        </p>

        <PrivacyNotice />

        <Button size="lg" href="/#inscricao" class="privacy__cta">
          Ir para a inscrição
          <Icon slot="icon" name="arrow-right" />
        </Button>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .privacy__header {
    position: absolute;
    inset: 0 0 auto;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    height: var(--header-h);
    padding-inline: var(--gutter);
  }

  .privacy__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .privacy__frame {
    display: grid;
    gap: var(--space-5);
  }

  .privacy__title {
    font-size: var(--fs-3xl);
  }

  .privacy__lead {
    color: var(--text-muted);
    font-size: var(--fs-lg);
  }

  .privacy__frame :global(.privacy__cta) {
    justify-self: start;
  }
</style>
