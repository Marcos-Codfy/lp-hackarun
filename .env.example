# url pública do site (usada no sitemap, robots.txt, og:image e canonical). Vazia = https://hackarun.pages.dev
PUBLIC_SITE_URL=https://hackarun.pages.dev

# url do Web App do Google Apps Script que grava as inscrições na planilha
# (deixe vazio pra mostrar "inscrições em breve"; no npm run dev, vazio = modo simulado)
PUBLIC_REGISTRATION_ENDPOINT=

# prévia de revisão: "true" faz o build (npm run build) rodar a inscrição simulada, sem gravar nada, com o aviso
# "Prévia de revisão" em /inscricao e noindex nas páginas. Só no ambiente Preview da Cloudflare, nunca no
# Production (lá o build quebra de propósito). Com endpoint preenchido, o endpoint ganha e a flag é ignorada
# PUBLIC_REGISTRATION_SIMULATED=false

# pasta extra pra onde o npm run docs:pdf copia os PDFs e o guia (opcional)
# DOCS_OUT_DIR=C:/Users/voce/Documents/HackaRun
